// ═══════════════════════════════════════════════════════════════════════════
// 1S: ERP Free Edition — ЗУП: Классификаторы и заполнение инфобазы
// Демонстрирует:
//   9 классификаторов: документы личности, образование, семейное положение,
//   степени родства, виды стажа, профессии рабочих, языки, степени знания
//   языков, учебные заведения.
//   Заполнение инфобазы: 5 графиков работы, штатное расписание (РегСведений),
//   учётная политика по персоналу, личная карточка сотрудника (форма Т-2).
//   Отчёты: сводка классификаторов, ФОТ штатного расписания, производственный
//   календарь, расчёт стандартных налоговых вычетов, запрос по штату.
// ═══════════════════════════════════════════════════════════════════════════

// ─── Вспомогательная функция создания классификатора ─────────────────────

Функция НовТЗ(Знач КолонкиСтр)
    Перем ТЗ, К;
    ТЗ = Новый ТаблицаЗначений;
    Для Каждого К Из СтрРазделить(КолонкиСтр, ",", Ложь) Цикл
        ТЗ.Колонки.Добавить(СокрЛП(К));
    КонецЦикла;
    Возврат ТЗ;
КонецФункции

// ═══════════════════════════════════════════════════════════════════════════
//  КЛ-1: Документы, удостоверяющие личность (ОКУД)
// ═══════════════════════════════════════════════════════════════════════════

Функция КлДокументыЛичности()
    Перем Т, С;
    Т = НовТЗ("Код, Наименование, Аббревиатура");
    С = Т.Добавить(); С.Код = "21"; С.Аббревиатура = "Пасп. РФ";     С.Наименование = "Паспорт гражданина Российской Федерации";
    С = Т.Добавить(); С.Код = "07"; С.Аббревиатура = "Воен. б.";     С.Наименование = "Военный билет";
    С = Т.Добавить(); С.Код = "10"; С.Аббревиатура = "Ин. пасп.";    С.Наименование = "Иностранный паспорт";
    С = Т.Добавить(); С.Код = "11"; С.Аббревиатура = "Св. рожд.";    С.Наименование = "Свидетельство о рождении";
    С = Т.Добавить(); С.Код = "12"; С.Аббревиатура = "ВНЖ";          С.Наименование = "Вид на жительство";
    С = Т.Добавить(); С.Код = "13"; С.Аббревиатура = "Уд. беж.";     С.Наименование = "Удостоверение беженца";
    С = Т.Добавить(); С.Код = "14"; С.Аббревиатура = "Вр. уд.";      С.Наименование = "Временное удостоверение личности";
    С = Т.Добавить(); С.Код = "18"; С.Аббревиатура = "Пасп. мор.";   С.Наименование = "Паспорт моряка";
    С = Т.Добавить(); С.Код = "22"; С.Аббревиатура = "Загранпасп.";  С.Наименование = "Загранпаспорт гражданина Российской Федерации";
    С = Т.Добавить(); С.Код = "24"; С.Аббревиатура = "Уд. воен.";    С.Наименование = "Удостоверение личности военнослужащего";
    С = Т.Добавить(); С.Код = "26"; С.Аббревиатура = "Пасп. СССР";   С.Наименование = "Паспорт СССР";
    Возврат Т;
КонецФункции

// ═══════════════════════════════════════════════════════════════════════════
//  КЛ-2: Виды образования (ФЗ № 273-ФЗ)
// ═══════════════════════════════════════════════════════════════════════════

Функция КлВидыОбразования()
    Перем Т, С;
    Т = НовТЗ("Код, Наименование, Уровень, ВысшееОбразование");
    С = Т.Добавить(); С.Код = "01"; С.Уровень = 1; С.ВысшееОбразование = Ложь;  С.Наименование = "Начальное общее образование";
    С = Т.Добавить(); С.Код = "02"; С.Уровень = 2; С.ВысшееОбразование = Ложь;  С.Наименование = "Основное общее образование";
    С = Т.Добавить(); С.Код = "03"; С.Уровень = 3; С.ВысшееОбразование = Ложь;  С.Наименование = "Среднее общее образование";
    С = Т.Добавить(); С.Код = "04"; С.Уровень = 4; С.ВысшееОбразование = Ложь;  С.Наименование = "Среднее профессиональное образование";
    С = Т.Добавить(); С.Код = "05"; С.Уровень = 5; С.ВысшееОбразование = Истина; С.Наименование = "Высшее — бакалавриат";
    С = Т.Добавить(); С.Код = "06"; С.Уровень = 6; С.ВысшееОбразование = Истина; С.Наименование = "Высшее — специалитет / магистратура";
    С = Т.Добавить(); С.Код = "07"; С.Уровень = 7; С.ВысшееОбразование = Истина; С.Наименование = "Высшее — подготовка кадров высшей квалификации";
    С = Т.Добавить(); С.Код = "08"; С.Уровень = 3; С.ВысшееОбразование = Ложь;  С.Наименование = "Профессиональное обучение";
    Возврат Т;
КонецФункции

// ═══════════════════════════════════════════════════════════════════════════
//  КЛ-3: Семейное положение
// ═══════════════════════════════════════════════════════════════════════════

Функция КлСемПоложение()
    Перем Т, С;
    Т = НовТЗ("Код, Наименование, ОфициальныйБрак");
    С = Т.Добавить(); С.Код = "1"; С.ОфициальныйБрак = Истина;  С.Наименование = "Состоит в зарегистрированном браке";
    С = Т.Добавить(); С.Код = "2"; С.ОфициальныйБрак = Ложь;    С.Наименование = "Никогда не состоял(а) в браке";
    С = Т.Добавить(); С.Код = "3"; С.ОфициальныйБрак = Ложь;    С.Наименование = "Разведён(а)";
    С = Т.Добавить(); С.Код = "4"; С.ОфициальныйБрак = Ложь;    С.Наименование = "Вдовец / вдова";
    С = Т.Добавить(); С.Код = "5"; С.ОфициальныйБрак = Ложь;    С.Наименование = "Состоит в незарегистрированном браке";
    Возврат Т;
КонецФункции

// ═══════════════════════════════════════════════════════════════════════════
//  КЛ-4: Степени родства (НДФЛ-вычеты, ст. 218 НК РФ)
// ═══════════════════════════════════════════════════════════════════════════

Функция КлСтепениРодства()
    Перем Т, С;
    Т = НовТЗ("Код, Наименование, ДаётВычет218НК");
    С = Т.Добавить(); С.Код = "01"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Супруг";
    С = Т.Добавить(); С.Код = "02"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Супруга";
    С = Т.Добавить(); С.Код = "03"; С.ДаётВычет218НК = Истина;  С.Наименование = "Сын";
    С = Т.Добавить(); С.Код = "04"; С.ДаётВычет218НК = Истина;  С.Наименование = "Дочь";
    С = Т.Добавить(); С.Код = "05"; С.ДаётВычет218НК = Истина;  С.Наименование = "Сын усыновлённый";
    С = Т.Добавить(); С.Код = "06"; С.ДаётВычет218НК = Истина;  С.Наименование = "Дочь усыновлённая";
    С = Т.Добавить(); С.Код = "07"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Отец";
    С = Т.Добавить(); С.Код = "08"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Мать";
    С = Т.Добавить(); С.Код = "09"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Брат";
    С = Т.Добавить(); С.Код = "10"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Сестра";
    С = Т.Добавить(); С.Код = "11"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Дедушка";
    С = Т.Добавить(); С.Код = "12"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Бабушка";
    С = Т.Добавить(); С.Код = "13"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Внук";
    С = Т.Добавить(); С.Код = "14"; С.ДаётВычет218НК = Ложь;    С.Наименование = "Внучка";
    С = Т.Добавить(); С.Код = "15"; С.ДаётВычет218НК = Истина;  С.Наименование = "Пасынок";
    С = Т.Добавить(); С.Код = "16"; С.ДаётВычет218НК = Истина;  С.Наименование = "Падчерица";
    С = Т.Добавить(); С.Код = "17"; С.ДаётВычет218НК = Истина;  С.Наименование = "Подопечный";
    Возврат Т;
КонецФункции

// ═══════════════════════════════════════════════════════════════════════════
//  КЛ-5: Виды стажа
// ═══════════════════════════════════════════════════════════════════════════

Функция КлВидыСтажа()
    Перем Т, С;
    Т = НовТЗ("Код, Наименование, ВлияетНаНадбавку, ВлияетНаОтпуск");
    С = Т.Добавить(); С.Код = "ОС";  С.ВлияетНаНадбавку = Ложь;   С.ВлияетНаОтпуск = Истина;  С.Наименование = "Общий стаж работы";
    С = Т.Добавить(); С.Код = "НС";  С.ВлияетНаНадбавку = Истина; С.ВлияетНаОтпуск = Ложь;    С.Наименование = "Непрерывный стаж работы";
    С = Т.Добавить(); С.Код = "СП";  С.ВлияетНаНадбавку = Истина; С.ВлияетНаОтпуск = Ложь;    С.Наименование = "Стаж по специальности";
    С = Т.Добавить(); С.Код = "СГС"; С.ВлияетНаНадбавку = Ложь;   С.ВлияетНаОтпуск = Ложь;    С.Наименование = "Страховой стаж (ОПС)";
    С = Т.Добавить(); С.Код = "ВС";  С.ВлияетНаНадбавку = Истина; С.ВлияетНаОтпуск = Истина;  С.Наименование = "Выслуга лет (государственная служба)";
    С = Т.Добавить(); С.Код = "ЛС";  С.ВлияетНаНадбавку = Истина; С.ВлияетНаОтпуск = Истина;  С.Наименование = "Льготный стаж (вредные условия труда)";
    С = Т.Добавить(); С.Код = "ПС";  С.ВлияетНаНадбавку = Истина; С.ВлияетНаОтпуск = Ложь;    С.Наименование = "Педагогический стаж";
    С = Т.Добавить(); С.Код = "МС";  С.ВлияетНаНадбавку = Истина; С.ВлияетНаОтпуск = Ложь;    С.Наименование = "Медицинский стаж";
    Возврат Т;
КонецФункции

// ═══════════════════════════════════════════════════════════════════════════
//  КЛ-6: Профессии рабочих (ОКПДТР, выборка)
// ═══════════════════════════════════════════════════════════════════════════

Функция КлПрофессии()
    Перем Т, С;
    Т = НовТЗ("КодОКПДТР, Наименование, Разряд, ЕТКСВыпуск, ТарифнаяГруппа");
    С = Т.Добавить(); С.КодОКПДТР = "11442"; С.Разряд = 0; С.ЕТКСВыпуск = "";      С.ТарифнаяГруппа = "ИТР"; С.Наименование = "Бухгалтер";
    С = Т.Добавить(); С.КодОКПДТР = "14874"; С.Разряд = 0; С.ЕТКСВыпуск = "";      С.ТарифнаяГруппа = "ИТР"; С.Наименование = "Инженер-технолог";
    С = Т.Добавить(); С.КодОКПДТР = "18505"; С.Разряд = 0; С.ЕТКСВыпуск = "";      С.ТарифнаяГруппа = "ИТР"; С.Наименование = "Менеджер";
    С = Т.Добавить(); С.КодОКПДТР = "23832"; С.Разряд = 3; С.ЕТКСВыпуск = "Вып.2"; С.ТарифнаяГруппа = "РАБ"; С.Наименование = "Оператор ЭВМ";
    С = Т.Добавить(); С.КодОКПДТР = "11480"; С.Разряд = 3; С.ЕТКСВыпуск = "Вып.6"; С.ТарифнаяГруппа = "РАБ"; С.Наименование = "Водитель автомобиля";
    С = Т.Добавить(); С.КодОКПДТР = "12397"; С.Разряд = 1; С.ЕТКСВыпуск = "Вып.36";С.ТарифнаяГруппа = "РАБ"; С.Наименование = "Грузчик";
    С = Т.Добавить(); С.КодОКПДТР = "22171"; С.Разряд = 4; С.ЕТКСВыпуск = "Вып.43";С.ТарифнаяГруппа = "РАБ"; С.Наименование = "Наладчик технологического оборудования";
    С = Т.Добавить(); С.КодОКПДТР = "19756"; С.Разряд = 2; С.ЕТКСВыпуск = "Вып.51";С.ТарифнаяГруппа = "РАБ"; С.Наименование = "Кладовщик";
    С = Т.Добавить(); С.КодОКПДТР = "13781"; С.Разряд = 0; С.ЕТКСВыпуск = "";      С.ТарифнаяГруппа = "СЛУ"; С.Наименование = "Делопроизводитель";
    С = Т.Добавить(); С.КодОКПДТР = "26551"; С.Разряд = 1; С.ЕТКСВыпуск = "Вып.66";С.ТарифнаяГруппа = "РАБ"; С.Наименование = "Уборщик производственных помещений";
    Возврат Т;
КонецФункции

// ═══════════════════════════════════════════════════════════════════════════
//  КЛ-7: Языки народов мира (ISO 639-1 + языки народов РФ)
// ═══════════════════════════════════════════════════════════════════════════

Функция КлЯзыки()
    Перем Т, С;
    Т = НовТЗ("КодISO, Наименование, НаименованиеАнгл, Регион");
    С = Т.Добавить(); С.КодISO = "RU"; С.НаименованиеАнгл = "Russian";    С.Регион = "Россия";            С.Наименование = "Русский";
    С = Т.Добавить(); С.КодISO = "EN"; С.НаименованиеАнгл = "English";    С.Регион = "Западная Европа";   С.Наименование = "Английский";
    С = Т.Добавить(); С.КодISO = "UK"; С.НаименованиеАнгл = "Ukrainian";  С.Регион = "Восточная Европа";  С.Наименование = "Украинский";
    С = Т.Добавить(); С.КодISO = "BE"; С.НаименованиеАнгл = "Belarusian"; С.Регион = "Восточная Европа";  С.Наименование = "Белорусский";
    С = Т.Добавить(); С.КодISO = "DE"; С.НаименованиеАнгл = "German";     С.Регион = "Западная Европа";   С.Наименование = "Немецкий";
    С = Т.Добавить(); С.КодISO = "FR"; С.НаименованиеАнгл = "French";     С.Регион = "Западная Европа";   С.Наименование = "Французский";
    С = Т.Добавить(); С.КодISO = "ES"; С.НаименованиеАнгл = "Spanish";    С.Регион = "Западная Европа";   С.Наименование = "Испанский";
    С = Т.Добавить(); С.КодISO = "ZH"; С.НаименованиеАнгл = "Chinese";    С.Регион = "Восточная Азия";    С.Наименование = "Китайский";
    С = Т.Добавить(); С.КодISO = "JA"; С.НаименованиеАнгл = "Japanese";   С.Регион = "Восточная Азия";    С.Наименование = "Японский";
    С = Т.Добавить(); С.КодISO = "AR"; С.НаименованиеАнгл = "Arabic";     С.Регион = "Ближний Восток";    С.Наименование = "Арабский";
    С = Т.Добавить(); С.КодISO = "TT"; С.НаименованиеАнгл = "Tatar";      С.Регион = "Россия";            С.Наименование = "Татарский";
    С = Т.Добавить(); С.КодISO = "BA"; С.НаименованиеАнгл = "Bashkir";    С.Регион = "Россия";            С.Наименование = "Башкирский";
    С = Т.Добавить(); С.КодISO = "CE"; С.НаименованиеАнгл = "Chechen";    С.Регион = "Россия";            С.Наименование = "Чеченский";
    С = Т.Добавить(); С.КодISO = "KA"; С.НаименованиеАнгл = "Georgian";   С.Регион = "Кавказ";            С.Наименование = "Грузинский";
    С = Т.Добавить(); С.КодISO = "HY"; С.НаименованиеАнгл = "Armenian";   С.Регион = "Кавказ";            С.Наименование = "Армянский";
    С = Т.Добавить(); С.КодISO = "KK"; С.НаименованиеАнгл = "Kazakh";     С.Регион = "Центральная Азия";  С.Наименование = "Казахский";
    С = Т.Добавить(); С.КодISO = "PL"; С.НаименованиеАнгл = "Polish";     С.Регион = "Восточная Европа";  С.Наименование = "Польский";
    С = Т.Добавить(); С.КодISO = "PT"; С.НаименованиеАнгл = "Portuguese"; С.Регион = "Западная Европа";   С.Наименование = "Португальский";
    Возврат Т;
КонецФункции

// ═══════════════════════════════════════════════════════════════════════════
//  КЛ-8: Степени знания языков (CEFR + расширение)
// ═══════════════════════════════════════════════════════════════════════════

Функция КлСтепениЯзыка()
    Перем Т, С;
    Т = НовТЗ("Код, Наименование, Описание, УровеньCEFR");
    С = Т.Добавить(); С.Код = "A0"; С.УровеньCEFR = 0; С.Наименование = "Не владею";         С.Описание = "Нет знания языка";
    С = Т.Добавить(); С.Код = "A1"; С.УровеньCEFR = 1; С.Наименование = "Начинающий";        С.Описание = "Базовые слова и фразы";
    С = Т.Добавить(); С.Код = "A2"; С.УровеньCEFR = 2; С.Наименование = "Элементарный";      С.Описание = "Простые фразы в знакомых ситуациях";
    С = Т.Добавить(); С.Код = "B1"; С.УровеньCEFR = 3; С.Наименование = "Средний";           С.Описание = "Понимаю знакомые темы, могу общаться";
    С = Т.Добавить(); С.Код = "B2"; С.УровеньCEFR = 4; С.Наименование = "Выше среднего";     С.Описание = "Понимаю сложные тексты, свободно общаюсь";
    С = Т.Добавить(); С.Код = "C1"; С.УровеньCEFR = 5; С.Наименование = "Продвинутый";       С.Описание = "Гибкое и эффективное использование языка";
    С = Т.Добавить(); С.Код = "C2"; С.УровеньCEFR = 6; С.Наименование = "В совершенстве";    С.Описание = "Понимаю практически всё, говорю без ошибок";
    С = Т.Добавить(); С.Код = "NT"; С.УровеньCEFR = 7; С.Наименование = "Родной язык";       С.Описание = "Язык с рождения";
    Возврат Т;
КонецФункции

// ═══════════════════════════════════════════════════════════════════════════
//  КЛ-9: Учебные заведения
// ═══════════════════════════════════════════════════════════════════════════

Функция КлУчЗаведения()
    Перем Т, С;
    Т = НовТЗ("Код, Аббревиатура, ПолноеНаименование, Город, Тип");
    С = Т.Добавить(); С.Код = "0001"; С.Аббревиатура = "МГУ";          С.Город = "Москва";          С.Тип = "Университет";  С.ПолноеНаименование = "Московский государственный университет им. М.В. Ломоносова";
    С = Т.Добавить(); С.Код = "0002"; С.Аббревиатура = "СПбГУ";        С.Город = "Санкт-Петербург"; С.Тип = "Университет";  С.ПолноеНаименование = "Санкт-Петербургский государственный университет";
    С = Т.Добавить(); С.Код = "0003"; С.Аббревиатура = "МГТУ";         С.Город = "Москва";          С.Тип = "Университет";  С.ПолноеНаименование = "МГТУ им. Н.Э. Баумана";
    С = Т.Добавить(); С.Код = "0004"; С.Аббревиатура = "НГУ";          С.Город = "Новосибирск";     С.Тип = "Университет";  С.ПолноеНаименование = "Новосибирский государственный университет";
    С = Т.Добавить(); С.Код = "0005"; С.Аббревиатура = "УрФУ";         С.Город = "Екатеринбург";    С.Тип = "Университет";  С.ПолноеНаименование = "Уральский федеральный университет им. Б.Н. Ельцина";
    С = Т.Добавить(); С.Код = "0006"; С.Аббревиатура = "КФУ";          С.Город = "Казань";          С.Тип = "Университет";  С.ПолноеНаименование = "Казанский (Приволжский) федеральный университет";
    С = Т.Добавить(); С.Код = "0007"; С.Аббревиатура = "Финансовый";   С.Город = "Москва";          С.Тип = "Университет";  С.ПолноеНаименование = "Финансовый университет при Правительстве Российской Федерации";
    С = Т.Добавить(); С.Код = "0008"; С.Аббревиатура = "РАНХиГС";      С.Город = "Москва";          С.Тип = "Академия";     С.ПолноеНаименование = "Российская академия народного хозяйства и государственной службы";
    С = Т.Добавить(); С.Код = "0009"; С.Аббревиатура = "ННГУ";         С.Город = "Нижний Новгород"; С.Тип = "Университет";  С.ПолноеНаименование = "Нижегородский государственный университет им. Н.И. Лобачевского";
    С = Т.Добавить(); С.Код = "1001"; С.Аббревиатура = "ЭкКолледж";    С.Город = "—";               С.Тип = "Колледж";      С.ПолноеНаименование = "Экономический колледж";
    С = Т.Добавить(); С.Код = "1002"; С.Аббревиатура = "ПолитехКолл."; С.Город = "—";               С.Тип = "Колледж";      С.ПолноеНаименование = "Политехнический колледж";
    С = Т.Добавить(); С.Код = "9999"; С.Аббревиатура = "Другое";       С.Город = "—";               С.Тип = "Другое";       С.ПолноеНаименование = "Иное учебное заведение";
    Возврат Т;
КонецФункции

// ─── Загрузка всех классификаторов ───────────────────────────────────────

Перем КлФ01, КлФ02, КлФ03, КлФ04, КлФ05, КлФ06, КлФ07, КлФ08, КлФ09;

КлФ01 = КлДокументыЛичности();
КлФ02 = КлВидыОбразования();
КлФ03 = КлСемПоложение();
КлФ04 = КлСтепениРодства();
КлФ05 = КлВидыСтажа();
КлФ06 = КлПрофессии();
КлФ07 = КлЯзыки();
КлФ08 = КлСтепениЯзыка();
КлФ09 = КлУчЗаведения();

// ─── Отчёт: сводка классификаторов ───────────────────────────────────────

Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  ЗАГРУЖЕННЫЕ КЛАССИФИКАТОРЫ ЗУП");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  %-5s  %-50s  %6s", "№", "Классификатор", "Записей"));
Сообщить("  " + СтрПовтор("─", 65));

Перем КлИменаТЗ;
КлИменаТЗ = Новый Массив;
КлИменаТЗ.Добавить(Новый Структура("Н, Т", "КЛ-01  Документы, удостоверяющие личность", КлФ01));
КлИменаТЗ.Добавить(Новый Структура("Н, Т", "КЛ-02  Виды образования",                   КлФ02));
КлИменаТЗ.Добавить(Новый Структура("Н, Т", "КЛ-03  Семейное положение",                  КлФ03));
КлИменаТЗ.Добавить(Новый Структура("Н, Т", "КЛ-04  Степени родства",                     КлФ04));
КлИменаТЗ.Добавить(Новый Структура("Н, Т", "КЛ-05  Виды стажа",                          КлФ05));
КлИменаТЗ.Добавить(Новый Структура("Н, Т", "КЛ-06  Профессии рабочих (ОКПДТР)",          КлФ06));
КлИменаТЗ.Добавить(Новый Структура("Н, Т", "КЛ-07  Языки народов мира",                  КлФ07));
КлИменаТЗ.Добавить(Новый Структура("Н, Т", "КЛ-08  Степени знания языков",               КлФ08));
КлИменаТЗ.Добавить(Новый Структура("Н, Т", "КЛ-09  Учебные заведения",                   КлФ09));

Перем ИтЗап, Эл, НомПозиции;
ИтЗап = 0;
НомПозиции = 1;
Для Каждого Эл Из КлИменаТЗ Цикл
    Сообщить(СтрШаблон("  %-5s  %-50s  %6s",
        Формат(НомПозиции, "ЧЦ=5; ЧДЦ=0"),
        Лев(Эл.Н, 50),
        Формат(Эл.Т.Количество(), "ЧЦ=6; ЧДЦ=0")));
    ИтЗап = ИтЗап + Эл.Т.Количество();
    НомПозиции = НомПозиции + 1;
КонецЦикла;

Сообщить("  " + СтрПовтор("─", 65));
Сообщить(СтрШаблон("  %-57s  %6s", "ИТОГО записей:", Формат(ИтЗап, "ЧЦ=6; ЧДЦ=0")));

// ═══════════════════════════════════════════════════════════════════════════
//  ЗАПОЛНЕНИЕ ИНФОБАЗЫ: Графики работы
// ═══════════════════════════════════════════════════════════════════════════

Перем Графики;
Графики = Новый Соответствие;

// ── 1. Пятидневная рабочая неделя (40 ч)
Перем Г5Д, Дни5;
Г5Д  = Новый ГрафикРаботы("Пятидневная рабочая неделя (40 ч)");
Дни5 = Новый Массив;
Дни5.Добавить(1); Дни5.Добавить(2); Дни5.Добавить(3); Дни5.Добавить(4); Дни5.Добавить(5);
Г5Д.УстановитьНедельный(Дни5, 8);
Графики["5Д40"] = Г5Д;

// ── 2. Шестидневная рабочая неделя (40 ч)
Перем Г6Д, Дни6;
Г6Д  = Новый ГрафикРаботы("Шестидневная рабочая неделя (40 ч)");
Дни6 = Новый Массив;
Дни6.Добавить(1); Дни6.Добавить(2); Дни6.Добавить(3);
Дни6.Добавить(4); Дни6.Добавить(5); Дни6.Добавить(6);
Г6Д.УстановитьНедельный(Дни6, 6.67);
Графики["6Д40"] = Г6Д;

// ── 3. Сменный 2 рабочих / 2 выходных (12-часовые смены)
Перем Г22, Ц22;
Г22 = Новый ГрафикРаботы("Сменный 2/2 (12-часовые смены)");
Ц22 = Новый Массив;
Ц22.Добавить(Истина); Ц22.Добавить(Истина); Ц22.Добавить(Ложь); Ц22.Добавить(Ложь);
Г22.УстановитьСменный(Ц22, 11.0, '20250101');   // 11 ч = 12 ч смена − 1 ч обед
Графики["СМ22"] = Г22;

// ── 4. Сутки через трое (24-часовые дежурства)
Перем ГСТ, ЦСТ;
ГСТ = Новый ГрафикРаботы("Сутки через трое (24-часовые дежурства)");
ЦСТ = Новый Массив;
ЦСТ.Добавить(Истина); ЦСТ.Добавить(Ложь); ЦСТ.Добавить(Ложь); ЦСТ.Добавить(Ложь);
ГСТ.УстановитьСменный(ЦСТ, 23.0, '20250101');   // 23 ч = 24 ч − 1 ч на приём пищи
Графики["СТ13"] = ГСТ;

// ── 5. Неполная ставка 0.5 (4 ч/день, пн–пт)
Перем ГНС, ДниНС;
ГНС   = Новый ГрафикРаботы("Неполная ставка 0.5 (20 ч/нед)");
ДниНС = Новый Массив;
ДниНС.Добавить(1); ДниНС.Добавить(2); ДниНС.Добавить(3); ДниНС.Добавить(4); ДниНС.Добавить(5);
ГНС.УстановитьНедельный(ДниНС, 4.0);
Графики["НС05"] = ГНС;

// ─── Отчёт: сравнение графиков работы за апрель 2025 ─────────────────────

Перем НачАпр, КонАпр;
НачАпр = НачалоМесяца('20250401');
КонАпр = КонецМесяца('20250401');

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  СРАВНЕНИЕ ГРАФИКОВ РАБОТЫ — АПРЕЛЬ 2025");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  %-10s  %-38s  %5s  %8s  %8s",
    "Код", "Наименование", "Ч/нед", "Раб.дней", "Раб.часов"));
Сообщить("  " + СтрПовтор("─", 72));

Перем КодГ, ГОбъект;
Для Каждого КодГ Из СписокКлючейГрафиков() Цикл
    ГОбъект = Графики[КодГ];
    Сообщить(СтрШаблон("  %-10s  %-38s  %5s  %8s  %8s",
        КодГ,
        Лев(ГОбъект.name, 38),
        Формат(ГОбъект.ЧасовВНеделю(), "ЧЦ=5; ЧДЦ=1"),
        Формат(ГОбъект.РабочихДней(НачАпр, КонАпр),  "ЧЦ=8; ЧДЦ=0"),
        Формат(ГОбъект.РабочихЧасов(НачАпр, КонАпр), "ЧЦ=8; ЧДЦ=1")));
КонецЦикла;

Функция СписокКлючейГрафиков()
    Перем Рез;
    Рез = Новый Массив;
    Рез.Добавить("5Д40"); Рез.Добавить("6Д40");
    Рез.Добавить("СМ22"); Рез.Добавить("СТ13"); Рез.Добавить("НС05");
    Возврат Рез;
КонецФункции

// ─── Мини-производственный календарь: май 2025, 5-дневка ─────────────────

Процедура КалендарьМесяца(Знач График, Знач ДатаМес, Знач ЗаголовокГрафика)
    Перем Д, КонМес, СтрНед, РабЧасов, ВсегоРаб, ВсегоЧас;
    КонМес     = КонецМесяца(ДатаМес);
    Д          = НачалоМесяца(ДатаМес);
    СтрНед     = "";
    ВсегоРаб   = 0;
    ВсегоЧас   = 0;
    Сообщить("");
    Сообщить(СтрШаблон("  ПРОИЗВОДСТВЕННЫЙ КАЛЕНДАРЬ: %1  [%2]",
        Формат(ДатаМес, "ДФ='ММММ гггг'"), ЗаголовокГрафика));
    Сообщить("  Пн  Вт  Ср  Чт  Пт  Сб  Вс");
    // Сдвиг: первый день может быть не понедельник
    Перем ДеньН, Пад;
    ДеньН = ДеньНедели(Д);
    СтрНед = СтрПовтор("    ", ДеньН - 1);
    Пока Д <= КонМес Цикл
        Перем ДН;
        ДН = ДеньНедели(Д);
        Если График.ЭтоРабочийДень(Д) Тогда
            СтрНед = СтрНед + СтрШаблон("[%1]", Формат(День(Д), "ЧЦ=2; ЧДЦ=0; ЧВН="));
            ВсегоРаб = ВсегоРаб + 1;
        Иначе
            СтрНед = СтрНед + СтрШаблон(" %1 ", Формат(День(Д), "ЧЦ=2; ЧДЦ=0; ЧВН="));
        КонецЕсли;
        Если ДН = 7 Тогда
            Сообщить("  " + СтрНед);
            СтрНед = "";
        КонецЕсли;
        Д = ДобавитьДни(Д, 1);
    КонецЦикла;
    Если СтрДлина(СокрЛП(СтрНед)) > 0 Тогда
        Сообщить("  " + СтрНед);
    КонецЕсли;
    ВсегоЧас = ВсегоРаб * График._hours;
    Сообщить(СтрШаблон("  [хх] — рабочий день | Итого: %1 раб.дней, %2 ч",
        ВсегоРаб, Формат(ВсегоЧас, "ЧДЦ=1")));
КонецПроцедуры

КалендарьМесяца(Г5Д, '20250501', "5Д40");
КалендарьМесяца(Г22, '20250501', "СМ22");

// ═══════════════════════════════════════════════════════════════════════════
//  ЗАПОЛНЕНИЕ ИНФОБАЗЫ: Штатное расписание (РегистрСведений)
// ═══════════════════════════════════════════════════════════════════════════

Перем РегШТ;
РегШТ = Новый РегистрСведений("ШтатноеРасписание", Истина);

Перем ДатаШТ;
ДатаШТ = '20250101';

// Администрация (ADMIN)
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "ADMIN", "DIR"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        1, 120000, 150000, "Руководители", "5Д40"), ДатаШТ);
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "ADMIN", "CHIEF_ACC"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        1, 90000, 110000, "Специалисты", "5Д40"), ДатаШТ);
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "ADMIN", "LAWYER"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        1, 80000, 100000, "Специалисты", "5Д40"), ДатаШТ);
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "ADMIN", "HR"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        1, 70000, 90000, "Специалисты", "5Д40"), ДатаШТ);

// Отдел продаж (SALES)
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "SALES", "SALES_HEAD"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        1, 90000, 110000, "Руководители", "5Д40"), ДатаШТ);
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "SALES", "MGR"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        5, 65000, 85000, "Специалисты", "5Д40"), ДатаШТ);

// Производство (PROD)
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "PROD", "PROD_HEAD"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        1, 95000, 115000, "Руководители", "5Д40"), ДатаШТ);
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "PROD", "TECH"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        3, 75000, 90000, "Специалисты", "5Д40"), ДатаШТ);
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "PROD", "OPERATOR"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        4, 55000, 70000, "Рабочие", "СМ22"), ДатаШТ);

// Логистика (LOGIST)
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "LOGIST", "DRIVER"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        3, 55000, 65000, "Рабочие", "5Д40"), ДатаШТ);
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "LOGIST", "LOADER"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        4, 45000, 55000, "Рабочие", "5Д40"), ДатаШТ);
РегШТ.Записать(Новый Структура("КодПодр, КодДолжн", "LOGIST", "DISPATCHER"),
    Новый Структура("Ставок, ОкладМин, ОкладМакс, Категория, КодГрафика",
        2, 55000, 70000, "Служащие", "СМ22"), ДатаШТ);

// ─── Отчёт: штатное расписание с ФОТ ─────────────────────────────────────

// Строим ТЗ для запроса
Перем ТЗШт, СтрШт;
ТЗШт = Новый ТаблицаЗначений;
ТЗШт.Колонки.Добавить("КодПодр");
ТЗШт.Колонки.Добавить("КодДолжн");
ТЗШт.Колонки.Добавить("Категория");
ТЗШт.Колонки.Добавить("Ставок");
ТЗШт.Колонки.Добавить("ОкладМин");
ТЗШт.Колонки.Добавить("ОкладМакс");
ТЗШт.Колонки.Добавить("КодГрафика");

// Итерируем записи регистра сведений
Перем ВыбРШТ;
ВыбРШТ = РегШТ.Выбрать(ДатаШТ, ДатаШТ);
Пока ВыбРШТ.Следующий() Цикл
    СтрШт = ТЗШт.Добавить();
    СтрШт.КодПодр    = ВыбРШТ.Получить("КодПодр");
    СтрШт.КодДолжн   = ВыбРШТ.Получить("КодДолжн");
    СтрШт.Категория  = ВыбРШТ.Получить("Категория");
    СтрШт.Ставок     = ВыбРШТ.Получить("Ставок");
    СтрШт.ОкладМин   = ВыбРШТ.Получить("ОкладМин");
    СтрШт.ОкладМакс  = ВыбРШТ.Получить("ОкладМакс");
    СтрШт.КодГрафика = ВыбРШТ.Получить("КодГрафика");
КонецЦикла;

Перем ЗапрШт;
ЗапрШт = Новый Запрос("
|SELECT КодПодр, КодДолжн, Категория, КодГрафика,
|       Ставок, ОкладМин, ОкладМакс,
|       Ставок * ОкладМин AS ФОТМин,
|       Ставок * ОкладМакс AS ФОТМакс
|FROM ТЗШт
|ORDER BY КодПодр ASC, Категория ASC, ФОТМакс DESC");
ЗапрШт.УстановитьПараметр("ТЗШт", ТЗШт);
Перем РезШт;
РезШт = ЗапрШт.Выполнить().Выгрузить();

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════════════");
Сообщить("  ШТАТНОЕ РАСПИСАНИЕ на 01.01.2025 — АНАЛИЗ ФОТ");
Сообщить("══════════════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  %-6s  %-12s  %-12s  %-5s  %7s  %7s  %9s  %9s",
    "Подр.", "Должность", "Категория", "Граф.", "Ставок",
    "Окл.мин", "ФОТ мин", "ФОТ макс"));
Сообщить("  " + СтрПовтор("─", 76));

Перем ИтФОТМин, ИтФОТМакс, ИтСтавок, СтрВыб2;
ИтФОТМин  = 0;
ИтФОТМакс = 0;
ИтСтавок  = 0;
Для Каждого СтрВыб2 Из РезШт Цикл
    Сообщить(СтрШаблон("  %-6s  %-12s  %-12s  %-5s  %7s  %7s  %9s  %9s",
        Лев(СтрВыб2["КодПодр"],    6),
        Лев(СтрВыб2["КодДолжн"],  12),
        Лев(СтрВыб2["Категория"], 12),
        Лев(СтрВыб2["КодГрафика"], 5),
        Формат(СтрВыб2["Ставок"],  "ЧЦ=7; ЧДЦ=0"),
        Формат(СтрВыб2["ОкладМин"],"ЧЦ=7; ЧДЦ=0"),
        Формат(СтрВыб2["ФОТМин"],  "ЧЦ=9; ЧДЦ=0"),
        Формат(СтрВыб2["ФОТМакс"], "ЧЦ=9; ЧДЦ=0")));
    ИтСтавок  = ИтСтавок  + СтрВыб2["Ставок"];
    ИтФОТМин  = ИтФОТМин  + СтрВыб2["ФОТМин"];
    ИтФОТМакс = ИтФОТМакс + СтрВыб2["ФОТМакс"];
КонецЦикла;
Сообщить("  " + СтрПовтор("─", 76));
Сообщить(СтрШаблон("  %-44s  %7s  %9s  %9s", "ИТОГО:",
    Формат(ИтСтавок,  "ЧЦ=7; ЧДЦ=0"),
    Формат(ИтФОТМин,  "ЧЦ=9; ЧДЦ=0"),
    Формат(ИтФОТМакс, "ЧЦ=9; ЧДЦ=0")));

// ═══════════════════════════════════════════════════════════════════════════
//  ЗАПОЛНЕНИЕ ИНФОБАЗЫ: Учётная политика по персоналу
// ═══════════════════════════════════════════════════════════════════════════

Перем УчПол;
УчПол = Новый Структура(
    "Организация, ИНН, КПП, " +
    "НалоговыйМетод, СтавкаНДФЛ, СтавкаНДФЛВысокая, ПорогВысокойСтавки, " +
    "СтавкаОПС, СтавкаОМС, СтавкаОСС, " +
    "ВычетРеб1, ВычетРеб2, ВычетРеб3, ВычетИнвалид, " +
    "МетодСреднего, МесяцевСреднего, КодГрафикаОсновной");

УчПол.Организация          = "ООО «Техснаб-Продукт»";
УчПол.ИНН                  = "7712345678";
УчПол.КПП                  = "771201001";
УчПол.НалоговыйМетод       = "НарастающимИтогом";
УчПол.СтавкаНДФЛ           = 0.13;
УчПол.СтавкаНДФЛВысокая    = 0.15;   // с 2025: >2,4 млн/год
УчПол.ПорогВысокойСтавки   = 200000; // 2 400 000 / 12 мес
УчПол.СтавкаОПС            = 0.22;
УчПол.СтавкаОМС            = 0.051;
УчПол.СтавкаОСС            = 0.029;
УчПол.ВычетРеб1            = 1400;
УчПол.ВычетРеб2            = 1400;
УчПол.ВычетРеб3            = 3000;
УчПол.ВычетИнвалид         = 12000;
УчПол.МетодСреднего        = "Календарные";
УчПол.МесяцевСреднего      = 12;
УчПол.КодГрафикаОсновной   = "5Д40";

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  УЧЁТНАЯ ПОЛИТИКА ПО ПЕРСОНАЛУ");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  Организация:            %1 (ИНН %2 / КПП %3)",
    УчПол.Организация, УчПол.ИНН, УчПол.КПП));
Сообщить(СтрШаблон("  Метод расчёта НДФЛ:     %1", УчПол.НалоговыйМетод));
Сообщить(СтрШаблон("  Ставка НДФЛ:            %1%% / %2%% (свыше %3 р./мес.)",
    Формат(УчПол.СтавкаНДФЛ * 100, "ЧДЦ=0"),
    Формат(УчПол.СтавкаНДФЛВысокая * 100, "ЧДЦ=0"),
    Формат(УчПол.ПорогВысокойСтавки, "ЧЦ=9; ЧДЦ=0")));
Сообщить(СтрШаблон("  Взносы:                 ОПС %1%% + ОМС %2%% + ОСС %3%% = %4%%",
    Формат(УчПол.СтавкаОПС * 100, "ЧДЦ=1"),
    Формат(УчПол.СтавкаОМС * 100, "ЧДЦ=1"),
    Формат(УчПол.СтавкаОСС * 100, "ЧДЦ=1"),
    Формат((УчПол.СтавкаОПС + УчПол.СтавкаОМС + УчПол.СтавкаОСС) * 100, "ЧДЦ=1")));
Сообщить(СтрШаблон("  Вычеты (ст. 218 НК):   1-й ребёнок: %1 р.  2-й: %2 р.  3-й+: %3 р.  Инвалид: %4 р.",
    УчПол.ВычетРеб1, УчПол.ВычетРеб2, УчПол.ВычетРеб3, УчПол.ВычетИнвалид));
Сообщить(СтрШаблон("  Средний заработок:     %1 (%2 мес.)  |  Основной график: %3",
    УчПол.МетодСреднего, УчПол.МесяцевСреднего, УчПол.КодГрафикаОсновной));

// ═══════════════════════════════════════════════════════════════════════════
//  ЛИЧНАЯ КАРТОЧКА СОТРУДНИКА (форма Т-2, упрощённая)
// ═══════════════════════════════════════════════════════════════════════════

Перем Карта;
Карта = Новый Структура(
    "ТабН, ФИО, ДатаРожд, МестоРожд, Пол, КодГражд, " +
    "КодСемПол, КодДокТип, СерНомДок, ДатаВыдДок, КемВыдан, " +
    "ИНН, СНИЛС, " +
    "КодОбр, КодУчЗав, НаимДиплома, ГодОконч, " +
    "КодОКПДТР, КодГрафика");

Карта.ТабН        = "003";
Карта.ФИО         = "Попов Дмитрий Сергеевич";
Карта.ДатаРожд    = '19880315';
Карта.МестоРожд   = "г. Нижний Новгород";
Карта.Пол         = "М";
Карта.КодГражд    = "RU";
Карта.КодСемПол   = "1";     // в зарегистрированном браке
Карта.КодДокТип   = "21";    // паспорт РФ
Карта.СерНомДок   = "22 03 456789";
Карта.ДатаВыдДок  = '20080320';
Карта.КемВыдан    = "ОУФМС России по Нижегородской обл.";
Карта.ИНН         = "525012345678";
Карта.СНИЛС       = "123-456-789 00";
Карта.КодОбр      = "06";    // специалитет/магистратура
Карта.КодУчЗав    = "0009";  // ННГУ
Карта.НаимДиплома = "Экономика и управление на предприятии";
Карта.ГодОконч    = 2010;
Карта.КодОКПДТР   = "18505"; // менеджер
Карта.КодГрафика  = "5Д40";

// Дети (иждивенцы для вычетов по ст. 218 НК РФ)
Перем ДетиКарты;
ДетиКарты = Новый Массив;
ДетиКарты.Добавить(Новый Структура("ФИО, ДатаРожд, КодРодства, Инвалид",
    "Попова Анна Дмитриевна",    '20120605', "04", Ложь));  // дочь, 1-й ребёнок
ДетиКарты.Добавить(Новый Структура("ФИО, ДатаРожд, КодРодства, Инвалид",
    "Попов Максим Дмитриевич",   '20150910', "03", Ложь));  // сын, 2-й ребёнок

// Владение языками
Перем ЯзыкиКарты;
ЯзыкиКарты = Новый Массив;
ЯзыкиКарты.Добавить(Новый Структура("КодISO, КодСтепени", "RU", "NT"));  // родной
ЯзыкиКарты.Добавить(Новый Структура("КодISO, КодСтепени", "EN", "B2"));  // выше среднего

// Трудовой стаж
Перем СтажКарты;
СтажКарты = Новый Массив;
СтажКарты.Добавить(Новый Структура("КодВидаСтажа, ГодЛет, ГодМес, ГодДней",
    "ОС", 14, 2, 10));   // общий стаж
СтажКарты.Добавить(Новый Структура("КодВидаСтажа, ГодЛет, ГодМес, ГодДней",
    "СП", 10, 5, 0));    // стаж по специальности
СтажКарты.Добавить(Новый Структура("КодВидаСтажа, ГодЛет, ГодМес, ГодДней",
    "СГС", 14, 2, 10));  // страховой стаж

// ─── Расчёт стандартных налоговых вычетов (ст. 218 НК РФ) ────────────────

Функция СтандартныйВычет(Знач Дети, Знач УчПолит)
    Перем Вычет, Ном, Реб;
    Вычет = 0;
    Ном   = 0;
    Для Каждого Реб Из Дети Цикл
        Ном = Ном + 1;
        Если Реб.Инвалид Тогда
            Вычет = Вычет + УчПолит.ВычетИнвалид;
        ИначеЕсли Ном = 1 Тогда
            Вычет = Вычет + УчПолит.ВычетРеб1;
        ИначеЕсли Ном = 2 Тогда
            Вычет = Вычет + УчПолит.ВычетРеб2;
        Иначе
            Вычет = Вычет + УчПолит.ВычетРеб3;
        КонецЕсли;
    КонецЦикла;
    Возврат Вычет;
КонецФункции

Функция РассчитатьНДФЛ218(Знач НачСумма, Знач Вычет, Знач УчПолит)
    Перем НалБаза, СтавкаНДФЛ;
    НалБаза  = Макс(НачСумма - Вычет, 0);
    Если НачСумма > УчПолит.ПорогВысокойСтавки Тогда
        СтавкаНДФЛ = УчПолит.СтавкаНДФЛВысокая;
    Иначе
        СтавкаНДФЛ = УчПол.СтавкаНДФЛ;
    КонецЕсли;
    Возврат Окр(НалБаза * СтавкаНДФЛ, 2);
КонецФункции

// Вывод личной карточки
Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  ЛИЧНАЯ КАРТОЧКА (форма Т-2 упрощённая)");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  Таб.№: %1        ФИО: %2", Карта.ТабН, Карта.ФИО));
Сообщить(СтрШаблон("  Дата рождения: %1  |  Место: %2  |  Пол: %3",
    Формат(Карта.ДатаРожд, "ДФ='дд.ММ.гггг'"), Карта.МестоРожд, Карта.Пол));

// Документ
Перем НаимДокТип;
Перем НайдДок;
НайдДок = КлФ01.Найти(Карта.КодДокТип, "Код");
Если НайдДок <> Неопределено Тогда
    НаимДокТип = НайдДок.Наименование;
Иначе
    НаимДокТип = "Неизвестный документ";
КонецЕсли;
Сообщить(СтрШаблон("  Документ: %1 | Серия/Номер: %2 | Выдан: %3",
    Лев(НаимДокТип, 40), Карта.СерНомДок, Карта.КемВыдан));
Сообщить(СтрШаблон("  ИНН: %1  |  СНИЛС: %2", Карта.ИНН, Карта.СНИЛС));

// Образование
Перем НайдОбр, НайдУчЗ;
НайдОбр = КлФ02.Найти(Карта.КодОбр, "Код");
НайдУчЗ = КлФ09.Найти(Карта.КодУчЗав, "Код");
Сообщить(СтрШаблон("  Образование: %1",
    НайдОбр <> Неопределено ? НайдОбр.Наименование : Карта.КодОбр));
Сообщить(СтрШаблон("  Учебное заведение: %1 (%2 г.в.)",
    НайдУчЗ <> Неопределено ? НайдУчЗ.Аббревиатура : Карта.КодУчЗав,
    Карта.ГодОконч));
Сообщить(СтрШаблон("  Специальность: %1", Карта.НаимДиплома));

// Семейное положение
Перем НайдСем;
НайдСем = КлФ03.Найти(Карта.КодСемПол, "Код");
Сообщить(СтрШаблон("  Семейное положение: %1",
    НайдСем <> Неопределено ? НайдСем.Наименование : Карта.КодСемПол));

// Иждивенцы
Сообщить(СтрШаблон("  Иждивенцы (%1 чел.):", ДетиКарты.Количество()));
Перем НомРеб, Реб;
НомРеб = 0;
Для Каждого Реб Из ДетиКарты Цикл
    НомРеб = НомРеб + 1;
    Перем НайдРодство;
    НайдРодство = КлФ04.Найти(Реб.КодРодства, "Код");
    Сообщить(СтрШаблон("    %1. %2 (%3, %4)",
        НомРеб, Реб.ФИО,
        НайдРодство <> Неопределено ? НайдРодство.Наименование : Реб.КодРодства,
        Формат(Реб.ДатаРожд, "ДФ='дд.ММ.гггг'")));
КонецЦикла;

// Языки
Сообщить("  Иностранные языки:");
Перем ЯзЗап;
Для Каждого ЯзЗап Из ЯзыкиКарты Цикл
    Перем НайдЯз, НайдСтЯз;
    НайдЯз   = КлФ07.Найти(ЯзЗап.КодISO,    "КодISO");
    НайдСтЯз = КлФ08.Найти(ЯзЗап.КодСтепени, "Код");
    Сообщить(СтрШаблон("    %1 — %2",
        НайдЯз   <> Неопределено ? НайдЯз.Наименование   : ЯзЗап.КодISO,
        НайдСтЯз <> Неопределено ? НайдСтЯз.Наименование : ЯзЗап.КодСтепени));
КонецЦикла;

// Стаж
Сообщить("  Трудовой стаж:");
Перем СтажЗап;
Для Каждого СтажЗап Из СтажКарты Цикл
    Перем НайдСтаж;
    НайдСтаж = КлФ05.Найти(СтажЗап.КодВидаСтажа, "Код");
    Сообщить(СтрШаблон("    %1: %2 лет %3 мес. %4 дн.",
        НайдСтаж <> Неопределено ? Лев(НайдСтаж.Наименование, 40) : СтажЗап.КодВидаСтажа,
        СтажЗап.ГодЛет, СтажЗап.ГодМес, СтажЗап.ГодДней));
КонецЦикла;

// Налоговые вычеты
Перем Вычет218, Оклад003, НДФЛ218, НаРуки;
Вычет218 = СтандартныйВычет(ДетиКарты, УчПол);
Оклад003 = 75000;
НДФЛ218  = РассчитатьНДФЛ218(Оклад003, Вычет218, УчПол);
НаРуки   = Оклад003 - НДФЛ218;

Сообщить("");
Сообщить(СтрПовтор("─", 60));
Сообщить(СтрШаблон("  Оклад:                 %1 р.", Формат(Оклад003, "ЧЦ=8; ЧДЦ=0")));
Сообщить(СтрШаблон("  Вычеты по детям:       %1 р. (%2 × %3 + %4 × %5)",
    Формат(Вычет218, "ЧЦ=8; ЧДЦ=0"),
    1, УчПол.ВычетРеб1, 1, УчПол.ВычетРеб2));
Сообщить(СтрШаблон("  НДФЛ к удержанию:      %1 р. (база %2 р. × %3%%)",
    Формат(НДФЛ218, "ЧЦ=8; ЧДЦ=2"),
    Формат(Оклад003 - Вычет218, "ЧЦ=8; ЧДЦ=0"),
    Формат(УчПол.СтавкаНДФЛ * 100, "ЧДЦ=0")));
Сообщить(СтрШаблон("  К выдаче «на руки»:    %1 р.",
    Формат(НаРуки, "ЧЦ=8; ЧДЦ=2")));

// ─── Финальный запрос: состав штата по категориям ─────────────────────────

Перем ЗапрКат;
ЗапрКат = Новый Запрос("
|SELECT Категория,
|       SUM(Ставок) AS ВсегоСтавок,
|       SUM(Ставок * ОкладМин) AS ФОТМин,
|       SUM(Ставок * ОкладМакс) AS ФОТМакс
|FROM ТЗШт
|GROUP BY Категория
|ORDER BY ФОТМакс DESC");
ЗапрКат.УстановитьПараметр("ТЗШт", ТЗШт);
Перем РезКат;
РезКат = ЗапрКат.Выполнить().Выгрузить();

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  ШТАТ ПО КАТЕГОРИЯМ ПЕРСОНАЛА");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  %-14s  %7s  %10s  %10s",
    "Категория", "Ставок", "ФОТ мин.", "ФОТ макс."));
Сообщить("  " + СтрПовтор("─", 44));
Перем СтрКат;
Для Каждого СтрКат Из РезКат Цикл
    Сообщить(СтрШаблон("  %-14s  %7s  %10s  %10s",
        Лев(СтрКат["Категория"], 14),
        Формат(СтрКат["ВсегоСтавок"], "ЧЦ=7; ЧДЦ=0"),
        Формат(СтрКат["ФОТМин"],      "ЧЦ=10; ЧДЦ=0"),
        Формат(СтрКат["ФОТМакс"],     "ЧЦ=10; ЧДЦ=0")));
КонецЦикла;

// Функция День() для извлечения дня из даты
Функция День(Знач Дата)
    Возврат ЧислоИзСтроки(Формат(Дата, "ДФ='дд'"));
КонецФункции

Функция ЧислоИзСтроки(Знач Стр)
    Возврат Число(СокрЛП(Стр));
КонецФункции
