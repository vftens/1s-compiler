// ══════════════════════════════════════════════════════════════════════
// 1S: ERP Free Edition — Повний ERP-цикл (аналог SAP)
// Модулі: Закупівлі → Склад → Логістика → ЗУП → Ремонти
// Всі операції через Workflow
// ══════════════════════════════════════════════════════════════════════

Повідомити("╔══════════════════════════════════════════════════════════════╗");
Повідомити("║   1S: ERP  —  ПОВНИЙ ERP-ЦИКЛ  —  Українська                ║");
Повідомити("║   Логістика | Закупівлі | Склад | ЗП | Ремонти              ║");
Повідомити("╚══════════════════════════════════════════════════════════════╝");
Повідомити("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 1: ЗАКУПІВЛІ (SAP MM)
// ══════════════════════════════════════════════════════════════════════
Повідомити("┌─ БЛОК 1: ЗАКУПІВЛІ ───────────────────────────────────────┐");

Перем Пост1, Пост2;
Пост1 = Постачальник("АТ Металсервіс", "SUPP-001");
Пост1.rating = 9.2;
Пост1.payment_days = 30;

Пост2 = Постачальник("ТОВ ТехноЗапчастина", "SUPP-002");
Пост2.rating = 7.8;
Пост2.payment_days = 14;

Повідомити("  Постачальники:");
Повідомити(ШаблонРядка("    %1 [рейт. %2] — відстрочка %3 дн.", Пост1.Назва, Пост1.Рейтинґ, Пост1.ДниОплаты));
Повідомити(ШаблонРядка("    %1 [рейт. %2] — відстрочка %3 дн.", Пост2.Назва, Пост2.Рейтинґ, Пост2.ДниОплаты));

Перем ЗП1;
ЗП1 = ЗамовленняПостачальнику("ЗМ-2025-001", Пост1);
ЗП1.ДодатиРядок("STL-001",  "Сталь листова 4мм",      500, 85);
ЗП1.ДодатиРядок("BOLT-M12", "Болт М12×50 (кг)",        200, 45);
ЗП1.ДодатиРядок("PIPE-50",  "Труба сталева Ду50 (м)",   80, 320);

ЗП1.submit("Іванов І.І.");
ЗП1.approve("Директор");

Повідомити(ЗП1.report("uk"));
Повідомити("");

// Прибуткова накладна
Перем ПН1;
ПН1 = ПрибутковаНакладна("ПН-2025-001", ЗП1);
ПН1.ДодатиПрихід("STL-001",  "Сталь листова 4мм",      500, 85);
ПН1.ДодатиПрихід("BOLT-M12", "Болт М12×50 (кг)",        200, 45);
ПН1.ДодатиПрихід("PIPE-50",  "Труба сталева Ду50 (м)",   80, 320);
ПН1.submit("комірник");
ПН1.post("склад");

Повідомити(ШаблонРядка("  Прибуткова накладна %1 проведена. Підсумок: %2 грн.", ПН1.number, ПН1.total_amount));
Повідомити("└───────────────────────────────────────────────────────────┘");
Повідомити("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 2: СКЛАДСЬКА АНАЛІТИКА (SAP WM)
// ══════════════════════════════════════════════════════════════════════
Повідомити("┌─ БЛОК 2: СКЛАД ───────────────────────────────────────────┐");

Перем Склд;
Склд = Склад("Головний склад", "WH-01");

Перем Яч1, Яч2, Яч3;
Яч1 = Склд.ДодатиКомірку("A", 1, 1, 5000);
Яч2 = Склд.ДодатиКомірку("A", 1, 2, 5000);
Яч3 = Склд.ДодатиКомірку("B", 2, 1, 3000);

Повідомити(ШаблонРядка("  Комірки: %1 | %2 | %3", Яч1.Адреса, Яч2.Адреса, Яч3.Адреса));

Склд.Прийняти("STL-001",  "Сталь листова 4мм",      500, 85,  Яч1, "ПН-2025-001");
Склд.Прийняти("BOLT-M12", "Болт М12×50 (кг)",        200, 45,  Яч2, "ПН-2025-001");
Склд.Прийняти("PIPE-50",  "Труба сталева Ду50 (м)",   80, 320, Яч3, "ПН-2025-001");

Склд.Відпустити("BOLT-M12", 50,  "Замовлення на вир-во №12");
Склд.Відпустити("STL-001",  120, "Замовлення на вир-во №12");

Повідомити(ШаблонРядка("  Залишок сталі:    %1 листів", Склд.ЗалишокТовару("STL-001")));
Повідомити(ШаблонРядка("  Залишок болтів:   %1 кг",     Склд.ЗалишокТовару("BOLT-M12")));
Повідомити(ШаблонРядка("  Вартість складу:  %1 грн.",    Склд.total_stock_value));

Перем АВС;
АВС = АВС_Аналіз(Склд);
АВС.Виконати();
Повідомити("");
Повідомити(АВС.report("uk"));

Перем Інв;
Інв = Інвентаризація(Склд);
Інв.Перерахувати("STL-001",  375);
Інв.Перерахувати("BOLT-M12", 150);
Інв.Перерахувати("PIPE-50",   82);
Повідомити("");
Повідомити(Інв.report("uk"));
Повідомити("└───────────────────────────────────────────────────────────┘");
Повідомити("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 3: ЛОГІСТИКА (SAP TM)
// ══════════════════════════════════════════════════════════════════════
Повідомити("┌─ БЛОК 3: ЛОГІСТИКА ───────────────────────────────────────┐");

Перем Перев1;
Перев1 = Перевізник("ТОВ АвтоТранс", "CARR-01");
Перев1.rate_per_km = 45;
Перев1.reliability = 0.94;

Перем Маршрут;
Маршрут = МаршрутДоставки("Київ—Харків—Дніпро", Перев1);
Маршрут.total_distance_km = 480;
Маршрут.ДодатиТочку("Київ, склад (відправка)",   Неопределено, 4500);
Маршрут.ДодатиТочку("Харків, завод",               Неопределено, 2000);
Маршрут.ДодатиТочку("Дніпро, склад клієнта",       Неопределено, 2500);

Перем ТЗ;
ТЗ = ТранспортнаЗаявка("ТЗ-2025-001", Перев1, Маршрут);
ТЗ.cargo_description = "Сталь листова + труби";
ТЗ.weight_kg = 4500;

ТЗ.plan("диспетчер");
ТЗ.approve("Логіст");
ТЗ.start_transit("Водій Петренко");
ТЗ.deliver("Водій Петренко");

Повідомити(ТЗ.report("uk"));

Перем АЛ;
АЛ = АналітикаЛогістики();
АЛ.Додати(ТЗ);

Перем ТЗ2;
ТЗ2 = ТранспортнаЗаявка("ТЗ-2025-002", Перев1, Маршрут);
ТЗ2.weight_kg = 3000;
ТЗ2.plan("диспетчер");
ТЗ2.approve("Логіст");
ТЗ2.start_transit();
ТЗ2.fail("Поломка транспорту");
АЛ.Додати(ТЗ2);

Повідомити("");
Повідомити(АЛ.dashboard("uk"));
Повідомити("└───────────────────────────────────────────────────────────┘");
Повідомити("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 4: РОЗРАХУНОК ЗАРПЛАТИ (SAP HCM)
// ══════════════════════════════════════════════════════════════════════
Повідомити("┌─ БЛОК 4: РОЗРАХУНОК ЗАРОБІТНОЇ ПЛАТИ ─────────────────────┐");

Перем НДФЛст, ЄСВст;
НДФЛст = 0.18;   // ПДФО
ЄСВст  = 0.22;   // ЄСВ (нарахування на ФОП)

Перем Список;
Список = Масив();
Перем Зап1, Зап2, Зап3;
Зап1 = Структура();
Зап1.Вставити("Ім'я",       "Іваненко І.І.");
Зап1.Вставити("Оклад",      42000);
Зап1.Вставити("Посада",     "Головний інженер");

Зап2 = Структура();
Зап2.Вставити("Ім'я",       "Сидоренко А.П.");
Зап2.Вставити("Оклад",      28000);
Зап2.Вставити("Посада",     "Бухгалтер");

Зап3 = Структура();
Зап3.Вставити("Ім'я",       "Петренко В.С.");
Зап3.Вставити("Оклад",      22000);
Зап3.Вставити("Посада",     "Комірник");

Список.Додати(Зап1);
Список.Додати(Зап2);
Список.Додати(Зап3);

Перем ФОП, ФОПподатки;
ФОП = 0;
ФОПподатки = 0;

Повідомити("  Розрахунковий лист:");
Повідомити(ШаблонРядка("  %-30s %-10s %-10s %-10s %-10s", "Співробітник", "Оклад", "ПДФО", "На руки", "ЄСВ"));
Повідомити("  " + ПовторитиРядок("-", 72));

Перем Н;
Для Н = 0 По Список.Кількість() - 1 Цикл
    Перем Сотрудник, Оклад, ПДФО, НаРуки, ЄСВ;
    Сотрудник = Список[Н];
    Оклад = Сотрудник.Оклад;
    ПДФО  = Округлити(Оклад * НДФЛст, 2);
    НаРуки = Оклад - ПДФО;
    ЄСВ   = Округлити(Оклад * ЄСВст, 2);
    ФОП = ФОП + НаРуки;
    ФОПподатки = ФОПподатки + ПДФО + ЄСВ;
    Повідомити(ШаблонРядка("  %-30s %10s %10s %10s %10s",
        Сотрудник["Ім'я"], Оклад, ПДФО, НаРуки, ЄСВ));
КінецьЦиклу;

Повідомити("  " + ПовторитиРядок("-", 72));
Повідомити(ШаблонРядка("  РАЗОМ до виплати: %1 грн. | Податки та збори: %2 грн.", ФОП, ФОПподатки));
Повідомити("└───────────────────────────────────────────────────────────┘");
Повідомити("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 5: УПРАВЛІННЯ РЕМОНТАМИ (SAP PM)
// ══════════════════════════════════════════════════════════════════════
Повідомити("┌─ БЛОК 5: УПРАВЛІННЯ РЕМОНТАМИ ────────────────────────────┐");

Перем Обл1, Обл2;
Обл1 = КарткаОбладнання("EQ-001", "Токарний верстат DMG CTX 310");
Обл1.location    = "Цех №1, позиція 3";
Обл1.category    = "Металообробка";
Обл1.manufacturer = "DMG Mori";
Обл1.serial_number = "CTX-2019-83751";
Обл1.odometer_hours = 14250;

Обл2 = КарткаОбладнання("EQ-002", "Компресор ABAC Genesis 1510");
Обл2.location = "Компресорна";
Обл2.odometer_hours = 8900;

Обл1.ReportDefect("DEF-001", "Биття шпинделя > 0.05мм", "high");
Обл1.ReportDefect("DEF-002", "Знос різцетримача",         "medium");
Обл2.ReportDefect("DEF-003", "Витік масла через сальник",  "critical");

Повідомити(Обл1.passport("uk"));
Повідомити("");

Перем НР;
НР = НарядНаРемонт("НР-2025-047", Обл1);
НР.work_type = "Середній ремонт";
НР.defect_description = "Биття шпинделя, знос різцетримача";
НР.labour_hours = 8;
НР.labour_rate = 350;

НР.submit("майстер цеху");
НР.approve("Головний механік");
НР.StartWork("Сергієнко А.В.");
НР.AddMaterial("Підшипник 6208",    2,   920);
НР.AddMaterial("Різцетримач BT40",  1,  2100);
НР.AddMaterial("Мастило Shell",   0.5,  340);
НР.Complete("Сергієнко А.В.");

Повідомити(НР.report("uk"));

Перем АТО;
АТО = АналітикаТО();
АТО.ДодатиОбладнання(Обл1);
АТО.ДодатиОбладнання(Обл2);
АТО.ДодатиНаряд(НР);

Повідомити("");
Повідомити(АТО.dashboard("uk"));
Повідомити("└───────────────────────────────────────────────────────────┘");
Повідомити("");

// ══════════════════════════════════════════════════════════════════════
Повідомити("╔══════════════════════════════════════════════════════════════╗");
Повідомити("║   ПІДСУМОК: ERP-ЦИКЛ ВИКОНАНО (аналог SAP ERP / S/4HANA)    ║");
Повідомити("╠══════════════════════════════════════════════════════════════╣");
Повідомити(ШаблонРядка("║  ✓ Закупівлі:   ЗМ %1 на суму %2 грн.", ЗП1.number, ЗП1.total_amount));
Повідомити(ШаблонРядка("║  ✓ Склад:       %1 позицій | %2 грн.", Склд.stock_count, Склд.total_stock_value));
Повідомити(ШаблонРядка("║  ✓ Логістика:   SLA %1%%", АЛ.sla_pct));
Повідомити(ШаблонРядка("║  ✓ ЗП:          ФОП %1 грн. до виплати", ФОП));
Повідомити(ШаблонРядка("║  ✓ Ремонти:     Наряд %1 — %2 грн.", НР.number, НР.total_cost));
Повідомити("╚══════════════════════════════════════════════════════════════╝");
