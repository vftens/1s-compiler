// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Планування робіт на 4 тижні з реалізацією (Workflow)
// Підприємство «Альфа» · Cічень 2025 · Українська мова
//
// Тижні 1–3: створено → погоджено → частково/повністю виконано
// Тиждень 4: створено → подано → очікує погодження
// ══════════════════════════════════════════════════════════════════════

// ── Журнал аудиту ────────────────────────────────────────────────────
АЖ = АудитЖурнал("ПланРобіт");

// ── Допоміжна функція: вивести рядок завдання ────────────────────────
Функція РядокЗав(Ном, Назва, Відп, Факт)
    Пад = Макс(0, 38 - ДовжинаРядка(Назва));
    Стр = ШаблонРядка("  %1. ", Ном) + Назва + СтрПовтор(" ", Пад);
    Якщо Факт[Назва] = Істина Тоді
        Стр = Стр + " ✓  " + Відп;
    Інакше
        Стр = Стр + " ✗  " + Відп + " (не виконано)";
    КінецьЯкщо;
    Повідомити(Стр);
КінецьФункції;

// ── Допоміжна функція: вивести тижневий план ─────────────────────────
Функція ВивестиТиждень(План, Факт, Заголовок)
    Завд  = План.ТабличнаЧастина("Завдання");
    Всього = Завд.Кількість();
    Зроб  = 0;
    Для Кожного Р З Завд Цикл
        Якщо Факт[Р["Назва"]] = Істина Тоді
            Зроб = Зроб + 1;
        КінецьЯкщо;
    КінецьЦиклу;
    Відсоток = Зроб * 100 / Всього;
    Рядок(Відсоток);   // перетворення для наступного виразу

    Повідомити("── " + Заголовок + " │ Статус: " + План.МетаСтатус("uk") + " ────────────");
    Н = 0;
    Для Кожного Р З Завд Цикл
        Н = Н + 1;
        РядокЗав(Н, Р["Назва"], Р["Відповідальний"], Факт);
    КінецьЦиклу;
    Повідомити(ШаблонРядка("  Виконання: %1/%2 (%3%)", Зроб, Всього, Окр(Відсоток, 0)));
    Повернути Зроб;
КінецьФункції;

// ════════════════════════════════════════════════════════════════════
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  ПЛАН РОБІТ НА CІЧЕНЬ 2025  ·  Підприємство «Альфа»");
Повідомити("══════════════════════════════════════════════════════════════════");

// ────────────────────────────────────────────────────────────────────
// ТИЖДЕНЬ 1 (6-10 Cічня) — 100% виконання
// ────────────────────────────────────────────────────────────────────
П1 = ДокументЗМаршрутом("ТижневийПлан");
П1.Тиждень = 1; П1.Менеджер = "Іваненко О.М.";
П1.ПочПеріоду = '20250106'; П1.КінПеріоду = '20250110';

Зав1 = П1.ТабличнаЧастина("Завдання",
    "Назва, Відповідальний, Дедлайн");

Р = Зав1.Додати(); Р["Назва"] = "Закупівля борошна 1000 кг";     Р["Відповідальний"] = "Петренко"; Р["Дедлайн"] = '20250107';
Р = Зав1.Додати(); Р["Назва"] = "Закупівля цукру та олії 500 кг"; Р["Відповідальний"] = "Петренко"; Р["Дедлайн"] = '20250107';
Р = Зав1.Додати(); Р["Назва"] = "Підготовка договорів з клієнтами"; Р["Відповідальний"] = "Іваненко"; Р["Дедлайн"] = '20250108';
Р = Зав1.Додати(); Р["Назва"] = "Технічний огляд складу";         Р["Відповідальний"] = "Бондар";   Р["Дедлайн"] = '20250109';
Р = Зав1.Додати(); Р["Назва"] = "Звіт за грудень у бухгалтерію";  Р["Відповідальний"] = "Коваль";   Р["Дедлайн"] = '20250110';

П1.Надіслати("Іваненко", "Плановий тиждень стартує 6 cічня");
П1.Погодити("Коваленко (Директор)", "Затверджено, розпочати виконання");
П1.Провести();
АЖ.Записати("Коваленко", "Затвердити", "ТижневийПлан", П1.Номер, "Тиждень 1 затверджено");

// Виконання тижня 1 (100%)
Вик1 = Відповідність();
Вик1["Закупівля борошна 1000 кг"]      = Істина;
Вик1["Закупівля цукру та олії 500 кг"] = Істина;
Вик1["Підготовка договорів з клієнтами"] = Істина;
Вик1["Технічний огляд складу"]          = Істина;
Вик1["Звіт за грудень у бухгалтерію"]   = Істина;
Для Кожного Пара З Вик1 Цикл
    АЖ.Записати("Виконавець", "Виконати", "Завдання", Пара.Ключ, "Виконано у тижні 1");
КінецьЦиклу;

// ────────────────────────────────────────────────────────────────────
// ТИЖДЕНЬ 2 (13-17 Cічня) — 80% виконання
// ────────────────────────────────────────────────────────────────────
П2 = ДокументЗМаршрутом("ТижневийПлан");
П2.Тиждень = 2; П2.Менеджер = "Іваненко О.М.";
П2.ПочПеріоду = '20250113'; П2.КінПеріоду = '20250117';

Зав2 = П2.ТабличнаЧастина("Завдання",
    "Назва, Відповідальний, Дедлайн");
Р = Зав2.Додати(); Р["Назва"] = "Відвантаження товару ТОВ «Альфа»"; Р["Відповідальний"] = "Склад";    Р["Дедлайн"] = '20250113';
Р = Зав2.Додати(); Р["Назва"] = "Оплата постачальнику МатПлюс";     Р["Відповідальний"] = "Коваль";   Р["Дедлайн"] = '20250114';
Р = Зав2.Додати(); Р["Назва"] = "Прийом нового менеджера з продажів"; Р["Відповідальний"] = "Іваненко"; Р["Дедлайн"] = '20250115';
Р = Зав2.Додати(); Р["Назва"] = "Рекламна кампанія в соціальних мережах"; Р["Відповідальний"] = "Маркетолог"; Р["Дедлайн"] = '20250117';
Р = Зав2.Додати(); Р["Назва"] = "Інвентаризація складу";           Р["Відповідальний"] = "Комірник"; Р["Дедлайн"] = '20250117';

П2.Надіслати("Іваненко", "Тиждень 2 — виконуємо відвантаження та оплати");
П2.Погодити("Коваленко (Директор)", "Затверджено");
П2.Провести();
АЖ.Записати("Коваленко", "Затвердити", "ТижневийПлан", П2.Номер, "Тиждень 2 затверджено");

Вик2 = Відповідність();
Вик2["Відвантаження товару ТОВ «Альфа»"]     = Істина;
Вик2["Оплата постачальнику МатПлюс"]          = Істина;
Вик2["Прийом нового менеджера з продажів"]    = Істина;
Вик2["Рекламна кампанія в соціальних мережах"] = Хибність;  // не виконано
Вик2["Інвентаризація складу"]                  = Істина;
АЖ.Записати("Маркетолог", "Відкласти", "Завдання", "Рекламна кампанія", "Перенесено на тиждень 3");

// ────────────────────────────────────────────────────────────────────
// ТИЖДЕНЬ 3 (20-24 Cічня) — 60% виконання
// ────────────────────────────────────────────────────────────────────
П3 = ДокументЗМаршрутом("ТижневийПлан");
П3.Тиждень = 3; П3.Менеджер = "Іваненко О.М.";
П3.ПочПеріоду = '20250120'; П3.КінПеріоду = '20250124';

Зав3 = П3.ТабличнаЧастина("Завдання",
    "Назва, Відповідальний, Дедлайн");
Р = Зав3.Додати(); Р["Назва"] = "Переговори з новим постачальником";  Р["Відповідальний"] = "Директор"; Р["Дедлайн"] = '20250120';
Р = Зав3.Додати(); Р["Назва"] = "Доставка замовлень клієнтам";        Р["Відповідальний"] = "Логіст";   Р["Дедлайн"] = '20250121';
Р = Зав3.Додати(); Р["Назва"] = "Нарахування заробітної плати";       Р["Відповідальний"] = "Коваль";   Р["Дедлайн"] = '20250122';
Р = Зав3.Додати(); Р["Назва"] = "Оновлення прайс-листа";              Р["Відповідальний"] = "Менеджер"; Р["Дедлайн"] = '20250123';
Р = Зав3.Додати(); Р["Назва"] = "Навчання персоналу (CRM-система)";   Р["Відповідальний"] = "HR";       Р["Дедлайн"] = '20250124';

П3.Надіслати("Іваненко", "Тиждень 3 — переговори та нарахування ЗП");
П3.Погодити("Коваленко (Директор)", "Затверджено, особлива увага — переговори");
П3.Провести();
АЖ.Записати("Коваленко", "Затвердити", "ТижневийПлан", П3.Номер, "Тиждень 3 затверджено");

Вик3 = Відповідність();
Вик3["Переговори з новим постачальником"] = Істина;
Вик3["Доставка замовлень клієнтам"]       = Істина;
Вик3["Нарахування заробітної плати"]      = Істина;
Вик3["Оновлення прайс-листа"]             = Хибність;  // не виконано
Вик3["Навчання персоналу (CRM-система)"]  = Хибність;  // перенесено
АЖ.Записати("HR", "Відкласти", "Завдання", "Навчання персоналу", "Перенесено на тиждень 4");

// ────────────────────────────────────────────────────────────────────
// ТИЖДЕНЬ 4 (27-31 Cічня) — 0% (план подано, ще не погоджено)
// ────────────────────────────────────────────────────────────────────
П4 = ДокументЗМаршрутом("ТижневийПлан");
П4.Тиждень = 4; П4.Менеджер = "Іваненко О.М.";
П4.ПочПеріоду = '20250127'; П4.КінПеріоду = '20250131';

Зав4 = П4.ТабличнаЧастина("Завдання",
    "Назва, Відповідальний, Дедлайн");
Р = Зав4.Додати(); Р["Назва"] = "Фінансовий звіт за cічень";         Р["Відповідальний"] = "Коваль";   Р["Дедлайн"] = '20250128';
Р = Зав4.Додати(); Р["Назва"] = "Бюджет на лютий";                   Р["Відповідальний"] = "Фінансист"; Р["Дедлайн"] = '20250129';
Р = Зав4.Додати(); Р["Назва"] = "Закупівля офісного обладнання";     Р["Відповідальний"] = "Адмін";    Р["Дедлайн"] = '20250130';
Р = Зав4.Додати(); Р["Назва"] = "Зустріч з ключовими партнерами";    Р["Відповідальний"] = "Директор"; Р["Дедлайн"] = '20250130';
Р = Зав4.Додати(); Р["Назва"] = "Підведення підсумків місяця";       Р["Відповідальний"] = "Всі";      Р["Дедлайн"] = '20250131';

П4.Надіслати("Іваненко", "Фінальний тиждень cічня — звіти та бюджет");
// Директор ще не погодив — план на погодженні
АЖ.Записати("Іваненко", "Надіслати", "ТижневийПлан", П4.Номер, "Очікує погодження директором");

Вик4 = Відповідність();  // порожній — нічого ще не виконано

// ════════════════════════════════════════════════════════════════════
// ВИВЕДЕННЯ ДЕТАЛЬНИХ ПЛАНІВ
// ════════════════════════════════════════════════════════════════════
Повідомити("");
Зроблено1 = ВивестиТиждень(П1, Вик1, "Тиждень 1  (06.01–10.01)");
Повідомити("");
Зроблено2 = ВивестиТиждень(П2, Вик2, "Тиждень 2  (13.01–17.01)");
Повідомити("");
Зроблено3 = ВивестиТиждень(П3, Вик3, "Тиждень 3  (20.01–24.01)");
Повідомити("");
Зроблено4 = ВивестиТиждень(П4, Вик4, "Тиждень 4  (27.01–31.01)");

// ════════════════════════════════════════════════════════════════════
// ЗВЕДЕНИЙ ЗВІТ «ПЛАН vs ФАКТ»
// ════════════════════════════════════════════════════════════════════
Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  ЗВЕДЕНИЙ ЗВІТ «ПЛАН vs ФАКТ»  ·  Підприємство «Альфа»  ·  Cічень 2025");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити(ШаблонРядка("%-12s│%10s│%10s│%6s│%s", "Тиждень", "Заплановано", "Виконано", "%", "Статус"));
Повідомити(СтрПовтор("─", 56));

ВсьогоПлан  = 0;
ВсьогоФакт  = 0;
Дані = Масив();

Для Ном = 1 По 4 Цикл
    Якщо Ном = 1 Тоді Пл = П1; Зр = Зроблено1; Пер = "06.01–10.01"; КінецьЯкщо;
    Якщо Ном = 2 Тоді Пл = П2; Зр = Зроблено2; Пер = "13.01–17.01"; КінецьЯкщо;
    Якщо Ном = 3 Тоді Пл = П3; Зр = Зроблено3; Пер = "20.01–24.01"; КінецьЯкщо;
    Якщо Ном = 4 Тоді Пл = П4; Зр = Зроблено4; Пер = "27.01–31.01"; КінецьЯкщо;

    Всього = Пл.ТабличнаЧастина("Завдання").Кількість();
    Відс   = Зр * 100 / Всього;
    Стат   = Пл.МетаСтатус("uk");
    Рядок1 = ШаблонРядка("Т%1 (%2)", Ном, Пер);
    Повідомити(ШаблонРядка("%-12s│%11s│%10s│%5s%%│ %s",
        Рядок1, Всього, Зр, Окр(Відс, 0), Стат));
    ВсьогоПлан  = ВсьогоПлан  + Всього;
    ВсьогоФакт  = ВсьогоФакт  + Зр;
КінецьЦиклу;

Повідомити(СтрПовтор("─", 56));
ЗагВідс = ВсьогоФакт * 100 / ВсьогоПлан;
Повідомити(ШаблонРядка("%-12s│%11s│%10s│%5s%%│", "РАЗОМ", ВсьогоПлан, ВсьогоФакт, Окр(ЗагВідс, 0)));

// ────────────────────────────────────────────────────────────────────
// ЖУРНАЛ АУДИТУ
// ────────────────────────────────────────────────────────────────────
Повідомити("");
Повідомити("── Журнал аудиту: " + Рядок(АЖ.Кількість()) + " записів ─────────────────────────────");
АЖ.Вивести(8);

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP — Планування 4 тижні + Workflow (українська) — завершено");
Повідомити("══════════════════════════════════════════════════════════════════");
