// ═══════════════════════════════════════════════════════════════════════════
// 1S: ERP Free Edition — Привіт, світе! (чиста українська)
// Демонструє: змінні, умови, цикли, функції, масиви, обробку помилок.
// ═══════════════════════════════════════════════════════════════════════════

// ─── Змінні ──────────────────────────────────────────────────────────────────

Змін Привітання;
Привітання = "Привіт, світе!";
Повідомити(Привітання);

// ─── Функція та процедура ────────────────────────────────────────────────────

Функція Квадрат(Знач Н)
    Повернути Н * Н;
КінецьФункції

Функція Факторіал(Знач Н)
    Якщо Н <= 1 Тоді
        Повернути 1;
    КінецьЯкщо;
    Повернути Н * Факторіал(Н - 1);
КінецьФункції

Процедура ВивестиРезультат(Знач Назва, Знач Значення)
    Повідомити(Назва + " = " + Рядок(Значення));
КінецьПроцедури

// ─── Числові операції ────────────────────────────────────────────────────────

Повідомити("");
Повідомити("── Числові обчислення ──────────────────────────────────────────");
Для Н = 1 До 6 Цикл
    ВивестиРезультат(Рядок(Н) + "²", Квадрат(Н));
КінецьЦиклу;

Повідомити("");
Повідомити("── Факторіали ──────────────────────────────────────────────────");
Для Н = 1 До 8 Цикл
    ВивестиРезультат(Рядок(Н) + "!", Факторіал(Н));
КінецьЦиклу;

// ─── Умовні оператори ────────────────────────────────────────────────────────

Повідомити("");
Повідомити("── Визначення категорії віку ───────────────────────────────────");
Змін Вік;
Вік = 25;
Змін Категорія;
Якщо Вік < 18 Тоді
    Категорія = "Неповнолітній";
ІнакшеЯкщо Вік < 35 Тоді
    Категорія = "Молодь";
ІнакшеЯкщо Вік < 60 Тоді
    Категорія = "Дорослий";
Інакше
    Категорія = "Пенсіонер";
КінецьЯкщо;
Повідомити(ШаблонРядка("  Вік %1 → %2", Вік, Категорія));

// Тернарний оператор (розширення 1S)
Змін Статус;
Статус = Вік >= 18 ? "Повнолітній" : "Неповнолітній";
Повідомити(ШаблонРядка("  Правовий статус: %1", Статус));

// ─── Масив ───────────────────────────────────────────────────────────────────

Повідомити("");
Повідомити("── Масив: міста України ────────────────────────────────────────");
Змін Міста;
Міста = Новий Масив;
Міста.Додати("Київ");
Міста.Додати("Харків");
Міста.Додати("Одеса");
Міста.Додати("Дніпро");
Міста.Додати("Запоріжжя");
Міста.Додати("Львів");

Повідомити(ШаблонРядка("  Усього міст: %1", Міста.Кількість()));
Для Кожного Місто З Міста Цикл
    Повідомити(ШаблонРядка("  • %1", Місто));
КінецьЦиклу;

// ─── Структура ───────────────────────────────────────────────────────────────

Повідомити("");
Повідомити("── Структура: персона ──────────────────────────────────────────");
Змін Особа;
Особа = Новий Структура("ПІБ, Вік, Місто, Посада",
    "Шевченко Олексій Іванович", 32, "Київ", "Інженер-програміст");
Повідомити(ШаблонРядка("  ПІБ:    %1", Особа.ПІБ));
Повідомити(ШаблонРядка("  Вік:    %1 р.", Особа.Вік));
Повідомити(ШаблонРядка("  Місто:  %1", Особа.Місто));
Повідомити(ШаблонРядка("  Посада: %1", Особа.Посада));

// ─── Відповідність (словник) ─────────────────────────────────────────────────

Повідомити("");
Повідомити("── Відповідність: курси валют ──────────────────────────────────");
Змін Курси;
Курси = Новий Відповідність;
Курси["USD"] = 41.50;
Курси["EUR"] = 44.80;
Курси["GBP"] = 52.30;
Курси["PLN"] =  9.85;

Змін Суму;
Суму = 1000;  // USD
Для Кожного Пара З Курси Цикл
    Повідомити(ШаблонРядка("  %1: %2 грн/од  (1000 %1 = %3 грн)",
        Пара.Ключ,
        Формат(Пара.Значення, "ЧДЦ=2"),
        Формат(Суму * Пара.Значення, "ЧДЦ=2")));
КінецьЦиклу;

// ─── Обробка помилок ─────────────────────────────────────────────────────────

Повідомити("");
Повідомити("── Обробка помилок ─────────────────────────────────────────────");
Спроба
    ВикинутиВиняток "Тестовий виняток: ділення на нуль";
Виняток
    Повідомити("  ✓ Виняток перехоплено успішно");
КінецьСпроби;

// Цикл Поки
Повідомити("");
Повідомити("── Цикл Поки: числа Фібоначчі ─────────────────────────────────");
Змін А, Б, Лічильник;
А = 0; Б = 1; Лічильник = 0;
Поки А < 200 Цикл
    Повідомити(ШаблонРядка("  F(%1) = %2", Лічильник, А));
    Змін Т;
    Т = А + Б;
    А = Б;
    Б = Т;
    Лічильник = Лічильник + 1;
КінецьЦиклу;

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP Free Edition — демонстрацію завершено (українська мова)");
Повідомити("══════════════════════════════════════════════════════════════════");
