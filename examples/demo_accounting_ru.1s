// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — ДЕМО: Бухгалтерский учёт — полный месячный цикл
// ООО «Альфа» · Январь 2025 · Русский язык
// ══════════════════════════════════════════════════════════════════════

Функция Ч(Зн, Ш)
    Если Зн = 0 Тогда  Возврат СтрШаблон("%" + Строка(Ш) + "s","");  КонецЕсли;
    Возврат Формат(Зн,"ЧЦ=" + Строка(Ш));
КонецФункции;

ПланСч = ПланСчетов("Общий");
ПланСч.ДобавитьСчёт("01","Основные средства");     ПланСч.ДобавитьСчёт("10","Материалы");
ПланСч.ДобавитьСчёт("41","Товары");                ПланСч.ДобавитьСчёт("51","Расчётный счёт");
ПланСч.ДобавитьСчёт("62","Расчёты с покупателями"); ПланСч.ДобавитьСчёт("80","Уставный капитал");
ПланСч.ДобавитьСчёт("60","Расчёты с поставщиками"); ПланСч.ДобавитьСчёт("68","НДС");
ПланСч.ДобавитьСчёт("70","Расчёты с персоналом");  ПланСч.ДобавитьСчёт("90","Продажи");
ПланСч.ДобавитьСчёт("44","Расходы на продажу");    ПланСч.ДобавитьСчёт("26","Общехозяйственные");

РегБух = РегистрБухгалтерии("ГлавнаяКнига", ПланСч);

// Входящее сальдо
НаД = '20241231';
РегБух.Провести(НаД,"ВхС","Вх.сальдо: ОС",     "01","80",450000);
РегБух.Провести(НаД,"ВхС","Вх.сальдо: Товары",  "41","60", 85000);
РегБух.Провести(НаД,"ВхС","Вх.сальдо: Банк",    "51","80",125000);
РегБух.Провести(НаД,"ВхС","Вх.сальдо: Дебиторы","62","90", 40000);

Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("  БУХГАЛТЕРСКИЙ УЧЁТ  ·  ООО «Альфа»  ·  Январь 2025 г.");
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("");
Сообщить("── 1. Хозяйственные операции январь 2025 г. ─────────────────────");

РегБух.Провести('20250105',"ПН001","Приход товаров от поставщика",     "41","60",120000);
РегБух.Провести('20250105',"ПН001","НДС входящий 20%%",                "68","60", 24000);
Сообщить("  05.01  ПН001  Приход товаров от поставщика         120 000 руб.");

РегБух.Провести('20250115',"РН001","Выручка от реализации",            "62","90",180000);
РегБух.Провести('20250115',"РН001","НДС исходящий 20%%",               "90","68", 36000);
РегБух.Провести('20250115',"РН001","Списание себестоимости",           "90","41", 95000);
Сообщить("  15.01  РН001  Реализация товаров ООО «Клиент»      180 000 руб.");

РегБух.Провести('20250125',"ВН001","Начисление зарплаты",              "26","70", 55000);
РегБух.Провести('20250125',"ВН001","Страховые взносы 30%%",            "26","60", 16500);
Сообщить("  25.01  ВН001  Начисление зарплаты + страх. взносы  71 500 руб.");

РегБух.Провести('20250128',"БВ001","Выплата зарплаты",                 "70","51", 47850);
РегБух.Провести('20250128',"БВ002","Оплата поставщику",                "60","51",144000);
РегБух.Провести('20250128',"БВ003","Поступление от покупателя",        "51","62",180000);
Сообщить("  28.01  Банк   Выплата ЗП + оплата + поступление");
Сообщить("");

// ── ОСВ ───────────────────────────────────────────────────────────────
Сообщить("── 2. Оборотно-сальдовая ведомость (ОСВ) ───────────────────────");
НачД = '20250101'; КонД = '20250131';

Сообщить(СтрШаблон("  %-4s %-18s %9s %9s %9s %9s %9s %9s",
    "Сч.", "Наименование", "Нач.Дт", "Нач.Кт", "Об.Дт", "Об.Кт", "Кон.Дт", "Кон.Кт"));
Сообщить(СтрПовтор("─", 80));
ТПД=0; ТПК=0; ТОД=0; ТОК=0; ТКД=0; ТКК=0;
Для Каждого Сч Из ПланСч Цикл
    БП = РегБух.Остаток(Сч, '20241231'); Об = РегБух.Оборот(Сч, НачД, КонД);
    НД = БП["Дт"]; НК = БП["Кт"]; ОД = Об["ОборотДт"]; ОК = Об["ОборотКт"];
    Если НД + НК + ОД + ОК = 0 Тогда  Продолжить;  КонецЕсли;
    Нт = НД - НК + ОД - ОК;
    Если Нт >= 0 Тогда  КД = Нт; КК = 0;  Иначе  КД = 0; КК = -Нт;  КонецЕсли;
    Сообщить(СтрШаблон("  %-4s %-18s %9s %9s %9s %9s %9s %9s",
        Сч.Код, Сч.Наименование, Ч(НД,9),Ч(НК,9),Ч(ОД,9),Ч(ОК,9),Ч(КД,9),Ч(КК,9)));
    ТПД=ТПД+НД; ТПК=ТПК+НК; ТОД=ТОД+ОД; ТОК=ТОК+ОК; ТКД=ТКД+КД; ТКК=ТКК+КК;
КонецЦикла;
Сообщить(СтрПовтор("─", 80));
Сообщить(СтрШаблон("  %-23s %9s %9s %9s %9s %9s %9s",
    "ИТОГО:", Ч(ТПД,9),Ч(ТПК,9),Ч(ТОД,9),Ч(ТОК,9),Ч(ТКД,9),Ч(ТКК,9)));
Сообщить(СтрШаблон("  Проверка: ОД=%1 = ОК=%2 OK  |  КД=%3 = КК=%4 OK", ТОД,ТОК,ТКД,ТКК));

// ── P&L ───────────────────────────────────────────────────────────────
Сообщить("");
Сообщить("── 3. Отчёт о финансовых результатах (P&L) ──────────────────────");
О90 = РегБух.Оборот(ПланСч.НайтиПоКоду("90"), НачД, КонД);
О26 = РегБух.Оборот(ПланСч.НайтиПоКоду("26"), НачД, КонД);
Выр   = О90["ОборотКт"] - О90["ОборотДт"];
Себ   = Выр - (О90["ОборотКт"] - О26["ОборотДт"] - О90["ОборотДт"]);
// Упрощённо: Выручка нетто = Обороты по Кт90 - НДС - Себест
Выр2  = 180000 - 36000;   // нетто
Себ2  = 95000;
ВалП  = Выр2 - Себ2;
АдмР  = О26["ОборотДт"];
ОпП   = ВалП - АдмР;
Рент  = Окр(ОпП / Выр2 * 100, 1);
Сообщить(СтрШаблон("  Выручка (нетто):               %1 руб.", Формат(Выр2,"ЧДЦ=2")));
Сообщить(СтрШаблон("  Себестоимость:                (%1 руб.)", Формат(Себ2,"ЧДЦ=2")));
Сообщить(СтрПовтор("─", 48));
Сообщить(СтрШаблон("  ВАЛОВАЯ ПРИБЫЛЬ:               %1 руб.", Формат(ВалП,"ЧДЦ=2")));
Сообщить(СтрШаблон("  Общехозяйственные расходы:   (%1 руб.)", Формат(АдмР,"ЧДЦ=2")));
Сообщить(СтрПовтор("─", 48));
Сообщить(СтрШаблон("  ОПЕРАЦИОННАЯ ПРИБЫЛЬ:          %1 руб.", Формат(ОпП,"ЧДЦ=2")));
Сообщить(СтрШаблон("  Рентабельность:                %1%%", Рент));
Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("  1S: ERP — Бухгалтерский учёт (русский) — завершено");
Сообщить("══════════════════════════════════════════════════════════════════════");
