// =============================================================================
// ДЕМО: Сохранение/загрузка ERP объектов Sprint 11 (Русский)
// Цикл: OrgChart → BudgetControl → PayrollEngine → WorkflowConfig → сохранение → загрузка
// =============================================================================

Сообщить("=== 1S ERP Sprint 11 — Персистентность (Русский) ===");
Сообщить("");

// ── 1. СОЗДАНИЕ ОРГАНИЗАЦИОННОЙ СТРУКТУРЫ ────────────────────────────────────
Сообщить("── 1. Организационная структура ──");
Орг = ОрганизационнаяСтруктура("ЗАО Промышленный Холдинг");
Орг.ДобавитьУзел("юр1",  "ООО МеталлПром",         "legal_entity", "root");
Орг.ДобавитьУзел("цех1", "Цех №1 (Литейный)",       "plant",         "юр1");
Орг.ДобавитьУзел("отд1", "Отдел снабжения",          "department",    "юр1");
Орг.ДобавитьУзел("мвз1", "МВЗ: Литейный",            "cost_center",   "цех1");
Орг.ДобавитьУзел("мвз2", "МВЗ: Инструментальный",    "cost_center",   "цех1");
Сообщить(Орг.Отчет());

// ── 2. БЮДЖЕТ ────────────────────────────────────────────────────────────────
Сообщить("── 2. Создание бюджета ──");
Бюджет = КонтрольБюджета(Истина, 0.85);
Бюджет.Выделить("мвз1", "2024-01", "материалы", 800000);
Бюджет.Выделить("мвз1", "2024-01", "услуги",    200000);
Бюджет.Выделить("мвз2", "2024-01", "материалы", 450000);
Бюджет.Зарезервировать("мвз1", "2024-01", 250000, "ЗЗ-2024-0101", "материалы");
Бюджет.Зарезервировать("мвз2", "2024-01", 120000, "ЗЗ-2024-0102", "материалы");
Сообщить("Бюджет создан: 3 выделения, 2 резервирования");

// ── 3. ЗАРПЛАТА ───────────────────────────────────────────────────────────────
Сообщить("── 3. Расчёт зарплаты ──");
НалДв = НалоговыйДвижок();
РЗП   = РасчетЗарплаты(НалДв);

Сотр1 = Сотрудник("С001", "Иванов Алексей Петрович",    "Начальник цеха",    75000, "ru_2024");
Сотр2 = Сотрудник("С002", "Петрова Мария Сергеевна",    "Технолог",          52000, "ru_2024");
Сотр3 = Сотрудник("С003", "Сидоров Николай Иванович",   "Токарь 5р",         38000, "ru_2024");
РЗП.ДобавитьСотрудника(Сотр1);
РЗП.ДобавитьСотрудника(Сотр2);
РЗП.ДобавитьСотрудника(Сотр3);

// Петрова - 3 дня больничный
РЗП.ДобавитьОтсутствие("С002", "sick", 3, "2024-01");
// Иванов - квартальная премия 15%
Прем = Премия("Квартальная премия", "percent", 0.15);
РЗП.ДобавитьПремию("С001", Прем);

РезЗП = РЗП.Рассчитать("2024-01");
Сообщить(РЗП.ВедомостьЗарплаты(РезЗП, "ru"));

// ── 4. МАРШРУТ СОГЛАСОВАНИЯ ──────────────────────────────────────────────────
Сообщить("── 4. Маршрут согласования ──");
Маршрут = НастройкиМаршрута.load("profiles/workflow/default.yaml");
Сообщить("Маршрут загружен: " + Строка(Маршрут.ПолучитьУтверждающих("purchase_order", 50000)));

// ── 5. СОХРАНЕНИЕ В БАЗУ ДАННЫХ ───────────────────────────────────────────────
Сообщить("── 5. Сохранение в SQLite ──");
БД = "data/erp_demo_ru.db";

Cnt1 = СохранитьОргСтруктуру(Орг, БД);
Сообщить("OrgChart сохранён: " + Строка(Cnt1) + " узлов");

Cnt2 = СохранитьБюджет(Бюджет, БД);
Сообщить("BudgetControl сохранён: " + Строка(Cnt2) + " записей");

Cnt3 = СохранитьРасчетыЗП(РезЗП, БД);
Сообщить("PayrollResults сохранено: " + Строка(Cnt3) + " сотрудников");

Cnt4 = СохранитьМаршрут(Маршрут, БД);
Сообщить("WorkflowConfig сохранён: " + Строка(Cnt4) + " типов документов");
Сообщить("");

// ── 6. ЗАГРУЗКА ИЗ БАЗЫ ДАННЫХ ───────────────────────────────────────────────
Сообщить("── 6. Загрузка из SQLite ──");

Орг2 = ЗагрузитьОргСтруктуру(БД, "ЗАО Промышленный Холдинг");
Сообщить("OrgChart загружен: " + Строка(Орг2.НайтиУзел("мвз1").name) + " (МВЗ1)");

Бюджет2 = ЗагрузитьБюджет(БД);
Баланс  = Бюджет2.Баланс("мвз1", "2024-01", "материалы");
Сообщить("Бюджет МВЗ1/материалы: выделено=" + Строка(Баланс.allocated) +
         ", резерв=" + Строка(Баланс.committed) +
         ", доступно=" + Строка(Баланс.available));

ЗагрЗП = ЗагрузитьРасчетыЗП(БД, "2024-01");
Сообщить("Загружено расчётов зарплаты за 2024-01:");
Для Каждого Рез Из ЗагрЗП Цикл
    Сообщить("  " + Рез["emp_name"] + " → к выплате: " + Строка(Окр(Рез["net"], 2)));
КонецЦикла;
Сообщить("");

// ── 7. ERP ЗАПРОСЫ ────────────────────────────────────────────────────────────
Сообщить("── 7. Аналитические запросы ──");
Запрос = ЗапросERPe(БД);

// Исполнение бюджета
РядыБюджет = Запрос.ИсполнениеБюджета(Неопределено, "2024-01");
Сообщить(Запрос.ФорматОтчета("budget_utilization", РядыБюджет, "ru"));
Сообщить("");

// История расчётов зарплаты
РядыЗП = Запрос.ИсторияЗарплат(Неопределено, "2024-01");
Сообщить(Запрос.ФорматОтчета("payroll_history", РядыЗП, "ru"));
Сообщить("");

// Сводный отчёт
Свод = Запрос.СводныйОтчет("2024-01");
Сообщить("=== СВОДНЫЙ ОТЧЁТ 2024-01 ===");
Сообщить("Бюджет выделен : " + Строка(Окр(Свод["budget_allocated"], 2)));
Сообщить("Бюджет потреблен: " + Строка(Окр(Свод["budget_consumed"], 2)));
Сообщить("Исполнение %   : " + Строка(Свод["budget_utilization_pct"]) + "%");
Сообщить("Фонд зарплаты  : " + Строка(Окр(Свод["payroll_gross"], 2)));
Сообщить("К выплате      : " + Строка(Окр(Свод["payroll_net"], 2)));
Сообщить("Сотрудников    : " + Строка(Свод["employee_count"]));
Сообщить("");

// ── ФИНАЛЬНЫЙ ИТОГ ────────────────────────────────────────────────────────────
Сообщить("=== SPRINT 11 ЗАВЕРШЁН ===");
Сообщить("✓ OrgChart → SQLite → загружен");
Сообщить("✓ BudgetControl → SQLite → загружен, баланс восстановлен");
Сообщить("✓ PayrollResults → SQLite → загружены (3 сотрудника)");
Сообщить("✓ WorkflowConfig → SQLite → загружен");
Сообщить("✓ ERP-запросы: исполнение бюджета + история зарплат + сводный отчёт");
