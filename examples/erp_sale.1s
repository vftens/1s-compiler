// ════════════════════════════════════════════════════════════════════════════
// 1S: ERP Free Edition — Реализация товаров
// Демонстрирует:
//   • Справочники (товары, контрагенты, склады)
//   • Документ с табличной частью
//   • Проведение: бухрегистр (62/90/41) + регистр накопления (остатки)
//   • Запросы: проверка остатков ДО проведения, отчёт ПОСЛЕ
//   • Расчёт НДС, себестоимости
//   • Обработка ошибок и валидация
// ════════════════════════════════════════════════════════════════════════════

// ── 1. Вспомогательные функции ───────────────────────────────────────────

Функция ОкруглитьСумму(Знач Сумма, Знач Знаков = 2)
    Возврат Окр(Сумма, Знаков);
КонецФункции

Функция РассчитатьНДС(Знач Сумма, Знач СтавкаПроцент = 20)
    Возврат ОкруглитьСумму(Сумма * СтавкаПроцент / (100 + СтавкаПроцент));
КонецФункции

Функция СуммаБезНДС(Знач СуммаСНДС, Знач СтавкаПроцент = 20)
    Возврат ОкруглитьСумму(СуммаСНДС / (1 + СтавкаПроцент / 100));
КонецФункции

// ── 2. Настройка плана счетов ─────────────────────────────────────────────

Перем ПланСч;
ПланСч = Новый ПланСчетов("Основной");

// Активные
ПланСч.ДобавитьСчёт("41",   "Товары",                     "",   Истина, Ложь);
ПланСч.ДобавитьСчёт("62",   "Расчёты с покупателями",     "",   Истина, Ложь);
ПланСч.ДобавитьСчёт("51",   "Расчётный счёт",             "",   Истина, Ложь);
ПланСч.ДобавитьСчёт("19",   "НДС по приобретённым ценн.", "",   Истина, Ложь);
// Пассивные
ПланСч.ДобавитьСчёт("68.2", "НДС к уплате",               "",   Ложь, Истина);
ПланСч.ДобавитьСчёт("60",   "Расчёты с поставщиками",     "",   Истина, Истина);
// Доходы / расходы
ПланСч.ДобавитьСчёт("90",   "Продажи",                    "",   Ложь, Ложь);
ПланСч.ДобавитьСчёт("90.1", "Выручка",                    "90", Ложь, Истина);
ПланСч.ДобавитьСчёт("90.2", "Себестоимость продаж",       "90", Истина, Ложь);
ПланСч.ДобавитьСчёт("90.3", "НДС с продаж",               "90", Истина, Ложь);
ПланСч.ДобавитьСчёт("99",   "Прибыли и убытки",           "",   Истина, Истина);

// ── 3. Регистры ───────────────────────────────────────────────────────────

Перем БухРегистр;
БухРегистр = Новый РегистрБухгалтерии("Основной", ПланСч);

Перем РегОстатки;
РегОстатки = Новый РегистрНакопления("ОстаткиТоваров", "Balance");

// ── 4. Справочник: Товары ─────────────────────────────────────────────────

Функция СоздатьТовар(Знач Код, Знач Наим, Знач ЕдИзм, Знач СебестСНДС, Знач ЦенаСНДС)
    Перем Т;
    Т = Новый Структура("Код,Наименование,ЕдИзм,СебестоимостьСНДС,ЦенаСНДС");
    Т.Код                = Код;
    Т.Наименование       = Наим;
    Т.ЕдИзм              = ЕдИзм;
    Т.СебестоимостьСНДС  = СебестСНДС;
    Т.ЦенаСНДС           = ЦенаСНДС;
    Возврат Т;
КонецФункции

Перем СпрТовары;
СпрТовары = Новый Соответствие();
СпрТовары.Вставить("ТВ001", СоздатьТовар("ТВ001", "Мука пшеничная в/с, 1 кг", "кг",   48, 80));
СпрТовары.Вставить("ТВ002", СоздатьТовар("ТВ002", "Сахар-песок, 1 кг",          "кг",   36, 60));
СпрТовары.Вставить("ТВ003", СоздатьТовар("ТВ003", "Масло подсолнечное, 1 л",    "л",    96, 150));
СпрТовары.Вставить("ТВ004", СоздатьТовар("ТВ004", "Молоко 3.2%, 1 л",           "л",    60, 95));

// ── 5. Справочник: Контрагенты ────────────────────────────────────────────

Функция СоздатьКонтрагента(Знач Код, Знач Наим, Знач ИНН)
    Перем К;
    К = Новый Структура("Код,Наименование,ИНН");
    К.Код           = Код;
    К.Наименование  = Наим;
    К.ИНН           = ИНН;
    Возврат К;
КонецФункции

Перем СпрКонтрагенты;
СпрКонтрагенты = Новый Соответствие();
СпрКонтрагенты.Вставить("КА001", СоздатьКонтрагента("КА001", "ООО «Продукты Плюс»",   "7701234567"));
СпрКонтрагенты.Вставить("КА002", СоздатьКонтрагента("КА002", "ИП Сидоров А.В.",        "501234567890"));

// ── 6. Начальные остатки (ввод остатков на складе) ───────────────────────

Процедура ВвестиНачОстаток(Знач КодТовара, Знач Кол, Знач Себест)
    Перем Товар;
    Товар = СпрТовары.Получить(КодТовара);
    Если Товар = Неопределено Тогда
        ВызватьИсключение "Товар не найден: " + КодТовара;
    КонецЕсли;

    // Бухгалтерский учёт: Дт 41 Кт 00 (условный счёт ввода остатков)
    // Для упрощения напрямую кредитуем 60
    БухРегистр.Провести(
        ТекущаяДата(), "НачОстатки",
        ПланСч.НайтиПоКоду("41"),
        ПланСч.НайтиПоКоду("60"),
        Кол * Себест
    );

    // Регистр накопления
    РегОстатки.Записать(
        ТекущаяДата(), "НачОстатки",
        Истина,                    // приход
        Кол,                       // ресурс1 = количество
        КодТовара,                 // измерение1 = код товара
        "Основной",                // измерение2 = склад
        Кол * Себест               // ресурс2 = сумма
    );
КонецПроцедуры

ВвестиНачОстаток("ТВ001", 500, 40);   // 500 кг муки по 40 р себест.
ВвестиНачОстаток("ТВ002", 300, 30);   // 300 кг сахара по 30 р
ВвестиНачОстаток("ТВ003", 200, 80);   // 200 л масла по 80 р
ВвестиНачОстаток("ТВ004", 150, 50);   // 150 л молока по 50 р

// ── 7. Документ: Реализация товаров ──────────────────────────────────────

Функция СоздатьДокРеализация(Знач НомерДок, Знач КодКонтрагента)
    Перем Д;
    Д = Новый Структура(
        "Номер,Дата,Контрагент,СуммаДокумента,СуммаНДС,Строки,Проведён"
    );
    Д.Номер        = НомерДок;
    Д.Дата         = ТекущаяДата();
    Д.Контрагент   = СпрКонтрагенты.Получить(КодКонтрагента);
    Д.СуммаДокумента = 0;
    Д.СуммаНДС     = 0;
    Д.Строки       = Новый ТаблицаЗначений();
    Д.Строки.Колонки.Добавить("НомерСтроки");
    Д.Строки.Колонки.Добавить("КодТовара");
    Д.Строки.Колонки.Добавить("Наименование");
    Д.Строки.Колонки.Добавить("Количество");
    Д.Строки.Колонки.Добавить("ЦенаСНДС");
    Д.Строки.Колонки.Добавить("СуммаСНДС");
    Д.Строки.Колонки.Добавить("НДС");
    Д.Строки.Колонки.Добавить("СуммаБезНДС");
    Д.Строки.Колонки.Добавить("Себестоимость");
    Д.Проведён     = Ложь;
    Возврат Д;
КонецФункции

Процедура ДобавитьСтроку(Знач Документ, Знач КодТовара, Знач Количество)
    Перем Товар;
    Товар = СпрТовары.Получить(КодТовара);
    Если Товар = Неопределено Тогда
        ВызватьИсключение "Товар не найден: " + КодТовара;
    КонецЕсли;

    Перем Стр;
    Стр = Документ.Строки.Добавить();
    Стр.НомерСтроки  = Документ.Строки.Количество();
    Стр.КодТовара    = КодТовара;
    Стр.Наименование = Товар.Наименование;
    Стр.Количество   = Количество;
    Стр.ЦенаСНДС     = Товар.ЦенаСНДС;
    Стр.СуммаСНДС    = ОкруглитьСумму(Количество * Товар.ЦенаСНДС);
    Стр.НДС          = РассчитатьНДС(Стр.СуммаСНДС);
    Стр.СуммаБезНДС  = Стр.СуммаСНДС - Стр.НДС;
    Стр.Себестоимость = ОкруглитьСумму(
        Количество * СуммаБезНДС(Товар.СебестоимостьСНДС)
    );

    Документ.СуммаДокумента = Документ.СуммаДокумента + Стр.СуммаСНДС;
    Документ.СуммаНДС       = Документ.СуммаНДС       + Стр.НДС;
КонецПроцедуры

// ── 8. Валидация перед проведением ───────────────────────────────────────

Функция ПроверитьОстатки(Знач Документ) Экспорт
    Перем Ошибки;
    Ошибки = Новый Массив();

    Для Каждого Стр Из Документ.Строки Цикл
        Перем Остаток;
        Остаток = РегОстатки.Остаток(Неопределено, Стр.КодТовара, "Основной");
        Перем КолОстаток;
        КолОстаток = Остаток["Resource1"];

        Если КолОстаток < Стр.Количество Тогда
            Ошибки.Добавить(
                "Недостаточно остатков: " + Стр.Наименование
                + " | Нужно: " + Строка(Стр.Количество)
                + " | Есть: " + Строка(КолОстаток)
            );
        КонецЕсли;
    КонецЦикла;

    Возврат Ошибки;
КонецФункции

// ── 9. Проведение документа ───────────────────────────────────────────────

Процедура ПровестиДокумент(Знач Документ) Экспорт
    Если Документ.Проведён Тогда
        ВызватьИсключение "Документ " + Документ.Номер + " уже проведён";
    КонецЕсли;

    Если Документ.Строки.Количество() = 0 Тогда
        ВызватьИсключение "Нет строк в документе " + Документ.Номер;
    КонецЕсли;

    // Проверить остатки
    Перем Ошибки;
    Ошибки = ПроверитьОстатки(Документ);
    Если Ошибки.Количество() > 0 Тогда
        Перем ТекстОшибки;
        ТекстОшибки = "Ошибки при проведении " + Документ.Номер + ":" + Символ(10);
        Для Каждого Ош Из Ошибки Цикл
            ТекстОшибки = ТекстОшибки + "  • " + Ош + Символ(10);
        КонецЦикла;
        ВызватьИсключение ТекстОшибки;
    КонецЕсли;

    Перем Регистратор;
    Регистратор = "Реализация_" + Документ.Номер;

    // Итоговые суммы для бухгалтерии
    Перем ИтогоСНДС;
    Перем ИтогоНДС;
    Перем ИтогоБезНДС;
    Перем ИтогоСебест;
    ИтогоСНДС   = 0;
    ИтогоНДС    = 0;
    ИтогоБезНДС = 0;
    ИтогоСебест = 0;

    Для Каждого Стр Из Документ.Строки Цикл
        // ── Регистр накопления: расход товара ────────────────────────────
        РегОстатки.Записать(
            Документ.Дата, Регистратор,
            Ложь,                      // расход
            Стр.Количество,            // ресурс1 = кол-во
            Стр.КодТовара,             // измерение1
            "Основной",                // измерение2 = склад
            Стр.Себестоимость          // ресурс2 = сумма себест.
        );

        ИтогоСНДС   = ИтогоСНДС   + Стр.СуммаСНДС;
        ИтогоНДС    = ИтогоНДС    + Стр.НДС;
        ИтогоБезНДС = ИтогоБезНДС + Стр.СуммаБезНДС;
        ИтогоСебест = ИтогоСебест + Стр.Себестоимость;
    КонецЦикла;

    // ── Бухгалтерские проводки ────────────────────────────────────────────

    // Дт 62  Кт 90.1  — выручка с НДС
    БухРегистр.Провести(
        Документ.Дата, Регистратор,
        ПланСч.НайтиПоКоду("62"),
        ПланСч.НайтиПоКоду("90.1"),
        ИтогоСНДС
    );

    // Дт 90.3  Кт 68.2  — НДС с реализации
    БухРегистр.Провести(
        Документ.Дата, Регистратор,
        ПланСч.НайтиПоКоду("90.3"),
        ПланСч.НайтиПоКоду("68.2"),
        ИтогоНДС
    );

    // Дт 90.2  Кт 41  — списание себестоимости
    БухРегистр.Провести(
        Документ.Дата, Регистратор,
        ПланСч.НайтиПоКоду("90.2"),
        ПланСч.НайтиПоКоду("41"),
        ИтогоСебест
    );

    Документ.Проведён = Истина;

    Сообщить("✓ Проведён: " + Документ.Номер
        + " | Выручка: " + Строка(ИтогоСНДС)
        + " | НДС: " + Строка(ИтогоНДС)
        + " | Себест.: " + Строка(ИтогоСебест)
        + " | Прибыль: " + Строка(ИтогоБезНДС - ИтогоСебест));
КонецПроцедуры

// ── 10. Создаём и проводим документы ─────────────────────────────────────

Перем Реал001;
Реал001 = СоздатьДокРеализация("РТ-000001", "КА001");
ДобавитьСтроку(Реал001, "ТВ001", 100);   // 100 кг муки
ДобавитьСтроку(Реал001, "ТВ002",  50);   //  50 кг сахара
ДобавитьСтроку(Реал001, "ТВ003",  30);   //  30 л масла

Перем Реал002;
Реал002 = СоздатьДокРеализация("РТ-000002", "КА002");
ДобавитьСтроку(Реал002, "ТВ004",  80);   //  80 л молока
ДобавитьСтроку(Реал002, "ТВ001",  60);   //  60 кг муки

// Попытка проведения с ошибкой (слишком много товара)
Перем РеалНеверный;
РеалНеверный = СоздатьДокРеализация("РТ-000099", "КА001");
ДобавитьСтроку(РеалНеверный, "ТВ002", 9999);   // заведомо больше остатка

Попытка
    ПровестиДокумент(РеалНеверный);
Исключение
    Сообщить("Ожидаемая ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Проводим корректные документы
ПровестиДокумент(Реал001);
ПровестиДокумент(Реал002);

// ── 11. Отчёт: Остатки товаров ────────────────────────────────────────────

Процедура ОтчётОстатки()
    Сообщить("");
    Сообщить("══════════════════════════════════════════════");
    Сообщить("  ОТЧЁТ: Остатки товаров на складе «Основной»");
    Сообщить("══════════════════════════════════════════════");
    Сообщить(СтрШаблон("  %-30s %6s %10s", "Наименование", "Кол-во", "Сумма"));
    Сообщить("  " + СтрПовтор("─", 50));

    Перем ИтогоКол;
    Перем ИтогоСумма;
    ИтогоКол   = 0;
    ИтогоСумма = 0;

    Для Каждого КЗ Из СпрТовары Цикл
        Перем Код;
        Перем Товар;
        Код    = КЗ.Ключ;
        Товар  = КЗ.Значение;
        Перем Ост;
        Ост = РегОстатки.Остаток(Неопределено, Код, "Основной");
        Перем Кол;
        Перем Сумм;
        Кол  = Ост["Resource1"];
        Сумм = Ост["Resource2"];
        ИтогоКол   = ИтогоКол   + Кол;
        ИтогоСумма = ИтогоСумма + Сумм;
        Сообщить(СтрШаблон("  %-30s %6s %10s",
            Товар.Наименование,
            Строка(Окр(Кол, 0)),
            Строка(Окр(Сумм, 2))));
    КонецЦикла;

    Сообщить("  " + СтрПовтор("─", 50));
    Сообщить(СтрШаблон("  %-30s %6s %10s",
        "ИТОГО:",
        Строка(Окр(ИтогоКол, 0)),
        Строка(Окр(ИтогоСумма, 2))));
КонецПроцедуры

// ── 12. Отчёт: Финансовый результат (ОФР) ────────────────────────────────

Процедура ОтчётПрибыли()
    Сообщить("");
    Сообщить("══════════════════════════════════════════════");
    Сообщить("  ОТЧЁТ: Финансовый результат (упрощённый)");
    Сообщить("══════════════════════════════════════════════");

    Перем Выручка901;
    Перем Себест902;
    Перем НДС903;
    Выручка901 = БухРегистр.Остаток("90.1");
    Себест902  = БухРегистр.Остаток("90.2");
    НДС903     = БухРегистр.Остаток("90.3");

    // 90.1 — пассивный: выручка = Кт оборот
    Перем ВыручкаКт;
    ВыручкаКт = Выручка901["Кт"];

    // 90.2 — активный: себест = Дт оборот
    Перем СебестДт;
    СебестДт  = Себест902["Дт"];

    // 90.3 — активный: НДС = Дт оборот
    Перем НДСДт;
    НДСДт = НДС903["Дт"];

    Перем ВыручкаБезНДС;
    Перем ВаловаяПрибыль;
    ВыручкаБезНДС  = ВыручкаКт - НДСДт;
    ВаловаяПрибыль = ВыручкаБезНДС - СебестДт;

    Сообщить("  Выручка (с НДС):        " + Строка(Окр(ВыручкаКт, 2)));
    Сообщить("  НДС к уплате:           " + Строка(Окр(НДСДт, 2)));
    Сообщить("  Выручка (без НДС):      " + Строка(Окр(ВыручкаБезНДС, 2)));
    Сообщить("  Себестоимость продаж:   " + Строка(Окр(СебестДт, 2)));
    Сообщить("  ──────────────────────────────────────────");
    Сообщить("  Валовая прибыль:        " + Строка(Окр(ВаловаяПрибыль, 2)));
    Сообщить("  Рентабельность:         "
        + Строка(Окр(ВаловаяПрибыль / ВыручкаБезНДС * 100, 1)) + "%");
КонецПроцедуры

// ── 13. Отчёт: Дебиторская задолженность (счёт 62) ───────────────────────

Процедура ОтчётДебиторка()
    Сообщить("");
    Сообщить("══════════════════════════════════════════════");
    Сообщить("  ОТЧЁТ: Дебиторская задолженность (сч. 62)");
    Сообщить("══════════════════════════════════════════════");

    Перем Ост62;
    Ост62 = БухРегистр.Остаток("62");
    Сообщить("  Дт 62: " + Строка(Окр(Ост62["Дт"], 2)));
    Сообщить("  Кт 62: " + Строка(Окр(Ост62["Кт"], 2)));
    Сообщить("  Остаток (дебет): " + Строка(Окр(Ост62["Остаток"], 2)));
КонецПроцедуры

// ── 14. Запрос: топ продаж через ТаблицаЗначений + Query ─────────────────

Процедура ОтчётТопПродаж()
    Сообщить("");
    Сообщить("══════════════════════════════════════════════");
    Сообщить("  ОТЧЁТ: Топ продаж по сумме");
    Сообщить("══════════════════════════════════════════════");

    // Собираем все строки документов в ТаблицаЗначений
    Перем ТаблПродажи;
    ТаблПродажи = Новый ТаблицаЗначений();
    ТаблПродажи.Колонки.Добавить("Документ");
    ТаблПродажи.Колонки.Добавить("Товар");
    ТаблПродажи.Колонки.Добавить("Количество");
    ТаблПродажи.Колонки.Добавить("Выручка");
    ТаблПродажи.Колонки.Добавить("Себестоимость");
    ТаблПродажи.Колонки.Добавить("Прибыль");

    Перем ВсеДокументы;
    ВсеДокументы = Новый Массив();
    ВсеДокументы.Добавить(Реал001);
    ВсеДокументы.Добавить(Реал002);

    Для Каждого Д Из ВсеДокументы Цикл
        Для Каждого Стр Из Д.Строки Цикл
            Перем НовСтр;
            НовСтр = ТаблПродажи.Добавить();
            НовСтр.Документ     = Д.Номер;
            НовСтр.Товар        = Стр.Наименование;
            НовСтр.Количество   = Стр.Количество;
            НовСтр.Выручка      = Стр.СуммаБезНДС;
            НовСтр.Себестоимость = Стр.Себестоимость;
            НовСтр.Прибыль      = Стр.СуммаБезНДС - Стр.Себестоимость;
        КонецЦикла;
    КонецЦикла;

    // Запрос к ТаблицаЗначений
    Перем Зап;
    Зап = Новый Запрос();
    Зап.УстановитьПараметр("МинВыручка", 1000);
    Зап.ЗарегистрироватьТаблицу("Продажи", ТаблПродажи);
    Зап.Текст =
        "ВЫБРАТЬ
        |    Товар,
        |    Количество,
        |    Выручка,
        |    Себестоимость,
        |    Прибыль
        |ИЗ
        |    Продажи
        |ГДЕ
        |    Выручка > :МинВыручка
        |УПОРЯДОЧИТЬ ПО
        |    Выручка";

    Перем Рез;
    Рез = Зап.Выполнить();
    Сообщить(СтрШаблон("  %-30s %6s %8s %8s %8s",
        "Товар", "Кол.", "Выручка", "Себест.", "Прибыль"));
    Сообщить("  " + СтрПовтор("─", 64));

    Перем Выб;
    Выб = Рез.Выбрать();
    Пока Выб.Следующий() Цикл
        Сообщить(СтрШаблон("  %-30s %6s %8s %8s %8s",
            Выб.Товар,
            Строка(Окр(Выб.Количество, 0)),
            Строка(Окр(Выб.Выручка, 2)),
            Строка(Окр(Выб.Себестоимость, 2)),
            Строка(Окр(Выб.Прибыль, 2))));
    КонецЦикла;
КонецПроцедуры

// ── 15. Запуск отчётов ────────────────────────────────────────────────────

ОтчётОстатки();
ОтчётПрибыли();
ОтчётДебиторка();
ОтчётТопПродаж();
