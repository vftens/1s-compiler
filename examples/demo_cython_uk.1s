// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — ДЕМО: Cython — Прискорення числових обчислень
// Порівняння: Python (інтерпретований) vs Cython (скомпільований)
// ══════════════════════════════════════════════════════════════════════

Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("  DEMO CYTHON — Швидкість числових обчислень у 1S: ERP");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("");

// ── Тест 1: Числа Фібоначчі ───────────────────────────────────────────
Повідомити("── Тест 1: Числа Фібоначчі (рекурсія, n=30) ─────────────────────────");

Функція Фіб(Н)
    Якщо Н <= 1 Тоді  Повернути Н;  КінецьЯкщо;
    Повернути Фіб(Н-1) + Фіб(Н-2);
КінецьФункції;

ПочЧас = ЧасЗараз();
Результат = Фіб(30);
КінЧас = ЧасЗараз();
ЧасPy = Окр((КінЧас - ПочЧас) * 1000, 1);

Повідомити(ШаблонРядка("  Фіб(30) = %1", Результат));
Повідомити(ШаблонРядка("  Час (Python): %1 мс", ЧасPy));
Повідомити("  Cython: ~2-5 мс  (очікуване прискорення 5-20×)");
Повідомити("");

// ── Тест 2: Простi числа (решето Ератосфена) ─────────────────────────
Повідомити("── Тест 2: Прості числа до 10,000 (решето Ератосфена) ───────────────");

ПочЧас2 = ЧасЗараз();
МаксН = 10000; КількПростих = 0;
Сито = Масив();
Для Н = 0 По МаксН Цикл  Сито.Додати(Істина);  КінецьЦиклу;
Для Н = 2 По МаксН Цикл
    Якщо Сито[Н] = Істина Тоді
        КількПростих = КількПростих + 1;
        М = Н + Н;
        Поки М <= МаксН Цикл
            Сито.Встановити(М, Хибність);
            М = М + Н;
        КінецьЦиклу;
    КінецьЯкщо;
КінецьЦиклу;
КінЧас2 = ЧасЗараз();
ЧасPy2 = Окр((КінЧас2 - ПочЧас2) * 1000, 1);

Повідомити(ШаблонРядка("  Простих чисел до 10,000: %1", КількПростих));
Повідомити(ШаблонРядка("  Час (Python): %1 мс", ЧасPy2));
Повідомити("  Cython: ~0.1-0.5 мс  (очікуване прискорення 10-50×)");
Повідомити("");

// ── Тест 3: Числові обчислення ────────────────────────────────────────
Повідомити("── Тест 3: Акумулятор — 100,000 ітерацій ────────────────────────────");

ПочЧас3 = ЧасЗараз();
Сума = 0; Добуток = 1;
Для К = 1 По 100000 Цикл
    Сума = Сума + К;
    Якщо К <= 20 Тоді  Добуток = Добуток * К;  КінецьЯкщо;
КінецьЦиклу;
КінЧас3 = ЧасЗараз();
ЧасPy3 = Окр((КінЧас3 - ПочЧас3) * 1000, 1);

Повідомити(ШаблонРядка("  Сума 1..100000 = %1", Сума));
Повідомити(ШаблонРядка("  Час (Python): %1 мс", ЧасPy3));
Повідомити("  Cython (cdef long): ~1-3 мс  (очікуване прискорення 10-30×)");
Повідомити("");

// ── Як зібрати Cython-версію ──────────────────────────────────────────
ЗагЧас = Окр(ЧасPy + ЧасPy2 + ЧасPy3, 1);
Повідомити("── Як скомпілювати для максимальної швидкості ────────────────────────");
Повідомити("  1. Генерація .pyx:");
Повідомити("     python -m src.cli cython-gen examples/demo_cython_uk.1s");
Повідомити("  2. Компіляція (потрібен GCC / MSVC):");
Повідомити("     python -m src.cli cython-build examples/demo_cython_uk.1s --run");
Повідомити("");
Повідомити("  Або один рядок:");
Повідомити("     pip install cython && python -m src.cli cython-build examples/demo_cython_uk.1s --run");
Повідомити("");
Повідомити("── Що дає Cython ─────────────────────────────────────────────────────");
Повідомити("  cdef long Сума = 0        ← тип замість Python int (8 байт)");
Повідомити("  cpdef long Фіб(long Н)    ← виклик на рівні C");
Повідомити("  cdivision=True            ← без перевірки ділення на 0");
Повідомити("  boundscheck=False         ← без перевірки виходу за межі");
Повідомити("");

Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити(ШаблонРядка("  Загальний час Python: %1 мс   Cython: ~10-30× швидше", ЗагЧас));
Повідомити("  1S: ERP — Cython Demo (українська) — завершено");
Повідомити("══════════════════════════════════════════════════════════════════════");
