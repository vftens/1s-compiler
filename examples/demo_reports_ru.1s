// Демо: Финансовая отчётность — ОСВ + Баланс (RU)
// Использует модуль Reporter (NewReporter) для получения данных из erp.db.

Reporter = НовыйОтчетчик();

// ── Оборотно-сальдовая ведомость (ОСВ) ───────────────────────────────────────
Message("=== Оборотно-сальдовая ведомость — 2026-07 ===");

ОСВ = Reporter.ОборотноСальдоваяВедомость("2026-07");

Message("Итого Дт: " + String(ОСВ.ИтогоДт));
Message("Итого Кт: " + String(ОСВ.ИтогоКт));

Если ОСВ.СбалансировананО Тогда
    Message("Статус: СБАЛАНСИРОВАНО — двойная запись корректна.");
Иначе
    Message("ВНИМАНИЕ: Дисбаланс! Проверьте проводки за период.");
КонецЕсли;

// ── Баланс ────────────────────────────────────────────────────────────────────
Message("");
Message("=== Бухгалтерский баланс — 2026-07 ===");

Баланс = Reporter.Баланс("2026-07");

Message("Итого активов:               " + String(Баланс.ИтогоАктивов));
Message("Итого обязательств и капитала: " + String(Баланс.Обязательства + Баланс.СобственныйКапитал));
Message("Собственный капитал:          " + String(Баланс.СобственныйКапитал));
