// Sprint 14 демо: Оптимизация распределения бюджета (Русский)
// Максимизируем взвешенную утилизацию бюджета по отделам.
// Переменные: x1=расходы отдела A, x2=расходы отдела B, x3=расходы отдела C
// Веса (приоритет): A=1.5, B=1.0, C=0.8

Солвер = НовыйСолвер();

// Целевая функция: максимизировать взвешенную утилизацию
Веса = Новый Массив;
Веса.Добавить(1.5);
Веса.Добавить(1.0);
Веса.Добавить(0.8);
Солвер.Максимизировать(Веса);

// Верхние границы бюджета: x1 <= 50000  ↔  -x1 >= -50000
ОгрА = Новый Массив;
ОгрА.Добавить(-1);
ОгрА.Добавить(0);
ОгрА.Добавить(0);
Солвер.ДобавитьОграничениеНеравенство(ОгрА, -50000);

ОгрБ = Новый Массив;
ОгрБ.Добавить(0);
ОгрБ.Добавить(-1);
ОгрБ.Добавить(0);
Солвер.ДобавитьОграничениеНеравенство(ОгрБ, -30000);

ОгрВ = Новый Массив;
ОгрВ.Добавить(0);
ОгрВ.Добавить(0);
ОгрВ.Добавить(-1);
Солвер.ДобавитьОграничениеНеравенство(ОгрВ, -20000);

// Общий бюджет: x1+x2+x3 <= 80000  ↔  -x1-x2-x3 >= -80000
ОбщийБюджет = Новый Массив;
ОбщийБюджет.Добавить(-1);
ОбщийБюджет.Добавить(-1);
ОбщийБюджет.Добавить(-1);
Солвер.ДобавитьОграничениеНеравенство(ОбщийБюджет, -80000);

// Минимальные расходы: x1 >= 10000
МинА = Новый Массив;
МинА.Добавить(1);
МинА.Добавить(0);
МинА.Добавить(0);
Солвер.ДобавитьОграничениеНеравенство(МинА, 10000);

МинБ = Новый Массив;
МинБ.Добавить(0);
МинБ.Добавить(1);
МинБ.Добавить(0);
Солвер.ДобавитьОграничениеНеравенство(МинБ, 5000);

МинВ = Новый Массив;
МинВ.Добавить(0);
МинВ.Добавить(0);
МинВ.Добавить(1);
Солвер.ДобавитьОграничениеНеравенство(МинВ, 2000);

Солвер.ДобавитьГраницу(0, Неопределено);
Солвер.ДобавитьГраницу(0, Неопределено);
Солвер.ДобавитьГраницу(0, Неопределено);

Результат = Солвер.Решить();

Сообщить("=== Оптимизация бюджета (GLPK 5.0) ===");
Сообщить("Статус: " + Результат.Статус);
Если Результат.Статус = "optimal" Тогда
    Сообщить("Целевое значение (взв. утилизация): " + Строка(Результат.ЦелевоеЗначение));
    Сообщить("Отдел A: " + Строка(Результат.Значения[0]) + " руб.");
    Сообщить("Отдел B: " + Строка(Результат.Значения[1]) + " руб.");
    Сообщить("Отдел C: " + Строка(Результат.Значения[2]) + " руб.");
КонецЕсли;
