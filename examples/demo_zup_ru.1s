// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — ДЕМО: ЗУП — Зарплата и Управление Персоналом
// Предприятие «Альфа» · Февраль 2025 · Русский язык
//
// Ставки налогов (РФ 2025):
//   НДФЛ:              13% до 5 млн, 15% свыше (упрощённо 13%)
//   Страховые взносы:  30% от ФОТ (работодатель)
//   Взнос на травматизм: 0.2%
// ══════════════════════════════════════════════════════════════════════

НДФЛ_Ставка  = 0.13;
СВ_Ставка    = 0.30;
НС_Ставка    = 0.002;

Функция РасчётЗП(Должность, ФИО, Начислено)
    НДФЛ   = Окр(Начислено * 0.13, 2);
    СВ     = Окр(Начислено * 0.30, 2);
    НС     = Окр(Начислено * 0.002, 2);
    НаРуки = Начислено - НДФЛ;
    Стр    = Структура("Должность,ФИО,Начислено,НДФЛ,СВ,НС,НаРуки",
                        Должность, ФИО, Начислено, НДФЛ, СВ, НС, НаРуки);
    Возврат Стр;
КонецФункции;

// ── Справочники ───────────────────────────────────────────────────────
Должности = Справочник("Должности");
Должности.Создать("Д01","Генеральный директор"); Должности.Создать("Д02","Главный бухгалтер");
Должности.Создать("Д03","Менеджер по продажам"); Должности.Создать("Д04","Логист");
Должности.Создать("Д05","Маркетолог"); Должности.Создать("Д06","Кладовщик");

Персонал = Справочник("Сотрудники");
Сот = Персонал.Создать("С001","Козлов Алексей Петрович");
Сот.Должность = "Генеральный директор"; Сот.Отдел = "Дирекция"; Сот.Оклад = 120000;
Сот = Персонал.Создать("С002","Петрова Алла Юрьевна");
Сот.Должность = "Главный бухгалтер"; Сот.Отдел = "Бухгалтерия"; Сот.Оклад = 85000;
Сот = Персонал.Создать("С003","Иванов Сергей Михайлович");
Сот.Должность = "Менеджер по продажам"; Сот.Отдел = "Продажи"; Сот.Оклад = 55000; Сот.Премия = 18000;
Сот = Персонал.Создать("С004","Бондаренко Василий Олегович");
Сот.Должность = "Логист"; Сот.Отдел = "Логистика"; Сот.Оклад = 50000;
Сот = Персонал.Создать("С005","Сидорова Людмила Николаевна");
Сот.Должность = "Маркетолог"; Сот.Отдел = "Маркетинг"; Сот.Оклад = 58000;
Сот = Персонал.Создать("С006","Кравченко Николай Викторович");
Сот.Должность = "Кладовщик"; Сот.Отдел = "Склад"; Сот.Оклад = 42000;

// ── Документ «Начисление зарплаты» ────────────────────────────────────
НЗ = ДокументСМаршрутом("НачислениеЗП");
НЗ.Месяц = "Февраль 2025"; НЗ.Бухгалтер = "Петрова А.Ю.";
Вед = НЗ.ТабличнаяЧасть("Ведомость",
    "ФИО, Должность, Отдел, Оклад, Премия, Начислено, НДФЛ, СВ, НС, НаРуки");

ИтОклад = 0; ИтПрем = 0; ИтНач = 0; ИтНДФЛ = 0; ИтСВ = 0; ИтНС = 0; ИтНаРуки = 0;

Для Каждого Сот Из Персонал Цикл
    Оклад  = Сот.Оклад;
    Если Сот.Премия <> Неопределено Тогда  Премия = Сот.Премия;
    Иначе                                   Премия = 0;  КонецЕсли;
    Нач    = Оклад + Премия;
    Р      = РасчётЗП(Сот.Должность, Сот.Наименование, Нач);
    Стр    = Вед.Добавить();
    Стр["ФИО"]       = Сот.Наименование; Стр["Должность"] = Сот.Должность;
    Стр["Отдел"]     = Сот.Отдел;        Стр["Оклад"]     = Оклад;
    Стр["Премия"]    = Премия;            Стр["Начислено"] = Нач;
    Стр["НДФЛ"]      = Р.НДФЛ;           Стр["СВ"]        = Р.СВ;
    Стр["НС"]        = Р.НС;             Стр["НаРуки"]    = Р.НаРуки;
    ИтОклад = ИтОклад + Оклад; ИтПрем = ИтПрем + Премия; ИтНач = ИтНач + Нач;
    ИтНДФЛ  = ИтНДФЛ  + Р.НДФЛ; ИтСВ = ИтСВ + Р.СВ; ИтНС = ИтНС + Р.НС;
    ИтНаРуки = ИтНаРуки + Р.НаРуки;
КонецЦикла;

НЗ.Подать("Петрова", "Ведомость за февраль сформирована");
НЗ.Согласовать("Козлов (Директор)", "Согласовано, к выплате 25.02.2025");
НЗ.Провести();

Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("        РАСЧЁТНАЯ ВЕДОМОСТЬ  ·  " + НЗ.Месяц + "  ·  ООО «Альфа»");
Сообщить("        Статус: " + НЗ.МетаСтатус("ru"));
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  %-30s %-22s %10s %8s %9s %8s",
    "ФИО", "Должность", "Начислено", "НДФЛ", "Взносы", "На руки"));
Сообщить(СтрПовтор("─", 90));
Для Каждого Стр Из Вед Цикл
    Сообщить(СтрШаблон("  %-30s %-22s %10s %8s %9s %8s",
        Стр["ФИО"], Стр["Должность"],
        Формат(Стр["Начислено"],"ЧДЦ=0"), Формат(Стр["НДФЛ"],"ЧДЦ=0"),
        Формат(Стр["СВ"]+Стр["НС"],"ЧДЦ=0"), Формат(Стр["НаРуки"],"ЧДЦ=0")));
КонецЦикла;
Сообщить(СтрПовтор("─", 90));
Сообщить(СтрШаблон("  %-30s %-22s %10s %8s %9s %8s", "ИТОГО", "",
    Формат(ИтНач,"ЧДЦ=0"), Формат(ИтНДФЛ,"ЧДЦ=0"),
    Формат(ИтСВ+ИтНС,"ЧДЦ=0"), Формат(ИтНаРуки,"ЧДЦ=0")));

Сообщить("");
Сообщить("── Анализ расходов на персонал ──────────────────────────────────────");
ФОТ = ИтНач; СВдополн = ИтСВ + ИтНС;
Сообщить(СтрШаблон("  ФОТ (начислено):                       %1 руб.", Формат(ФОТ,"ЧДЦ=2")));
Сообщить(СтрШаблон("  Страховые взносы (30.2%%):              %1 руб.", Формат(СВдополн,"ЧДЦ=2")));
Сообщить(СтрПовтор("─", 52));
Сообщить(СтрШаблон("  ИТОГО расходов на персонал:            %1 руб.", Формат(ФОТ+СВдополн,"ЧДЦ=2")));
Сообщить(СтрШаблон("  Средняя з/п (на руки):                 %1 руб.", Формат(Окр(ИтНаРуки/Персонал.Количество(),2),"ЧДЦ=2")));
Сообщить(СтрШаблон("  Численность:                           %1 чел.", Персонал.Количество()));
Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("  1S: ERP — ЗУП: Зарплата и управление персоналом (RU) — завершено");
Сообщить("══════════════════════════════════════════════════════════════════════");
