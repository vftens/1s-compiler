// Sprint 12 Демо — Запити до таблиць ERP зі скрипта .1s (Українська)
// Запуск: python -m src.cli run examples/demo_query_erp_uk.1s
// Потрібно: data/erp.db заповнена (запустіть demo_persistence_uk.1s)

Повідомити("=== Sprint 12: Рушій Запитів → База Даних ERP ===");

// Запит вузлів організаційної структури
з = Запит("ВИБРАТИ id, name, type, parent_id ВІД org_nodes ДЕ id <> 'root' ПЕРШІ 20");
з.ПриєднатиБД("erp.db");
рез = з.Виконати();

Повідомити("Вузлів оргструктури в базі: " + рез.Кількість());
кур = рез.Вибрати();
Поки кур.Наступний() Цикл
    Повідомити("  [" + кур.Значення("type") + "] " + кур.Значення("name") + " (батько: " + кур.Значення("parent_id") + ")");
КінецьЦиклу;

// Запит бюджетних асигнувань
Повідомити("");
Повідомити("--- Бюджетні асигнування ---");
зб = Запит("ВИБРАТИ org_id, period, account, amount ВІД budget_allocations ПЕРШІ 10");
зб.ПриєднатиБД("erp.db");
рб = зб.Виконати();
Повідомити("Рядків бюджету: " + рб.Кількість());
кб = рб.Вибрати();
Поки кб.Наступний() Цикл
    Повідомити("  " + кб.Значення("org_id") + " / " + кб.Значення("period") + " / " + кб.Значення("account") + " = " + кб.Значення("amount"));
КінецьЦиклу;

// Запит розрахунків заробітної плати
Повідомити("");
Повідомити("--- Розрахунки заробітної плати ---");
зп = Запит("ВИБРАТИ emp_id, emp_name, period, gross, net ВІД payroll_results ПЕРШІ 10");
зп.ПриєднатиБД("erp.db");
рп = зп.Виконати();
Повідомити("Рядків розрахунків: " + рп.Кількість());
кп = рп.Вибрати();
Поки кп.Наступний() Цикл
    Повідомити("  " + кп.Значення("emp_name") + " (" + кп.Значення("period") + "): брутто=" + кп.Значення("gross") + " нетто=" + кп.Значення("net"));
КінецьЦиклу;

Повідомити("");
Повідомити("=== Готово. Рушій запитів ERP працює коректно. ===");
