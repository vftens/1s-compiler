// ══════════════════════════════════════════════════════════════════════
// 1S: ERP Free Edition — Полный ERP-цикл (аналог SAP)
// Модули: Закупки → Склад → Логистика → ЗУП → Ремонты
// Все операции через Workflow
// Запуск: demos\DEMO-ERP-FULL-RU.bat
// ══════════════════════════════════════════════════════════════════════

Сообщить("╔══════════════════════════════════════════════════════════════╗");
Сообщить("║   1S: ERP  —  ПОЛНЫЙ ERP-ЦИКЛ  —  Русский                   ║");
Сообщить("║   Логистика | Закупки | Склад | ЗУП | Ремонты               ║");
Сообщить("╚══════════════════════════════════════════════════════════════╝");
Сообщить("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 1: ЗАКУПКИ (SAP MM)
// ══════════════════════════════════════════════════════════════════════
Сообщить("┌─ БЛОК 1: ЗАКУПКИ ─────────────────────────────────────────┐");

Перем Пост1, Пост2;
Пост1 = Поставщик("АО Металлсервис", "SUPP-001");
Пост1.rating = 9.2;
Пост1.payment_days = 30;

Пост2 = Поставщик("ООО ТехноЗапчасть", "SUPP-002");
Пост2.rating = 7.8;
Пост2.payment_days = 14;

Сообщить("  Поставщики:");
Сообщить(СтрШаблон("    %1 [рейт. %2] — отсрочка %3 дн.", Пост1.Наименование, Пост1.Рейтинг, Пост1.ДниОплаты));
Сообщить(СтрШаблон("    %1 [рейт. %2] — отсрочка %3 дн.", Пост2.Наименование, Пост2.Рейтинг, Пост2.ДниОплаты));

Перем ЗП1;
ЗП1 = ЗаказПоставщику("ЗП-2025-001", Пост1);
ЗП1.ДобавитьСтроку("STL-001",  "Сталь листовая 4мм",    500, 85);
ЗП1.ДобавитьСтроку("BOLT-M12", "Болт М12×50 (кг)",       200, 45);
ЗП1.ДобавитьСтроку("PIPE-50",  "Труба стальная Ду50 (м)",  80, 320);

// Workflow: Черновик → Согласован → Отправлен поставщику
ЗП1.submit("Иванов И.И.");
ЗП1.approve("Директор");

Сообщить(ЗП1.report("ru"));
Сообщить("");

// Приходная накладная (Goods Receipt)
Перем ПН1;
ПН1 = ПриходнаяНакладная("ПН-2025-001", ЗП1);
ПН1.ДобавитьПриход("STL-001",  "Сталь листовая 4мм",    500, 85);
ПН1.ДобавитьПриход("BOLT-M12", "Болт М12×50 (кг)",       200, 45);
ПН1.ДобавитьПриход("PIPE-50",  "Труба стальная Ду50 (м)",  80, 320);
ПН1.submit("кладовщик");
ПН1.post("склад");

Сообщить(СтрШаблон("  Приходная накладная %1 проведена. Итого: %2 руб.", ПН1.number, ПН1.total_amount));
Сообщить("└───────────────────────────────────────────────────────────┘");
Сообщить("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 2: СКЛАДСКАЯ АНАЛИТИКА (SAP WM)
// ══════════════════════════════════════════════════════════════════════
Сообщить("┌─ БЛОК 2: СКЛАД ───────────────────────────────────────────┐");

Перем Склд;
Склд = Склад("Главный склад", "WH-01");

// Ячейки
Перем Яч1, Яч2, Яч3;
Яч1 = Склд.ДобавитьЯчейку("A", 1, 1, 5000);
Яч2 = Склд.ДобавитьЯчейку("A", 1, 2, 5000);
Яч3 = Склд.ДобавитьЯчейку("B", 2, 1, 3000);

Сообщить(СтрШаблон("  Ячейки: %1-%2-%3", Яч1.Адрес, Яч2.Адрес, Яч3.Адрес));

// Принять товары на склад (синхронизация с закупками)
Склд.Принять("STL-001",  "Сталь листовая 4мм",    500, 85,  Яч1, "ПН-2025-001");
Склд.Принять("BOLT-M12", "Болт М12×50 (кг)",       200, 45,  Яч2, "ПН-2025-001");
Склд.Принять("PIPE-50",  "Труба стальная Ду50 (м)",  80, 320, Яч3, "ПН-2025-001");

// Отпустить в производство
Склд.Отпустить("BOLT-M12", 50, "Заказ на пр-во №12");
Склд.Отпустить("STL-001",  120, "Заказ на пр-во №12");

Сообщить(СтрШаблон("  Остаток стали:   %1 листов", Склд.ОстатокТовара("STL-001")));
Сообщить(СтрШаблон("  Остаток болтов:  %1 кг",     Склд.ОстатокТовара("BOLT-M12")));
Сообщить(СтрШаблон("  Стоимость склада: %1 руб.",   Склд.total_stock_value));

// ABC-анализ
Перем АВС;
АВС = АВС_Анализ(Склд);
АВС.Выполнить();
Сообщить("");
Сообщить(АВС.report("ru"));

// Инвентаризация
Перем Инв;
Инв = Инвентаризация(Склд);
Инв.Пересчитать("STL-001",  375);  // книжный 380, факт 375 → недостача
Инв.Пересчитать("BOLT-M12", 150);  // книжный 150 — ОК
Инв.Пересчитать("PIPE-50",   82);  // книжный 80, факт 82 → излишек
Сообщить("");
Сообщить(Инв.report("ru"));
Сообщить("└───────────────────────────────────────────────────────────┘");
Сообщить("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 3: ЛОГИСТИКА (SAP TM/SD)
// ══════════════════════════════════════════════════════════════════════
Сообщить("┌─ БЛОК 3: ЛОГИСТИКА ───────────────────────────────────────┐");

Перем Перев1;
Перев1 = Перевозчик("ООО АвтоТранс", "CARR-01");
Перев1.rate_per_km = 45;
Перев1.max_weight_kg = 10000;
Перев1.reliability = 0.94;

Перем Маршрут;
Маршрут = МаршрутДоставки("Москва—Тула—Орёл", Перев1);
Маршрут.total_distance_km = 380;
Маршрут.ДобавитьТочку("Москва, склад (отправка)", Неопределено, 4500);
Маршрут.ДобавитьТочку("Тула, завод Тяжмаш",        Неопределено, 2000);
Маршрут.ДобавитьТочку("Орёл, склад клиента",        Неопределено, 2500);

Перем ТЗ;
ТЗ = ТранспортнаяЗаявка("ТЗ-2025-001", Перев1, Маршрут);
ТЗ.cargo_description = "Сталь листовая + трубы";
ТЗ.weight_kg = 4500;

// Workflow: Черновик → Согласован → В пути → Доставлен
ТЗ.plan("диспетчер");
ТЗ.approve("Логист");
ТЗ.start_transit("Водитель Петров");
ТЗ.deliver("Водитель Петров");

Сообщить(ТЗ.report("ru"));

// Аналитика
Перем АЛ;
АЛ = АналитикаЛогистики();
АЛ.Добавить(ТЗ);

Перем ТЗ2;
ТЗ2 = ТранспортнаяЗаявка("ТЗ-2025-002", Перев1, Маршрут);
ТЗ2.weight_kg = 3000;
ТЗ2.plan("диспетчер");
ТЗ2.approve("Логист");
ТЗ2.start_transit();
ТЗ2.fail("Поломка транспорта");
АЛ.Добавить(ТЗ2);

Сообщить("");
Сообщить(АЛ.dashboard("ru"));
Сообщить("└───────────────────────────────────────────────────────────┘");
Сообщить("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 4: РАСЧЁТ ЗАРПЛАТЫ (SAP HCM)
// ══════════════════════════════════════════════════════════════════════
Сообщить("┌─ БЛОК 4: РАСЧЁТ ЗАРПЛАТЫ (ЗУП) ──────────────────────────┐");

Перем Рег;
Рег = РегистрНакопления("ЗарплатаФОТ");

Перем Сотр, Тариф, НДФЛст, ПФРст, ОМСст;
НДФЛст = 0.13;
ПФРст  = 0.22;
ОМСст  = 0.051;

// Структура: массив сотрудников с окладом
Перем Список;
Список = Массив();
Перем Зап1, Зап2, Зап3;
Зап1 = Структура();
Зап1.Вставить("Имя",   "Иванов И.И.");
Зап1.Вставить("Оклад", 85000);
Зап1.Вставить("Должность", "Главный инженер");

Зап2 = Структура();
Зап2.Вставить("Имя",   "Сидорова А.П.");
Зап2.Вставить("Оклад", 55000);
Зап2.Вставить("Должность", "Бухгалтер");

Зап3 = Структура();
Зап3.Вставить("Имя",   "Петров В.С.");
Зап3.Вставить("Оклад", 42000);
Зап3.Вставить("Должность", "Кладовщик");

Список.Добавить(Зап1);
Список.Добавить(Зап2);
Список.Добавить(Зап3);

Перем ФОТ, ФОТналоги;
ФОТ = 0;
ФОТналоги = 0;

Сообщить("  Расчётный лист:");
Сообщить(СтрШаблон("  %1%-30s %-12s %-10s %-10s %-10s", "", "Сотрудник", "Оклад", "НДФЛ", "К выплате", "Нагрузка"));
Сообщить("  " + СтрПовтор("-", 70));

Перем Н;
Для Н = 0 По Список.Количество() - 1 Цикл
    Перем Сотрудник, Оклад, НДФЛ, НаРуки, СтрЕСН;
    Сотрудник = Список[Н];
    Оклад = Сотрудник.Оклад;
    НДФЛ = Окр(Оклад * НДФЛст, 2);
    НаРуки = Оклад - НДФЛ;
    СтрЕСН = Окр(Оклад * (ПФРст + ОМСст), 2);
    ФОТ = ФОТ + НаРуки;
    ФОТналоги = ФОТналоги + НДФЛ + СтрЕСН;

    // Регистр накопления (ФОТ за месяц)
    Рег.Записать("Зарплата", Сотрудник.Имя, НаРуки);
    Рег.Записать("НДФЛ", Сотрудник.Имя, НДФЛ);
    Рег.Записать("ФОТ_ЕСН", Сотрудник.Имя, СтрЕСН);

    Сообщить(СтрШаблон("  %-30s %12s %10s %10s %10s",
        Сотрудник.Имя, Оклад, НДФЛ, НаРуки, СтрЕСН));
КонецЦикла;

Сообщить("  " + СтрПовтор("-", 70));
Сообщить(СтрШаблон("  ИТОГО к выплате: %1 руб. | Налоги и взносы: %2 руб.", ФОТ, ФОТналоги));
Сообщить("└───────────────────────────────────────────────────────────┘");
Сообщить("");

// ══════════════════════════════════════════════════════════════════════
// БЛОК 5: УПРАВЛЕНИЕ РЕМОНТАМИ (SAP PM)
// ══════════════════════════════════════════════════════════════════════
Сообщить("┌─ БЛОК 5: УПРАВЛЕНИЕ РЕМОНТАМИ (SAP PM) ───────────────────┐");

Перем Оборуд1, Оборуд2;
Оборуд1 = КарточкаОборудования("EQ-001", "Токарный станок DMG CTX 310");
Оборуд1.location   = "Цех №1, позиция 3";
Оборуд1.category   = "Металлообработка";
Оборуд1.manufacturer = "DMG Mori";
Оборуд1.serial_number = "CTX-2019-83751";
Оборуд1.install_date = ДатаОтСтроки("2019-03-15", "ГГГГ-ММ-ДД");
Оборуд1.odometer_hours = 14250;

Оборуд2 = КарточкаОборудования("EQ-002", "Компрессор ABAC Genesis 1510");
Оборуд2.location = "Компрессорная";
Оборуд2.category = "Пневматика";
Оборуд2.odometer_hours = 8900;

// Дефектная ведомость
Оборуд1.ВнестиДефект("DEF-001", "Биение шпинделя > 0.05мм", "high");
Оборуд1.ВнестиДефект("DEF-002", "Износ резцедержателя",     "medium");
Оборуд2.ВнестиДефект("DEF-003", "Утечка масла через сальник", "critical");

Сообщить(Оборуд1.passport("ru"));
Сообщить("");

// Наряд на ремонт с Workflow
Перем НР;
НР = НарядНаРемонт("НР-2025-047", Оборуд1);
НР.work_type = "Средний ремонт";
НР.defect_description = "Биение шпинделя, износ резцедержателя";
НР.labour_hours = 8;
НР.labour_rate = 650;

// Workflow: Черновик → Согласован → В работе → Завершён
НР.submit("мастер цеха");
НР.approve("Главный механик");
НР.НачатьРаботу("Сергеев А.В.");
НР.ДобавитьМатериал("Подшипник 6208",   2,  1850);
НР.ДобавитьМатериал("Резцедержатель BT40", 1, 4200);
НР.ДобавитьМатериал("Смазка Shell Gadus", 0.5, 680);
НР.Завершить("Сергеев А.В.");

Сообщить(НР.report("ru"));

// Аналитика ТО
Перем АТО;
АТО = АналитикаТО();
АТО.ДобавитьОборудование(Оборуд1);
АТО.ДобавитьОборудование(Оборуд2);
АТО.ДобавитьНаряд(НР);

Сообщить("");
Сообщить(АТО.dashboard("ru"));
Сообщить("└───────────────────────────────────────────────────────────┘");
Сообщить("");

// ══════════════════════════════════════════════════════════════════════
// ИТОГОВАЯ СВОДКА ERP
// ══════════════════════════════════════════════════════════════════════
Сообщить("╔══════════════════════════════════════════════════════════════╗");
Сообщить("║   ИТОГ: ERP-ЦИКЛ ВЫПОЛНЕН (аналог SAP ERP)                  ║");
Сообщить("╠══════════════════════════════════════════════════════════════╣");
Сообщить(СтрШаблон("║  ✓ Закупки:     ЗП %1 на сумму %2 руб.", ЗП1.number, ЗП1.total_amount));
Сообщить(СтрШаблон("║  ✓ Склад:       %1 позиций | %2 руб.", Склд.stock_count, Склд.total_stock_value));
Сообщить(СтрШаблон("║  ✓ Логистика:   SLA %1%%", АЛ.sla_pct));
Сообщить(СтрШаблон("║  ✓ ЗУП:         ФОТ %1 руб. к выплате", ФОТ));
Сообщить(СтрШаблон("║  ✓ Ремонты:     Наряд %1 — %2 руб.", НР.number, НР.total_cost));
Сообщить("║                                                              ║");
Сообщить("║  Все операции прошли через Workflow (Черновик→Согласован→    ║");
Сообщить("║  Проведён). Аналог: SAP ERP / S/4HANA Workflows.            ║");
Сообщить("╚══════════════════════════════════════════════════════════════╝");
