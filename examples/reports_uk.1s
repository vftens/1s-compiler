// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Фінансові звіти · Підприємство «Альфа» · Січень 2025
//   Частина 1: Оборотно-сальдова відомість (ОСВ)
//   Частина 2: Звіт про фінансові результати (P&L)
// ══════════════════════════════════════════════════════════════════════

// ── Форматування числової клітинки ──────────────────────────────────
Функція Кл(Знч, Ш)
    Якщо Знч = 0 Тоді
        Повернути ШаблонРядка("%" + Рядок(Ш) + "s", "");
    КінецьЯкщо;
    Повернути Формат(Знч, "ЧЦ=" + Рядок(Ш));
КінецьФункції;

// ── 1. План рахунків ────────────────────────────────────────────────
ПланРах = ПланРахунків("УКСГП");
ПланРах.Додати("10", "Основні засоби");
ПланРах.Додати("20", "Виробничі запаси");
ПланРах.Додати("31", "Рахунки в банках");
ПланРах.Додати("36", "Дебіторська заборгованість");
ПланРах.Додати("40", "Статутний капітал");
ПланРах.Додати("63", "Кредиторська заборгованість");
ПланРах.Додати("65", "Страхування");
ПланРах.Додати("66", "Розрахунки з персоналом");
ПланРах.Додати("70", "Доходи від реалізації");
ПланРах.Додати("90", "Собівартість реалізації");
ПланРах.Додати("92", "Адміністративні витрати");

// ── 2. Регістр ──────────────────────────────────────────────────────
РегБух = РегістрБухгалтерії("Журнал", ПланРах);

ДатДо = '20241231';   // до початку звітного періоду
ПС = '20250101';   // початок січня
ПК = '20250131';   // кінець січня

// Вхідні залишки (31.12.2024)
РегБух.Провести(ДатДо,"ВхСал","Вхідне сальдо: Осн.засоби", "10","40",150000);
РегБух.Провести(ДатДо,"ВхСал","Вхідне сальдо: Запаси",     "20","63", 25000);

// Операції за Cічень 2025
Д = '20250115';
РегБух.Провести(Д,"РН001","Дохід від реалізації",        "36","70",120000);
РегБух.Провести(Д,"РН001","Собівартість реалізованого",  "90","20", 35000);
РегБух.Провести(Д,"ВН001","Нарахування зарплати",        "92","66", 25000);
РегБух.Провести(Д,"ВН001","Нарахування ЄСВ",             "92","65",  5500);
РегБух.Провести(Д,"ПП001","Оплата постачальнику",        "63","31", 50000);
РегБух.Провести(Д,"ПП002","Надходження від покупця",     "31","36",120000);
РегБух.Провести(Д,"Нак01","Придбання запасів",           "20","63", 50000);

// ══════════════════════════════════════════════════════════════════════
//  ЧАСТИНА 1 — ОБОРОТНО-САЛЬДОВА ВІДОМІСТЬ
// ══════════════════════════════════════════════════════════════════════
В = 9;   // ширина числової колонки

Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("     ОБОРОТНО-САЛЬДОВА ВІДОМІСТЬ  ·  Cічень 2025 р.");
Повідомити("══════════════════════════════════════════════════════════════════");

// Заголовок колонок
Р = ШаблонРядка("%-4s", "Рах");
Р = Р + "|" + ШаблонРядка("%" + Рядок(В) + "s", "Поч.Дт");
Р = Р + "|" + ШаблонРядка("%" + Рядок(В) + "s", "Поч.Кт");
Р = Р + "|" + ШаблонРядка("%" + Рядок(В) + "s", "Об.Дт");
Р = Р + "|" + ШаблонРядка("%" + Рядок(В) + "s", "Об.Кт");
Р = Р + "|" + ШаблонРядка("%" + Рядок(В) + "s", "Кін.Дт");
Р = Р + "|" + ШаблонРядка("%" + Рядок(В) + "s", "Кін.Кт");
Повідомити(Р);
Повідомити(СтрПовтор("─", 4 + (В + 1) * 6));

// Акумулятори підсумкового рядка
ТПД = 0; ТПК = 0; ТОД = 0; ТОК = 0; ТКД = 0; ТКК = 0;

Для Кожного Рах З ПланРах Цикл
    БП = РегБух.Залишок(Рах, ДатДо);
    Об = РегБух.Оборот(Рах, ПС, ПК);

    СПД = БП["Дт"]; СПК = БП["Кт"];
    ОД  = Об["ОборотДт"]; ОК = Об["ОборотКт"];

    Якщо СПД + СПК + ОД + ОК = 0 Тоді
        Продовжити;
    КінецьЯкщо;

    Нетто = СПД - СПК + ОД - ОК;
    Якщо Нетто >= 0 Тоді
        СКД = Нетто; СКК = 0;
    Інакше
        СКД = 0; СКК = -Нетто;
    КінецьЯкщо;

    Р = ШаблонРядка("%-4s", Рах.Код);
    Р = Р + "|" + Кл(СПД, В) + "|" + Кл(СПК, В);
    Р = Р + "|" + Кл(ОД,  В) + "|" + Кл(ОК,  В);
    Р = Р + "|" + Кл(СКД, В) + "|" + Кл(СКК, В);
    Повідомити(Р);

    ТПД = ТПД + СПД; ТПК = ТПК + СПК;
    ТОД = ТОД + ОД;  ТОК = ТОК + ОК;
    ТКД = ТКД + СКД; ТКК = ТКК + СКК;
КінецьЦиклу;

// Підсумковий рядок
Повідомити(СтрПовтор("─", 4 + (В + 1) * 6));
Р = ШаблонРядка("%-4s", "РАЗОМ");
Р = Р + "|" + Кл(ТПД, В) + "|" + Кл(ТПК, В);
Р = Р + "|" + Кл(ТОД, В) + "|" + Кл(ТОК, В);
Р = Р + "|" + Кл(ТКД, В) + "|" + Кл(ТКК, В);
Повідомити(Р);
Повідомити(ШаблонРядка("  Перевірка: Об.Дт %1 = Об.Кт %2  (ТПД %3 = ТПК %4)", ТОД, ТОК, ТКД, ТКК));

// ══════════════════════════════════════════════════════════════════════
//  ЧАСТИНА 2 — ЗВІТ ПРО ФІНАНСОВІ РЕЗУЛЬТАТИ (P&L)
// ══════════════════════════════════════════════════════════════════════
Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("     ЗВІТ ПРО ФІНАНСОВІ РЕЗУЛЬТАТИ  ·  Cічень 2025 р.");
Повідомити("══════════════════════════════════════════════════════════════════");

ВД = 44; ВС = 12;

Об70 = РегБух.Оборот(ПланРах.НайтиЗаКодом("70"), ПС, ПК);
Об90 = РегБух.Оборот(ПланРах.НайтиЗаКодом("90"), ПС, ПК);
Об92 = РегБух.Оборот(ПланРах.НайтиЗаКодом("92"), ПС, ПК);

Виручка  = Об70["ОборотКт"];
Собів    = Об90["ОборотДт"];
Валовий  = Виручка - Собів;
АдмВит   = Об92["ОборотДт"];
ОперПриб = Валовий - АдмВит;
Рентаб   = Окр(ОперПриб / Виручка * 100, 1);

Сепаратор = СтрПовтор("─", ВД + ВС + 3);

Повідомити(ШаблонРядка("%-" + Рядок(ВД) + "s  %s", "Стаття", "Сума, грн"));
Повідомити(Сепаратор);
Повідомити(ШаблонРядка("%-" + Рядок(ВД) + "s  %s", "Дохід від реалізації  (рах. 70)",     Кл(Виручка,  ВС)));
Повідомити(ШаблонРядка("%-" + Рядок(ВД) + "s  %s", "Собівартість реалізації (рах. 90)",  "(" + Кл(Собів, ВС-2) + ")"));
Повідомити(Сепаратор);
Повідомити(ШаблонРядка("%-" + Рядок(ВД) + "s  %s", "ВАЛОВИЙ ПРИБУТОК",                   Кл(Валовий,  ВС)));
Повідомити(ШаблонРядка("%-" + Рядок(ВД) + "s  %s", "Адміністративні витрати (рах. 92)",  "(" + Кл(АдмВит, ВС-2) + ")"));
Повідомити(Сепаратор);
Повідомити(ШаблонРядка("%-" + Рядок(ВД) + "s  %s", "ОПЕРАЦІЙНИЙ ПРИБУТОК",               Кл(ОперПриб, ВС)));
Повідомити(ШаблонРядка("%-" + Рядок(ВД) + "s  %s", "Рентабельність (Operating margin):", Рядок(Рентаб) + "%"));
Повідомити(СтрПовтор("═", ВД + ВС + 3));
Повідомити("  1S: ERP — ОСВ + Звіт про ФР (українська мова) — завершено");
Повідомити(СтрПовтор("═", ВД + ВС + 3));
