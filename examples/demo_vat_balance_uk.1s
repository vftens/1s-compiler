// Демо: баланс ПДВ за місяць (Україна, 2024)
// ПДВ 20%. Від'ємне сальдо = "до відшкодування"; позитивне = "до сплати".

// Вхідний ПДВ (податковий кредит)
InputBase    = 250000 + 80000 + 320000;  // сировина + послуги + обладнання
InputVAT     = InputBase * 0.20;

// Вихідний ПДВ (податкове зобов'язання)
OutputBase   = 500000 + 60000;           // продажі + послуги реалізовані
OutputVAT    = OutputBase * 0.20;

// Сальдо
Balance      = OutputVAT - InputVAT;

Message("=== ПДВ-декларація (місяць) ===");
Message("Вихідний ПДВ (ПЗ): " + String(OutputVAT) + " грн");
Message("Вхідний ПДВ (ПК):  " + String(InputVAT)  + " грн");
Message("-----------------------------------");
If Balance > 0 Then
    Message("До сплати до бюджету:     " + String(Balance)   + " грн");
ElseIf Balance < 0 Then
    Message("До відшкодування:         " + String(-Balance)  + " грн");
Else
    Message("Сальдо нульове.");
EndIf;
