// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — ДЕМО: ЗУП — Зарплата та Управління Персоналом
// Підприємство «Альфа» · Лютий 2025 · Українська мова
//
// Ставки податків (2025):
//   ПДФО:            18%  від нарахованого (платить працівник)
//   Військовий збір:  1.5% від нарахованого (платить працівник)
//   ЄСВ:             22%  від нарахованого (платить роботодавець)
// ══════════════════════════════════════════════════════════════════════

// ── Ставки ───────────────────────────────────────────────────────────
ПДФО_Ставка = 0.18;
ВЗ_Ставка   = 0.015;
ЄСВ_Ставка  = 0.22;

// ── Допоміжна: розрахунок рядка відомості ────────────────────────────
Функція РозрахувЗП(Посада, Прізвище, Нараховано)
    ПДФО  = Окр(Нараховано * 0.18,  2);
    ВЗ    = Окр(Нараховано * 0.015, 2);
    ЄСВ   = Окр(Нараховано * 0.22,  2);
    Чисто = Нараховано - ПДФО - ВЗ;
    Стр = Структура("Посада,Прізвище,Нараховано,ПДФО,ВЗ,ЄСВ,ДоВиплати",
                     Посада, Прізвище, Нараховано, ПДФО, ВЗ, ЄСВ, Чисто);
    Повернути Стр;
КінецьФункції;

// ── Довідники ─────────────────────────────────────────────────────────
Відділи = Справочник("Відділи");
Відділи.Створити("В01", "Дирекція");
Відділи.Створити("В02", "Бухгалтерія");
Відділи.Створити("В03", "Відділ продажів");
Відділи.Створити("В04", "Логістика");
Відділи.Створити("В05", "Маркетинг");

Посади = Справочник("Посади");
Посади.Створити("П01", "Директор");
Посади.Створити("П02", "Головний бухгалтер");
Посади.Створити("П03", "Менеджер з продажів");
Посади.Створити("П04", "Логіст");
Посади.Створити("П05", "Маркетолог");
Посади.Створити("П06", "Комірник");

// ── Штатний розпис ────────────────────────────────────────────────────
Персонал = Справочник("Персонал");
Сп = Персонал.Створити("СТ001", "Коваленко Олексій Петрович");
Сп.Посада = Посади.НайтиЗаКодом("П01").Назва; Сп.Відділ = "Дирекція";    Сп.Оклад = 80000;
Сп = Персонал.Створити("СТ002", "Петренко Алла Юріївна");
Сп.Посада = Посади.НайтиЗаКодом("П02").Назва; Сп.Відділ = "Бухгалтерія"; Сп.Оклад = 55000;
Сп = Персонал.Створити("СТ003", "Іваненко Сергій Михайлович");
Сп.Посада = Посади.НайтиЗаКодом("П03").Назва; Сп.Відділ = "Продажі";     Сп.Оклад = 35000; Сп.Премія = 12000;
Сп = Персонал.Створити("СТ004", "Бондар Василь Олегович");
Сп.Посада = Посади.НайтиЗаКодом("П04").Назва; Сп.Відділ = "Логістика";   Сп.Оклад = 32000;
Сп = Персонал.Створити("СТ005", "Сидоренко Людмила Миколаївна");
Сп.Посада = Посади.НайтиЗаКодом("П05").Назва; Сп.Відділ = "Маркетинг";  Сп.Оклад = 38000;
Сп = Персонал.Створити("СТ006", "Кравченко Микола Вікторович");
Сп.Посада = Посади.НайтиЗаКодом("П06").Назва; Сп.Відділ = "Логістика";   Сп.Оклад = 28000;

// ── Документ «Нарахування зарплати» ──────────────────────────────────
НЗ = ДокументЗМаршрутом("НарахЗарплати");
НЗ.Місяць = "Лютий 2025"; НЗ.Бухгалтер = "Петренко А.Ю.";
Відомість = НЗ.ТабличнаЧастина("Відомість",
    "ПІБ, Посада, Відділ, Оклад, Премія, Нараховано, ПДФО, ВЗ, ЄСВ, ДоВиплати");

// ── Нарахування ───────────────────────────────────────────────────────
ТітОклад = 0; ТітПремія = 0; ТітНарах = 0;
ТітПДФО  = 0; ТітВЗ = 0; ТітЄСВ = 0; ТітЧисто = 0;

Для Кожного Сп З Персонал Цикл
    Оклад  = Сп.Оклад;
    Якщо Сп.Премія <> Невизначено Тоді  Премія = Сп.Премія;
    Інакше                               Премія = 0;  КінецьЯкщо;
    Нарах  = Оклад + Премія;
    Роз    = РозрахувЗП(Сп.Посада, Сп.Назва, Нарах);

    Р = Відомість.Додати();
    Р["ПІБ"]        = Сп.Назва;
    Р["Посада"]     = Сп.Посада;
    Р["Відділ"]     = Сп.Відділ;
    Р["Оклад"]      = Оклад;
    Р["Премія"]     = Премія;
    Р["Нараховано"] = Нарах;
    Р["ПДФО"]       = Роз.ПДФО;
    Р["ВЗ"]         = Роз.ВЗ;
    Р["ЄСВ"]        = Роз.ЄСВ;
    Р["ДоВиплати"]  = Роз.ДоВиплати;

    ТітОклад = ТітОклад + Оклад;
    ТітПремія = ТітПремія + Премія;
    ТітНарах  = ТітНарах  + Нарах;
    ТітПДФО   = ТітПДФО   + Роз.ПДФО;
    ТітВЗ     = ТітВЗ     + Роз.ВЗ;
    ТітЄСВ    = ТітЄСВ    + Роз.ЄСВ;
    ТітЧисто  = ТітЧисто  + Роз.ДоВиплати;
КінецьЦиклу;

// ── Погодження та проведення ──────────────────────────────────────────
НЗ.Надіслати("Петренко", "Відомість за лютий сформована, прошу погодити");
НЗ.Погодити("Коваленко (Директор)", "Погоджено, до виплати 25.02.2025");
НЗ.Провести();

// ── Вивід відомості ───────────────────────────────────────────────────
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("        ПЛАТІЖНА ВІДОМІСТЬ  ·  " + НЗ.Місяць + "  ·  Підпр. «Альфа»");
Повідомити("        Статус: " + НЗ.МетаСтатус("uk"));
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити(ШаблонРядка("  %-32s %-20s %9s %7s %7s %7s %10s",
    "ПІБ", "Посада", "Нарах.", "ПДФО", "ВЗ", "ЄСВ", "До виплати"));
Повідомити(СтрПовтор("─", 92));

Для Кожного Р З Відомість Цикл
    Повідомити(ШаблонРядка("  %-32s %-20s %9s %7s %7s %7s %10s",
        Р["ПІБ"], Р["Посада"],
        Формат(Р["Нараховано"],"ЧДЦ=0"),
        Формат(Р["ПДФО"],"ЧДЦ=0"),
        Формат(Р["ВЗ"],"ЧДЦ=0"),
        Формат(Р["ЄСВ"],"ЧДЦ=0"),
        Формат(Р["ДоВиплати"],"ЧДЦ=0")));
КінецьЦиклу;

Повідомити(СтрПовтор("─", 92));
Повідомити(ШаблонРядка("  %-32s %-20s %9s %7s %7s %7s %10s",
    "РАЗОМ", "", Формат(ТітНарах,"ЧДЦ=0"),
    Формат(ТітПДФО,"ЧДЦ=0"), Формат(ТітВЗ,"ЧДЦ=0"),
    Формат(ТітЄСВ,"ЧДЦ=0"), Формат(ТітЧисто,"ЧДЦ=0")));

// ── Аналіз витрат на персонал ─────────────────────────────────────────
Повідомити("");
Повідомити("── Аналіз витрат на персонал ────────────────────────────────────────");
ЗагФОП     = ТітНарах;
ЗагЄСВроб  = ТітЄСВ;
ЗагВитрати = ЗагФОП + ЗагЄСВроб;
Повідомити(ШаблонРядка("  Фонд оплати праці (ФОП):           %1 грн", Формат(ЗагФОП,"ЧДЦ=2")));
Повідомити(ШаблонРядка("  ЄСВ роботодавця (22%%):             %1 грн", Формат(ЗагЄСВроб,"ЧДЦ=2")));
Повідомити(СтрПовтор("─", 50));
Повідомити(ШаблонРядка("  РАЗОМ витрати на персонал:         %1 грн", Формат(ЗагВитрати,"ЧДЦ=2")));
Повідомити(ШаблонРядка("  Середня зарплата (до виплати):     %1 грн", Формат(Окр(ТітЧисто/Персонал.Кількість(),2),"ЧДЦ=2")));
Повідомити(ШаблонРядка("  Кількість співробітників:          %1", Персонал.Кількість()));
Повідомити(ШаблонРядка("  Премій нараховано:                 %1 грн", Формат(ТітПремія,"ЧДЦ=2")));

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP — ЗУП: Зарплата та управління персоналом (UK) — завершено");
Повідомити("══════════════════════════════════════════════════════════════════════");
