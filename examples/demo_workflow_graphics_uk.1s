// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — ДЕМО: Workflow Dashboard з ASCII-графіками
// Візуалізація стану документів, часової шкали, метрик
// ══════════════════════════════════════════════════════════════════════

// ── ASCII прогрес-бар ─────────────────────────────────────────────────
Функція Бар(Відс, Ш)
    Запов = Окр(Відс * Ш / 100, 0);
    Поро  = Ш - Запов;
    Повернути СтрПовтор("█", Запов) + СтрПовтор("░", Поро);
КінецьФункції;

// ── Позначка статусу ──────────────────────────────────────────────────
Функція ПозначкаСтатусу(Статус)
    Якщо Статус = "posted"    Тоді Повернути "OK";  КінецьЯкщо;
    Якщо Статус = "pending"   Тоді Повернути "..";  КінецьЯкщо;
    Якщо Статус = "rejected"  Тоді Повернути "XX";  КінецьЯкщо;
    Якщо Статус = "approved"  Тоді Повернути "++";  КінецьЯкщо;
    Якщо Статус = "revision"  Тоді Повернути "!?";  КінецьЯкщо;
    Повернути "??";
КінецьФункції;

// ── Журнал аудиту ─────────────────────────────────────────────────────
АЖ = АудитЖурнал("WFDashboard");

// ── Документи ────────────────────────────────────────────────────────
Д1 = ДокументЗМаршрутом("ЗакупівВЗаявка");
Д1.Назва = "Закупівля офісної техніки";     Д1.Сума = 45000;
Д1.Надіслати("Іваненко", "Прошу погодити");
Д1.Погодити("Коваленко", "Погоджено");
Д1.Провести();
АЖ.Записати("Коваленко", "Погодити", "Заявка", Д1.Номер, "45 000 грн");

Д2 = ДокументЗМаршрутом("ЗакупівВЗаявка");
Д2.Назва = "Ремонт складського приміщення"; Д2.Сума = 120000;
Д2.Надіслати("Бондар", "Капітальний ремонт");
Д2.Погодити("Коваленко", "Погоджено");
Д2.Провести();
АЖ.Записати("Коваленко", "Погодити", "Заявка", Д2.Номер, "120 000 грн");

Д3 = ДокументЗМаршрутом("ДоговірПостачання");
Д3.Назва = "Договір з ТОВ МатПлюс";        Д3.Сума = 280000;
Д3.Надіслати("Петренко", "Договір на рік");
Д3.НаДоопрацювання("Юрист", "Уточнити п.3.2");
Д3.Перенадіслати("Петренко", "Виправлено п.3.2");
Д3.Погодити("Коваленко", "Затверджено");
Д3.Провести();
АЖ.Записати("Юрист", "Перевірка", "Договір", Д3.Номер, "Юридична правка");

Д4 = ДокументЗМаршрутом("ВидатковаНакладна");
Д4.Назва = "Реалізація ТОВ Альфа";          Д4.Сума = 95000;
Д4.Надіслати("Склад", "ВН на реалізацію");
Д4.Погодити("Коваленко", "OK");
Д4.Провести();

Д5 = ДокументЗМаршрутом("ВидатковаНакладна");
Д5.Назва = "Реалізація ТОВ Бета";           Д5.Сума = 67000;
Д5.Надіслати("Склад", "ВН 2 відвантаження");
Д5.Відхилити("Фінансист", "Перевищення ліміту дебіторки");
АЖ.Записати("Фінансист", "Відхилити", "ВН", Д5.Номер, "Перевищення ліміту");

Д6 = ДокументЗМаршрутом("ЗаявкаВідпустки");
Д6.Назва = "Відпустка Іваненко 10 днів";    Д6.Сума = 0;
Д6.Надіслати("Іваненко", "01-10.03.2025");
Д6.Погодити("Коваленко", "Погоджено");
Д6.Провести();

Д7 = ДокументЗМаршрутом("КомандировкаНаказ");
Д7.Назва = "Відрядження до Львова";          Д7.Сума = 8500;
Д7.Надіслати("Бондар", "Логістична виставка");

Д8 = ДокументЗМаршрутом("ДоговірОренди");
Д8.Назва = "Оренда складу — продовження";   Д8.Сума = 35000;
Д8.Надіслати("Петренко", "Продовження договору");

// ── Масив документів для обходу ──────────────────────────────────────
Документи = Масив();
Документи.Додати(Д1); Документи.Додати(Д2); Документи.Додати(Д3);
Документи.Додати(Д4); Документи.Додати(Д5); Документи.Додати(Д6);
Документи.Додати(Д7); Документи.Додати(Д8);
ВсьогоДок = Документи.Кількість();

// ── Підрахунок за статусами ────────────────────────────────────────────
КЧерн = 0; КОчік = 0; КПогодж = 0; КПровед = 0; КВідх = 0;
СумПровед = 0; СумОчік = 0;

Для Кожного Дк З Документи Цикл
    Ст = Дк.Статус;
    Якщо Ст = "draft"    Тоді  КЧерн   = КЧерн   + 1;
    ІнакшеЯкщо Ст = "pending"  Тоді  КОчік   = КОчік   + 1; СумОчік   = СумОчік   + Дк.Сума;
    ІнакшеЯкщо Ст = "approved" Тоді  КПогодж = КПогодж + 1;
    ІнакшеЯкщо Ст = "posted"   Тоді  КПровед = КПровед + 1; СумПровед = СумПровед + Дк.Сума;
    ІнакшеЯкщо Ст = "rejected" Тоді  КВідх   = КВідх   + 1;
    КінецьЯкщо;
КінецьЦиклу;

// ═════════════════════ DASHBOARD ═════════════════════════════════════
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("                  WORKFLOW DASHBOARD  ·  Підприємство «Альфа»");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("");

// ── Блок 1: Кругові діаграми (ASCII) ─────────────────────────────────
Повідомити("── Стан документів ──────────────────────────────────────────────────");
Повідомити("");

Перем Відс, Кіл, Назв;
Кіл = КПровед;  Відс = Окр(Кіл * 100 / ВсьогоДок, 0);  Назв = "Проведено  ";
Повідомити(ШаблонРядка("  [OK] %1  %2  %3 (%4%%)", Назв, Бар(Відс, 30), Кіл, Відс));

Кіл = КОчік;   Відс = Окр(Кіл * 100 / ВсьогоДок, 0);   Назв = "На погодж. ";
Повідомити(ШаблонРядка("  [..] %1  %2  %3 (%4%%)", Назв, Бар(Відс, 30), Кіл, Відс));

Кіл = КПогодж; Відс = Окр(Кіл * 100 / ВсьогоДок, 0);   Назв = "Погоджено  ";
Повідомити(ШаблонРядка("  [++] %1  %2  %3 (%4%%)", Назв, Бар(Відс, 30), Кіл, Відс));

Кіл = КВідх;   Відс = Окр(Кіл * 100 / ВсьогоДок, 0);   Назв = "Відхилено  ";
Повідомити(ШаблонРядка("  [XX] %1  %2  %3 (%4%%)", Назв, Бар(Відс, 30), Кіл, Відс));

Кіл = КЧерн;   Відс = Окр(Кіл * 100 / ВсьогоДок, 0);   Назв = "Чернетка   ";
Повідомити(ШаблонРядка("  [??] %1  %2  %3 (%4%%)", Назв, Бар(Відс, 30), Кіл, Відс));

Повідомити("");
Повідомити(ШаблонРядка("  Всього документів: %1  |  Проведено: %2 грн  |  В очікуванні: %3 грн",
    ВсьогоДок, Формат(СумПровед,"ЧДЦ=0"), Формат(СумОчік,"ЧДЦ=0")));

// ── Блок 2: Часова шкала ──────────────────────────────────────────────
Повідомити("");
Повідомити("── Часова шкала документів ──────────────────────────────────────────");
Повідомити("");

Для Кожного Дк З Документи Цикл
    Позн = ПозначкаСтатусу(Дк.Статус);
    Рядочок = ШаблонРядка("  [%1] №%2  %-42s", Позн, Дк.Номер, Дк.Назва);
    Якщо Дк.Сума > 0 Тоді
        Рядочок = Рядочок + "  " + Формат(Дк.Сума,"ЧДЦ=0") + " грн";
    КінецьЯкщо;
    Повідомити(Рядочок);
    Для Кожного Зап З Дк.Журнал Цикл
        ВідСт = WF.label(Зап.from_status, "uk");
        ДоСт  = WF.label(Зап.to_status, "uk");
        Повідомити(ШаблонРядка("       └─ %1 → %2  (%3)", ВідСт, ДоСт, Зап.actor));
    КінецьЦиклу;
    Повідомити("");
КінецьЦиклу;

// ── Блок 3: KPI метрики ───────────────────────────────────────────────
Повідомити("── KPI метрики ───────────────────────────────────────────────────────");
ВідсЕф    = Окр(КПровед * 100 / ВсьогоДок, 0);
ВідсПогод = Окр((КПровед + КПогодж) * 100 / ВсьогоДок, 0);
ВідсВідх  = Окр(КВідх   * 100 / ВсьогоДок, 0);

Повідомити(ШаблонРядка("  Ефективність (проведено):   %1  %2%%", Бар(ВідсЕф,   20), ВідсЕф));
Повідомити(ШаблонРядка("  Рівень погодження:          %1  %2%%", Бар(ВідсПогод, 20), ВідсПогод));
Повідомити(ШаблонРядка("  Рівень відхилення:          %1  %2%%", Бар(ВідсВідх,  20), ВідсВідх));
Повідомити(ШаблонРядка("  Записів у журналі аудиту:   %1", АЖ.Кількість()));

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP — Workflow Dashboard (українська) — завершено");
Повідомити("══════════════════════════════════════════════════════════════════════");
