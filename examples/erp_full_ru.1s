// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Полный ERP-цикл на русском языке
//   Справочники → Документы → Бухгалтерские записи → Финансовый результат
// ══════════════════════════════════════════════════════════════════════

// ── 1. СПРАВОЧНИКИ ──────────────────────────────────────────────────
Контрагенты = Справочник("Контрагенты");
ООО_Альфа   = Контрагенты.Создать("0001", "ООО «Альфа»");
ООО_Альфа.ИНН    = "1234567890";
ООО_Альфа.Тип    = "Покупатель";

ООО_Поставщик = Контрагенты.Создать("0002", "ООО «МатериалПлюс»");
ООО_Поставщик.Тип = "Поставщик";

Товары = Справочник("Номенклатура");
Мука     = Товары.Создать("Т001", "Мука пшеничная в/с, 1 кг");
Мука.Единица = "кг"; Мука.Цена = 45;

Сахар    = Товары.Создать("Т002", "Сахар-песок, 1 кг");
Сахар.Единица = "кг"; Сахар.Цена = 32;

Масло    = Товары.Создать("Т003", "Масло подсолнечное, 1 л");
Масло.Единица = "л"; Масло.Цена = 85;

Сообщить("──── Справочники загружены ─────────────────────────────────────────");
Сообщить(СтрШаблон("  Контрагентов: %1,  Товаров: %2",
    Контрагенты.Количество(), Товары.Количество()));

// ── 2. ПРИХОДНАЯ НАКЛАДНАЯ ───────────────────────────────────────────
ПН = Документ("ПриходнаяНакладная");
ПН.Дата         = '20250110';
ПН.Поставщик    = ООО_Поставщик;

ТоварыПН = ПН.ТабличнаяЧасть("Товары", "Товар, Количество, Цена, Сумма, НДС");
Поз = ТоварыПН.Добавить(); Поз["Товар"] = Мука.Наименование;
Поз["Количество"] = 500; Поз["Цена"] = Мука.Цена; Поз["Сумма"] = 500 * Мука.Цена;
Поз["НДС"] = Окр(500 * Мука.Цена * 0.2, 2);

Поз = ТоварыПН.Добавить(); Поз["Товар"] = Сахар.Наименование;
Поз["Количество"] = 300; Поз["Цена"] = Сахар.Цена; Поз["Сумма"] = 300 * Сахар.Цена;
Поз["НДС"] = Окр(300 * Сахар.Цена * 0.2, 2);

Поз = ТоварыПН.Добавить(); Поз["Товар"] = Масло.Наименование;
Поз["Количество"] = 200; Поз["Цена"] = Масло.Цена; Поз["Сумма"] = 200 * Масло.Цена;
Поз["НДС"] = Окр(200 * Масло.Цена * 0.2, 2);
ПН.Провести();

СуммаПН = ТоварыПН.Итог("Сумма"); НДС_вх = ТоварыПН.Итог("НДС");
Сообщить("");
Сообщить("──── Приходная накладная №" + ПН.Номер + " от " + Строка(ПН.Дата) + " ────────────────────");
Для Каждого Поз Из ТоварыПН Цикл
    Сообщить(СтрШаблон("  %-36s  %5s шт.  %8s руб.",
        Поз["Товар"], Поз["Количество"], Формат(Поз["Сумма"],"ЧДЦ=2")));
КонецЦикла;
Сообщить(СтрШаблон("  Сумма без НДС: %1  |  НДС: %2  |  Итого: %3",
    Формат(СуммаПН,"ЧДЦ=2"), Формат(НДС_вх,"ЧДЦ=2"), Формат(СуммаПН+НДС_вх,"ЧДЦ=2")));

// ── 3. РАСХОДНАЯ НАКЛАДНАЯ ───────────────────────────────────────────
РН = Документ("РасходнаяНакладная");
РН.Дата     = '20250115';
РН.Покупатель = ООО_Альфа;

ТоварыРН = РН.ТабличнаяЧасть("Товары", "Товар, Количество, Цена, Сумма, НДС");
Поз = ТоварыРН.Добавить(); Поз["Товар"] = Мука.Наименование;
Поз["Количество"] = 400; Поз["Цена"] = 64; Поз["Сумма"] = 400 * 64;
Поз["НДС"] = Окр(400 * 64 * 0.2, 2);

Поз = ТоварыРН.Добавить(); Поз["Товар"] = Сахар.Наименование;
Поз["Количество"] = 250; Поз["Цена"] = 44; Поз["Сумма"] = 250 * 44;
Поз["НДС"] = Окр(250 * 44 * 0.2, 2);

Поз = ТоварыРН.Добавить(); Поз["Товар"] = Масло.Наименование;
Поз["Количество"] = 150; Поз["Цена"] = 116; Поз["Сумма"] = 150 * 116;
Поз["НДС"] = Окр(150 * 116 * 0.2, 2);
РН.Провести();

СуммаРН = ТоварыРН.Итог("Сумма"); НДС_вых = ТоварыРН.Итог("НДС");
Сообщить("");
Сообщить("──── Расходная накладная №" + РН.Номер + " от " + Строка(РН.Дата) + " ──────────────────────");
Для Каждого Поз Из ТоварыРН Цикл
    Сообщить(СтрШаблон("  %-36s  %5s шт.  %8s руб.",
        Поз["Товар"], Поз["Количество"], Формат(Поз["Сумма"],"ЧДЦ=2")));
КонецЦикла;

// ── 4. БУХГАЛТЕРСКИЕ ЗАПИСИ ─────────────────────────────────────────
ПланСч = ПланСчетов("Общий");
ПланСч.ДобавитьСчёт("20","Запасы"); ПланСч.ДобавитьСчёт("36","Дебиторы");
ПланСч.ДобавитьСчёт("60","Кредиторы"); ПланСч.ДобавитьСчёт("70","Выручка");
ПланСч.ДобавитьСчёт("90","Себест."); ПланСч.ДобавитьСчёт("92","Адм.расх.");

РегБух = РегистрБухгалтерии("Журнал", ПланСч);
РегБух.Провести('20250110',"ПН-0001","Приход запасов",    "20","60", СуммаПН);
РегБух.Провести('20250115',"РН-0001","Выручка",           "36","70", СуммаРН);
Себест = 400 * Мука.Цена + 250 * Сахар.Цена + 150 * Масло.Цена;
РегБух.Провести('20250115',"РН-0001","Себестоимость",     "90","20", Себест);
РегБух.Провести('20250131',"АВ-001", "Адм. расходы",      "92","60",  4500);

// ── 5. ФИНАНСОВЫЙ РЕЗУЛЬТАТ ─────────────────────────────────────────
Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("         ФИНАНСОВЫЙ РЕЗУЛЬТАТ · ООО «Альфа» · Январь 2025 г.");
Сообщить("══════════════════════════════════════════════════════════════════════");
НачДата = '20250101'; КонДата = '20250131';
О70 = РегБух.Оборот(ПланСч.НайтиПоКоду("70"), НачДата, КонДата);
О90 = РегБух.Оборот(ПланСч.НайтиПоКоду("90"), НачДата, КонДата);
О92 = РегБух.Оборот(ПланСч.НайтиПоКоду("92"), НачДата, КонДата);
Выручка   = О70["ОборотКт"];
Себест2   = О90["ОборотДт"];
ВалПриб   = Выручка - Себест2;
АдмРасх   = О92["ОборотДт"];
ОперПриб  = ВалПриб - АдмРасх;
Рентаб    = Окр(ОперПриб / Выручка * 100, 1);
Сообщить(СтрШаблон("  %-44s  %12s руб.", "Выручка от реализации",   Формат(Выручка,"ЧДЦ=2")));
Сообщить(СтрШаблон("  %-44s  %12s руб.", "Себестоимость реализованных товаров", "(" + Формат(Себест2,"ЧДЦ=2") + ")"));
Сообщить(СтрШаблон("  %-44s  %12s руб.", "ВАЛОВАЯ ПРИБЫЛЬ",          Формат(ВалПриб,"ЧДЦ=2")));
Сообщить(СтрШаблон("  %-44s  %12s руб.", "Административные расходы", "(" + Формат(АдмРасх,"ЧДЦ=2") + ")"));
Сообщить(СтрШаблон("  %-44s  %12s руб.", "ОПЕРАЦИОННАЯ ПРИБЫЛЬ",     Формат(ОперПриб,"ЧДЦ=2")));
Сообщить(СтрШаблон("  %-44s  %11s%%",   "Рентабельность (Operating margin):", Строка(Рентаб)));
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("  1S: ERP — Справочники + Документы + Учёт (Russian) — завершено");
Сообщить("══════════════════════════════════════════════════════════════════════");
