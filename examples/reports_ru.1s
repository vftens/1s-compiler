// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Финансовые отчёты · Предприятие «Альфа» · Январь 2025
//   Часть 1: Оборотно-сальдовая ведомость (ОСВ)
//   Часть 2: Отчёт о финансовых результатах (ОФР / P&L)
// ══════════════════════════════════════════════════════════════════════

Функция Кл(Знч, Ш)
    Если Знч = 0 Тогда
        Возврат СтрШаблон("%" + Строка(Ш) + "s", "");
    КонецЕсли;
    Возврат Формат(Знч, "ЧЦ=" + Строка(Ш));
КонецФункции;

// ── 1. План счетов ──────────────────────────────────────────────────
ПланСч = ПланСчетов("Общий");
ПланСч.ДобавитьСчёт("10", "Основные средства");
ПланСч.ДобавитьСчёт("20", "Производственные запасы");
ПланСч.ДобавитьСчёт("31", "Расчётные счета");
ПланСч.ДобавитьСчёт("36", "Дебиторская задолженность");
ПланСч.ДобавитьСчёт("40", "Уставный капитал");
ПланСч.ДобавитьСчёт("63", "Кредиторская задолженность");
ПланСч.ДобавитьСчёт("65", "Страхование");
ПланСч.ДобавитьСчёт("66", "Расчёты с персоналом");
ПланСч.ДобавитьСчёт("70", "Доходы от реализации");
ПланСч.ДобавитьСчёт("90", "Себестоимость реализации");
ПланСч.ДобавитьСчёт("92", "Административные расходы");

// ── 2. Регистр бухгалтерии ──────────────────────────────────────────
РегБух = РегистрБухгалтерии("Журнал", ПланСч);

НаДату = '20241231';   // дата начального сальдо (до отчётного периода)
НачДата = '20250101';  // начало января
КонДата = '20250131';  // конец января

// Входящее сальдо (31.12.2024)
РегБух.Провести(НаДату,"ВхСал","Вх.сальдо: Осн.средства","10","40",150000);
РегБух.Провести(НаДату,"ВхСал","Вх.сальдо: Запасы",      "20","63", 25000);

// Операции за Январь 2025
Д = '20250115';
РегБух.Провести(Д,"РН001","Выручка от реализации",        "36","70",120000);
РегБух.Провести(Д,"РН001","Списание себестоимости",       "90","20", 35000);
РегБух.Провести(Д,"ВН001","Начисление зарплаты",          "92","66", 25000);
РегБух.Провести(Д,"ВН001","Начисление страх. взносов",    "92","65",  5500);
РегБух.Провести(Д,"ПП001","Оплата поставщику",            "63","31", 50000);
РегБух.Провести(Д,"ПП002","Поступление от покупателя",    "31","36",120000);
РегБух.Провести(Д,"Нак01","Приобретение запасов",         "20","63", 50000);

// ══════════════════════════════════════════════════════════════════════
//  ЧАСТЬ 1 — ОБОРОТНО-САЛЬДОВАЯ ВЕДОМОСТЬ (ОСВ)
// ══════════════════════════════════════════════════════════════════════
В = 9;

Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("     ОБОРОТНО-САЛЬДОВАЯ ВЕДОМОСТЬ  ·  Январь 2025 г.");
Сообщить("══════════════════════════════════════════════════════════════════");

Р = СтрШаблон("%-4s", "Сч.");
Р = Р + "|" + СтрШаблон("%" + Строка(В) + "s", "Нач.Дт");
Р = Р + "|" + СтрШаблон("%" + Строка(В) + "s", "Нач.Кт");
Р = Р + "|" + СтрШаблон("%" + Строка(В) + "s", "Об.Дт");
Р = Р + "|" + СтрШаблон("%" + Строка(В) + "s", "Об.Кт");
Р = Р + "|" + СтрШаблон("%" + Строка(В) + "s", "Кон.Дт");
Р = Р + "|" + СтрШаблон("%" + Строка(В) + "s", "Кон.Кт");
Сообщить(Р);
Сообщить(СтрПовтор("─", 4 + (В + 1) * 6));

ТПД = 0; ТПК = 0; ТОД = 0; ТОК = 0; ТКД = 0; ТКК = 0;

Для Каждого Сч Из ПланСч Цикл
    БП = РегБух.Остаток(Сч, НаДату);
    Об = РегБух.Оборот(Сч, НачДата, КонДата);

    НДт = БП["Дт"]; НКт = БП["Кт"];
    ОДт = Об["ОборотДт"]; ОКт = Об["ОборотКт"];

    Если НДт + НКт + ОДт + ОКт = 0 Тогда
        Продолжить;
    КонецЕсли;

    Нетто = НДт - НКт + ОДт - ОКт;
    Если Нетто >= 0 Тогда
        КДт = Нетто; ККт = 0;
    Иначе
        КДт = 0; ККт = -Нетто;
    КонецЕсли;

    Р = СтрШаблон("%-4s", Сч.Код);
    Р = Р + "|" + Кл(НДт, В) + "|" + Кл(НКт, В);
    Р = Р + "|" + Кл(ОДт, В) + "|" + Кл(ОКт, В);
    Р = Р + "|" + Кл(КДт, В) + "|" + Кл(ККт, В);
    Сообщить(Р);

    ТПД = ТПД + НДт; ТПК = ТПК + НКт;
    ТОД = ТОД + ОДт; ТОК = ТОК + ОКт;
    ТКД = ТКД + КДт; ТКК = ТКК + ККт;
КонецЦикла;

Сообщить(СтрПовтор("─", 4 + (В + 1) * 6));
Р = СтрШаблон("%-4s", "ИТОГО");
Р = Р + "|" + Кл(ТПД, В) + "|" + Кл(ТПК, В);
Р = Р + "|" + Кл(ТОД, В) + "|" + Кл(ТОК, В);
Р = Р + "|" + Кл(ТКД, В) + "|" + Кл(ТКК, В);
Сообщить(Р);
Сообщить(СтрШаблон("  Контроль: Об.Дт %1 = Об.Кт %2  (Кон.Дт %3 = Кон.Кт %4)", ТОД, ТОК, ТКД, ТКК));

// ══════════════════════════════════════════════════════════════════════
//  ЧАСТЬ 2 — ОТЧЁТ О ФИНАНСОВЫХ РЕЗУЛЬТАТАХ (ОФР)
// ══════════════════════════════════════════════════════════════════════
Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("     ОТЧЁТ О ФИНАНСОВЫХ РЕЗУЛЬТАТАХ  ·  Январь 2025 г.");
Сообщить("══════════════════════════════════════════════════════════════════");

ВД = 44; ВС = 12;

Об70 = РегБух.Оборот(ПланСч.НайтиПоКоду("70"), НачДата, КонДата);
Об90 = РегБух.Оборот(ПланСч.НайтиПоКоду("90"), НачДата, КонДата);
Об92 = РегБух.Оборот(ПланСч.НайтиПоКоду("92"), НачДата, КонДата);

Выручка   = Об70["ОборотКт"];
Себест    = Об90["ОборотДт"];
ВалПриб   = Выручка - Себест;
АдмРасх   = Об92["ОборотДт"];
ОперПриб  = ВалПриб - АдмРасх;
Рентаб    = Окр(ОперПриб / Выручка * 100, 1);

Сепар = СтрПовтор("─", ВД + ВС + 3);

Сообщить(СтрШаблон("%-" + Строка(ВД) + "s  %s", "Показатель", "Сумма, руб."));
Сообщить(Сепар);
Сообщить(СтрШаблон("%-" + Строка(ВД) + "s  %s", "Выручка от реализации  (сч. 70)",        Кл(Выручка,  ВС)));
Сообщить(СтрШаблон("%-" + Строка(ВД) + "s  %s", "Себестоимость реализации (сч. 90)",      "(" + Кл(Себест, ВС-2) + ")"));
Сообщить(Сепар);
Сообщить(СтрШаблон("%-" + Строка(ВД) + "s  %s", "ВАЛОВАЯ ПРИБЫЛЬ",                        Кл(ВалПриб,  ВС)));
Сообщить(СтрШаблон("%-" + Строка(ВД) + "s  %s", "Административные расходы (сч. 92)",      "(" + Кл(АдмРасх, ВС-2) + ")"));
Сообщить(Сепар);
Сообщить(СтрШаблон("%-" + Строка(ВД) + "s  %s", "ОПЕРАЦИОННАЯ ПРИБЫЛЬ",                   Кл(ОперПриб, ВС)));
Сообщить(СтрШаблон("%-" + Строка(ВД) + "s  %s", "Рентабельность (Operating margin):",     Строка(Рентаб) + "%"));
Сообщить(СтрПовтор("═", ВД + ВС + 3));
Сообщить("  1S: ERP — ОСВ + ОФР (русский язык) — завершено");
Сообщить(СтрПовтор("═", ВД + ВС + 3));
