// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — 4-Week Work Plan + Workflow Execution (SAP-style WBS)
// Company «Alpha» · January 2025 · English
//
// Weeks 1-3: created → approved → partially/fully executed
// Week 4:    created → submitted → awaiting approval
// ══════════════════════════════════════════════════════════════════════

Log = AuditLog("WorkPlan");

Function PrintTask(Num, TaskName, Owner, Done)
    Pad = Max(0, 38 - StrLen(TaskName));
    Line = StrTemplate("  %1. ", Num) + TaskName + StrRepeat(" ", Pad);
    If Done[TaskName] = True Then
        Line = Line + " OK " + Owner;
    Else
        Line = Line + " -- " + Owner + " (not done)";
    EndIf;
    Message(Line);
EndFunction;

Function PrintWeek(Plan, Done, Header)
    Tasks  = Plan.TabSection("Tasks");
    Total  = Tasks.Count();
    Completed = 0;
    For Each Row In Tasks Do
        If Done[Row["Name"]] = True Then  Completed = Completed + 1;  EndIf;
    EndDo;
    Pct = Completed * 100 / Total;
    Message("── " + Header + " | Status: " + Plan.StatusLabel("en") + " ────────────");
    N = 0;
    For Each Row In Tasks Do
        N = N + 1;
        PrintTask(N, Row["Name"], Row["Owner"], Done);
    EndDo;
    Message(StrTemplate("  Completion: %1/%2 (%3%)", Completed, Total, Round(Pct, 0)));
    Return Completed;
EndFunction;

// ════════════════════════════════════════════════════════════════════
Message("══════════════════════════════════════════════════════════════════");
Message("  WORK PLAN FOR JANUARY 2025  ·  Company «Alpha»");
Message("══════════════════════════════════════════════════════════════════");

// ── Week 1 (Jan 6-10) — 100% completion ────────────────────────────
W1 = WorkflowDocument("WeeklyPlan");
W1.Week = 1; W1.Manager = "Johnson";
W1.PeriodStart = '20250106'; W1.PeriodEnd = '20250110';

T1 = W1.TabSection("Tasks", "Name, Owner, Deadline");
R = T1.Add(); R["Name"] = "Purchase flour 1000 kg";          R["Owner"] = "Smith";   R["Deadline"] = '20250107';
R = T1.Add(); R["Name"] = "Purchase sugar and oil 500 kg";   R["Owner"] = "Smith";   R["Deadline"] = '20250107';
R = T1.Add(); R["Name"] = "Prepare new client contracts";    R["Owner"] = "Johnson"; R["Deadline"] = '20250108';
R = T1.Add(); R["Name"] = "Warehouse technical inspection";  R["Owner"] = "Brown";   R["Deadline"] = '20250109';
R = T1.Add(); R["Name"] = "December financial report";       R["Owner"] = "Davis";   R["Deadline"] = '20250110';

W1.Submit("Johnson", "Week 1 plan — starting January 6th");
W1.Approve("Williams (CEO)", "Approved — proceed with execution");
W1.Post();
Log.Record("Williams", "Approve", "WeeklyPlan", W1.Number, "Week 1 approved");

D1 = Map();
D1["Purchase flour 1000 kg"]        = True;
D1["Purchase sugar and oil 500 kg"] = True;
D1["Prepare new client contracts"]  = True;
D1["Warehouse technical inspection"] = True;
D1["December financial report"]     = True;
For Each Pair In D1 Do
    Log.Record("Team", "Complete", "Task", Pair.Key, "Done in Week 1");
EndDo;

// ── Week 2 (Jan 13-17) — 80% completion ────────────────────────────
W2 = WorkflowDocument("WeeklyPlan");
W2.Week = 2; W2.Manager = "Johnson";
W2.PeriodStart = '20250113'; W2.PeriodEnd = '20250117';

T2 = W2.TabSection("Tasks", "Name, Owner, Deadline");
R = T2.Add(); R["Name"] = "Ship goods to Alpha LLC";          R["Owner"] = "Warehouse"; R["Deadline"] = '20250113';
R = T2.Add(); R["Name"] = "Pay supplier MaterialPlus";        R["Owner"] = "Davis";     R["Deadline"] = '20250114';
R = T2.Add(); R["Name"] = "Onboard new sales manager";        R["Owner"] = "Johnson";   R["Deadline"] = '20250115';
R = T2.Add(); R["Name"] = "Social media ad campaign";         R["Owner"] = "Marketing"; R["Deadline"] = '20250117';
R = T2.Add(); R["Name"] = "Warehouse stock count";            R["Owner"] = "Storekeeper"; R["Deadline"] = '20250117';

W2.Submit("Johnson", "Week 2 — shipments and payments");
W2.Approve("Williams (CEO)", "Approved");
W2.Post();
Log.Record("Williams", "Approve", "WeeklyPlan", W2.Number, "Week 2 approved");

D2 = Map();
D2["Ship goods to Alpha LLC"]   = True;
D2["Pay supplier MaterialPlus"] = True;
D2["Onboard new sales manager"] = True;
D2["Social media ad campaign"]  = False;  // not done
D2["Warehouse stock count"]     = True;
Log.Record("Marketing", "Postpone", "Task", "Social media ad campaign", "Moved to Week 3");

// ── Week 3 (Jan 20-24) — 60% completion ────────────────────────────
W3 = WorkflowDocument("WeeklyPlan");
W3.Week = 3; W3.Manager = "Johnson";
W3.PeriodStart = '20250120'; W3.PeriodEnd = '20250124';

T3 = W3.TabSection("Tasks", "Name, Owner, Deadline");
R = T3.Add(); R["Name"] = "Negotiate with new supplier";     R["Owner"] = "CEO";       R["Deadline"] = '20250120';
R = T3.Add(); R["Name"] = "Customer order deliveries";       R["Owner"] = "Logistics"; R["Deadline"] = '20250121';
R = T3.Add(); R["Name"] = "Process monthly payroll";         R["Owner"] = "Davis";     R["Deadline"] = '20250122';
R = T3.Add(); R["Name"] = "Update product price list";       R["Owner"] = "Manager";   R["Deadline"] = '20250123';
R = T3.Add(); R["Name"] = "Staff training — CRM system";     R["Owner"] = "HR";        R["Deadline"] = '20250124';

W3.Submit("Johnson", "Week 3 — negotiations and payroll");
W3.Approve("Williams (CEO)", "Approved — focus on supplier negotiations");
W3.Post();
Log.Record("Williams", "Approve", "WeeklyPlan", W3.Number, "Week 3 approved");

D3 = Map();
D3["Negotiate with new supplier"] = True;
D3["Customer order deliveries"]   = True;
D3["Process monthly payroll"]     = True;
D3["Update product price list"]   = False;  // not done
D3["Staff training — CRM system"] = False;  // moved
Log.Record("HR", "Postpone", "Task", "Staff training — CRM system", "Moved to Week 4");

// ── Week 4 (Jan 27-31) — 0% (pending approval) ─────────────────────
W4 = WorkflowDocument("WeeklyPlan");
W4.Week = 4; W4.Manager = "Johnson";
W4.PeriodStart = '20250127'; W4.PeriodEnd = '20250131';

T4 = W4.TabSection("Tasks", "Name, Owner, Deadline");
R = T4.Add(); R["Name"] = "Monthly financial report";         R["Owner"] = "Davis";    R["Deadline"] = '20250128';
R = T4.Add(); R["Name"] = "Prepare February budget";          R["Owner"] = "CFO";      R["Deadline"] = '20250129';
R = T4.Add(); R["Name"] = "Purchase office equipment";        R["Owner"] = "Admin";    R["Deadline"] = '20250130';
R = T4.Add(); R["Name"] = "Meeting with key partners";        R["Owner"] = "CEO";      R["Deadline"] = '20250130';
R = T4.Add(); R["Name"] = "Monthly performance review";       R["Owner"] = "All";      R["Deadline"] = '20250131';

W4.Submit("Johnson", "Final January week — reports and budget");
// CEO has not approved yet — plan is pending
Log.Record("Johnson", "Submit", "WeeklyPlan", W4.Number, "Awaiting CEO approval");

D4 = Map();  // empty — nothing executed yet

// ════════════════════════════════════════════════════════════════════
// PRINT DETAILED PLANS
// ════════════════════════════════════════════════════════════════════
Message("");
Done1 = PrintWeek(W1, D1, "Week 1  (Jan 06–10)");
Message("");
Done2 = PrintWeek(W2, D2, "Week 2  (Jan 13–17)");
Message("");
Done3 = PrintWeek(W3, D3, "Week 3  (Jan 20–24)");
Message("");
Done4 = PrintWeek(W4, D4, "Week 4  (Jan 27–31)");

// ════════════════════════════════════════════════════════════════════
// SUMMARY REPORT — PLAN vs ACTUAL
// ════════════════════════════════════════════════════════════════════
Message("");
Message("══════════════════════════════════════════════════════════════════");
Message("  PLAN vs ACTUAL SUMMARY  ·  Company «Alpha»  ·  January 2025");
Message("══════════════════════════════════════════════════════════════════");
Message(StrTemplate("%-14s│%11s│%10s│%6s│%s", "Week", "Planned", "Done", "%", "Status"));
Message(StrRepeat("─", 58));

TotalPlan = 0; TotalDone = 0;
For Num = 1 To 4 Do
    If Num = 1 Then  Pl = W1; Dn = Done1; Per = "Jan 06-10";  EndIf;
    If Num = 2 Then  Pl = W2; Dn = Done2; Per = "Jan 13-17";  EndIf;
    If Num = 3 Then  Pl = W3; Dn = Done3; Per = "Jan 20-24";  EndIf;
    If Num = 4 Then  Pl = W4; Dn = Done4; Per = "Jan 27-31";  EndIf;
    Tot = Pl.TabSection("Tasks").Count();
    Pct = Dn * 100 / Tot;
    Message(StrTemplate("%-14s│%11s│%10s│%5s%%│ %s",
        "W" + String(Num) + " (" + Per + ")", Tot, Dn, Round(Pct, 0), Pl.StatusLabel("en")));
    TotalPlan = TotalPlan + Tot;
    TotalDone = TotalDone + Dn;
EndDo;

Message(StrRepeat("─", 58));
GrandPct = TotalDone * 100 / TotalPlan;
Message(StrTemplate("%-14s│%11s│%10s│%5s%%│", "TOTAL", TotalPlan, TotalDone, Round(GrandPct, 0)));

Message("");
Message("── Audit trail: " + String(Log.Count()) + " entries ──────────────────────────────────────");
Log.Print(7);

Message("");
Message("══════════════════════════════════════════════════════════════════");
Message("  1S: ERP — 4-Week Planning + Workflow (English) — completed");
Message("══════════════════════════════════════════════════════════════════");
