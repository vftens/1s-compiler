// ═══════════════════════════════════════════════════════════════════════════
// 1S: ERP Free Edition — Управление персоналом: расчёт зарплаты
// Демонстрирует:
//   • Справочники: Подразделения, Должности, Сотрудники
//   • РегистрСведений: оклады сотрудников (периодический)
//   • РегистрНакопления: остатки отпускных дней
//   • Документ «Начисление зарплаты» с НДФЛ и страховыми взносами
//   • Проводки: Дт26/44 Кт70, Дт70 Кт68.1, Дт26/44 Кт69.x, Дт70 Кт51
//   • Отчёты: расчётная ведомость, остатки отпусков, анализ сч.70,
//             нагрузка по подразделениям, штатное расписание (запрос)
// ═══════════════════════════════════════════════════════════════════════════

// ─── Вспомогательные функции ──────────────────────────────────────────────

Функция Округл(Знач Сумма, Знач Знаков = 2)
    Возврат Окр(Сумма, Знаков);
КонецФункции

Функция РассчитатьНДФЛ(Знач База)
    Возврат Округл(База * 0.13);
КонецФункции

Функция РассчитатьВзносы(Знач ФОТ)
    Перем Рез;
    Рез = Новый Структура("ПФР, ФОМС, ФСС, Итого");
    Рез.ПФР   = Округл(ФОТ * 0.22);
    Рез.ФОМС  = Округл(ФОТ * 0.051);
    Рез.ФСС   = Округл(ФОТ * 0.029);
    Рез.Итого = Рез.ПФР + Рез.ФОМС + Рез.ФСС;
    Возврат Рез;
КонецФункции

Функция ФИОСокр(Знач ФИО)
    // «Иванов Иван Иванович» → «Иванов И.И.»
    Перем Части, Рез;
    Части = СтрРазделить(ФИО, " ", Ложь);
    Если Части.Количество() >= 3 Тогда
        Рез = Части[0] + " " + Лев(Части[1], 1) + "." + Лев(Части[2], 1) + ".";
    ИначеЕсли Части.Количество() = 2 Тогда
        Рез = Части[0] + " " + Лев(Части[1], 1) + ".";
    Иначе
        Рез = ФИО;
    КонецЕсли;
    Возврат Рез;
КонецФункции

Функция РабочихДнейВМесяце(Знач ДатаМес)
    // Считаем рабочие дни (пн–пт) в месяце указанной даты
    Перем Д, Начало, Конец, Счёт;
    Начало = НачалоМесяца(ДатаМес);
    Конец  = КонецМесяца(ДатаМес);
    Д      = Начало;
    Счёт   = 0;
    Пока Д <= Конец Цикл
        Если ДеньНедели(Д) <= 5 Тогда
            Счёт = Счёт + 1;
        КонецЕсли;
        Д = ДобавитьДни(Д, 1);
    КонецЦикла;
    Возврат Счёт;
КонецФункции

// ─── Список табельных номеров ─────────────────────────────────────────────

Функция СписокТабН()
    Перем Рез;
    Рез = Новый Массив;
    Рез.Добавить("001");
    Рез.Добавить("002");
    Рез.Добавить("003");
    Рез.Добавить("004");
    Рез.Добавить("005");
    Рез.Добавить("006");
    Рез.Добавить("007");
    Возврат Рез;
КонецФункции

Функция СписокКодовПодразд()
    Перем Рез;
    Рез = Новый Массив;
    Рез.Добавить("ADMIN");
    Рез.Добавить("SALES");
    Рез.Добавить("PROD");
    Рез.Добавить("LOGIST");
    Возврат Рез;
КонецФункции

Функция СотрудникиПодразд(Знач КодПодр)
    Перем Рез, ТабН;
    Рез = Новый Массив;
    Для Каждого ТабН Из СписокТабН() Цикл
        Если Сотрудники[ТабН].Подразделение = КодПодр Тогда
            Рез.Добавить(ТабН);
        КонецЕсли;
    КонецЦикла;
    Возврат Рез;
КонецФункции

// ─── План счетов ──────────────────────────────────────────────────────────

Перем ПС;
ПС = Новый ПланСчетов("ЗарплатныеСчета");

ПС.ДобавитьСчёт("26",   "Общехозяйственные расходы",         "",   Истина, Ложь);
ПС.ДобавитьСчёт("44",   "Расходы на продажу",                 "",   Истина, Ложь);
ПС.ДобавитьСчёт("51",   "Расчётный счёт",                     "",   Истина, Ложь);
ПС.ДобавитьСчёт("68",   "Расчёты по налогам",                 "",   Ложь,   Истина);
ПС.ДобавитьСчёт("68.1", "НДФЛ",                               "68", Ложь,   Истина);
ПС.ДобавитьСчёт("69",   "Страховые взносы",                   "",   Ложь,   Истина);
ПС.ДобавитьСчёт("69.1", "ФСС",                                "69", Ложь,   Истина);
ПС.ДобавитьСчёт("69.2", "ПФР",                                "69", Ложь,   Истина);
ПС.ДобавитьСчёт("69.3", "ФОМС",                               "69", Ложь,   Истина);
ПС.ДобавитьСчёт("70",   "Расчёты с персоналом по оплате труда", "", Ложь,   Истина);

Перем РегБух;
РегБух = Новый РегистрБухгалтерии("ЗарплатаБух", ПС);

// ─── Справочник: Подразделения ────────────────────────────────────────────

Перем Подразделения;
Подразделения = Новый Соответствие;
Подразделения["ADMIN"]  = "Администрация";
Подразделения["SALES"]  = "Отдел продаж";
Подразделения["PROD"]   = "Производство";
Подразделения["LOGIST"] = "Логистика";

// ─── Справочник: Должности ────────────────────────────────────────────────

Перем Должности;
Должности = Новый Соответствие;
Должности["DIR"]       = "Директор";
Должности["CHIEF_ACC"] = "Главный бухгалтер";
Должности["MGR"]       = "Менеджер по продажам";
Должности["TECH"]      = "Технолог";
Должности["DRIVER"]    = "Водитель-экспедитор";
Должности["LOADER"]    = "Грузчик";

// ─── Справочник: Сотрудники ───────────────────────────────────────────────

Перем Сотрудники;
Сотрудники = Новый Соответствие;

Сотрудники["001"] = Новый Структура(
    "ТабНомер, ФИО, Подразделение, Должность",
    "001", "Смирнов Алексей Петрович",    "ADMIN",  "DIR");

Сотрудники["002"] = Новый Структура(
    "ТабНомер, ФИО, Подразделение, Должность",
    "002", "Кузнецова Елена Викторовна",  "ADMIN",  "CHIEF_ACC");

Сотрудники["003"] = Новый Структура(
    "ТабНомер, ФИО, Подразделение, Должность",
    "003", "Попов Дмитрий Сергеевич",     "SALES",  "MGR");

Сотрудники["004"] = Новый Структура(
    "ТабНомер, ФИО, Подразделение, Должность",
    "004", "Фёдорова Мария Андреевна",    "SALES",  "MGR");

Сотрудники["005"] = Новый Структура(
    "ТабНомер, ФИО, Подразделение, Должность",
    "005", "Васильев Николай Иванович",   "PROD",   "TECH");

Сотрудники["006"] = Новый Структура(
    "ТабНомер, ФИО, Подразделение, Должность",
    "006", "Морозов Павел Юрьевич",       "LOGIST", "DRIVER");

Сотрудники["007"] = Новый Структура(
    "ТабНомер, ФИО, Подразделение, Должность",
    "007", "Алексеев Роман Олегович",     "LOGIST", "LOADER");

// ─── Регистр сведений: Оклады ─────────────────────────────────────────────

Перем РегОклады;
РегОклады = Новый РегистрСведений("ОкладыСотрудников", Истина);

Перем Д0;
Д0 = '20200101';

РегОклады.Записать(Новый Структура("ТабНомер", "001"), Новый Структура("Оклад, СчётЗатрат", 120000, "26"), Д0);
РегОклады.Записать(Новый Структура("ТабНомер", "002"), Новый Структура("Оклад, СчётЗатрат",  90000, "26"), Д0);
РегОклады.Записать(Новый Структура("ТабНомер", "003"), Новый Структура("Оклад, СчётЗатрат",  65000, "44"), Д0);
РегОклады.Записать(Новый Структура("ТабНомер", "004"), Новый Структура("Оклад, СчётЗатрат",  65000, "44"), Д0);
РегОклады.Записать(Новый Структура("ТабНомер", "005"), Новый Структура("Оклад, СчётЗатрат",  75000, "26"), Д0);
РегОклады.Записать(Новый Структура("ТабНомер", "006"), Новый Структура("Оклад, СчётЗатрат",  55000, "44"), Д0);
РегОклады.Записать(Новый Структура("ТабНомер", "007"), Новый Структура("Оклад, СчётЗатрат",  45000, "44"), Д0);

// Повышение: Попов с апреля 2025
РегОклады.Записать(Новый Структура("ТабНомер", "003"),
    Новый Структура("Оклад, СчётЗатрат", 75000, "44"),
    '20250401');

// ─── Регистр накопления: Отпускные дни ───────────────────────────────────

Перем РегОтпуск;
РегОтпуск = Новый РегистрНакопления("ОтпускныеДни", "Balance");

// Начисление 28 дней всем сотрудникам на начало 2025
Перем Д2025, ТабН0;
Д2025 = '20250101';
Для Каждого ТабН0 Из СписокТабН() Цикл
    РегОтпуск.Записать(Д2025, "НачислениеОтпуска2025", Истина, 28, ТабН0);
КонецЦикла;

// Использование отпусков
РегОтпуск.Записать('20250414', "ОтпускПопов",     Ложь, 14, "003");
РегОтпуск.Записать('20250602', "ОтпускФёдорова",  Ложь,  7, "004");

// ─── Процедура начисления зарплаты ───────────────────────────────────────

Процедура НачислитьЗарплату(Знач НомерДок, Знач ПериодДок,
                              Знач СпТабН,
                              Знач ФактДниСотр,   // Соответствие: ТабН → дней
                              Знач РабДней)

    Перем ТЗ, Стр, ТабН, Сотр, ОкладРез, Оклад, СчётЗатрат;
    Перем Факт, Начислено, НДФЛ, НаРуки, Взносы;
    Перем ИтФОТ, ИтНДФЛ, ИтНаРуки, ИтВзносы, ДатаВыплаты;

    ТЗ = Новый ТаблицаЗначений;
    ТЗ.Колонки.Добавить("ТабНомер");
    ТЗ.Колонки.Добавить("ФИО");
    ТЗ.Колонки.Добавить("Подразд");
    ТЗ.Колонки.Добавить("Оклад");
    ТЗ.Колонки.Добавить("ОтрДней");
    ТЗ.Колонки.Добавить("Начислено");
    ТЗ.Колонки.Добавить("НДФЛ");
    ТЗ.Колонки.Добавить("НаРуки");

    ИтФОТ    = 0;
    ИтНДФЛ   = 0;
    ИтНаРуки = 0;
    ИтВзносы = 0;

    Для Каждого ТабН Из СпТабН Цикл
        Сотр    = Сотрудники[ТабН];
        ОкладРез = РегОклады.Получить(
            Новый Структура("ТабНомер", ТабН), ПериодДок);
        Оклад       = ОкладРез["Оклад"];
        СчётЗатрат  = ОкладРез["СчётЗатрат"];

        Факт = ФактДниСотр[ТабН];
        Если Факт = Неопределено Тогда
            Факт = РабДней;
        КонецЕсли;

        Начислено = Округл(Оклад * Факт / РабДней);
        НДФЛ      = РассчитатьНДФЛ(Начислено);
        НаРуки    = Начислено - НДФЛ;
        Взносы    = РассчитатьВзносы(Начислено);

        // Строка табличной части
        Стр = ТЗ.Добавить();
        Стр.ТабНомер  = ТабН;
        Стр.ФИО       = Сотр.ФИО;
        Стр.Подразд   = Подразделения[Сотр.Подразделение];
        Стр.Оклад     = Оклад;
        Стр.ОтрДней   = Факт;
        Стр.Начислено = Начислено;
        Стр.НДФЛ      = НДФЛ;
        Стр.НаРуки    = НаРуки;

        // ── Проводки начисления ────────────────────────────────────────────
        // Дт [затраты] Кт 70
        РегБух.Провести(ПериодДок, НомерДок,
            ПС.НайтиПоКоду(СчётЗатрат), ПС.НайтиПоКоду("70"),
            Начислено, "", 0, ТабН, ТабН);
        // Дт 70 Кт 68.1  (НДФЛ)
        РегБух.Провести(ПериодДок, НомерДок,
            ПС.НайтиПоКоду("70"), ПС.НайтиПоКоду("68.1"),
            НДФЛ, "", 0, ТабН, ТабН);
        // Страховые взносы
        РегБух.Провести(ПериодДок, НомерДок,
            ПС.НайтиПоКоду(СчётЗатрат), ПС.НайтиПоКоду("69.1"), Взносы.ФСС);
        РегБух.Провести(ПериодДок, НомерДок,
            ПС.НайтиПоКоду(СчётЗатрат), ПС.НайтиПоКоду("69.2"), Взносы.ПФР);
        РегБух.Провести(ПериодДок, НомерДок,
            ПС.НайтиПоКоду(СчётЗатрат), ПС.НайтиПоКоду("69.3"), Взносы.ФОМС);

        ИтФОТ    = ИтФОТ    + Начислено;
        ИтНДФЛ   = ИтНДФЛ   + НДФЛ;
        ИтНаРуки = ИтНаРуки + НаРуки;
        ИтВзносы = ИтВзносы + Взносы.Итого;
    КонецЦикла;

    // Выплата «на руки» 12-го следующего месяца: Дт 70 Кт 51
    ДатаВыплаты = ДобавитьДни(НачалоМесяца(ДобавитьМесяц(ПериодДок, 1)), 11);
    РегБух.Провести(ДатаВыплаты, НомерДок + "_ВЫП",
        ПС.НайтиПоКоду("70"), ПС.НайтиПоКоду("51"), ИтНаРуки);

    // ── Расчётная ведомость ────────────────────────────────────────────────
    Сообщить("");
    Сообщить("══════════════════════════════════════════════════════════════════");
    Сообщить(СтрШаблон("  РАСЧЁТНАЯ ВЕДОМОСТЬ  %1  |  Рабочих дней: %2",
        НомерДок, РабДней));
    Сообщить("══════════════════════════════════════════════════════════════════");
    Сообщить(СтрШаблон("  %-6s  %-28s  %-10s  %7s  %4s  %7s  %7s  %7s",
        "ТабН", "ФИО", "Подразд.", "Оклад", "Дни",
        "Начисл.", "НДФЛ", "К выдаче"));
    Сообщить("  " + СтрПовтор("─", 84));
    Для Каждого Стр Из ТЗ Цикл
        Сообщить(СтрШаблон("  %-6s  %-28s  %-10s  %7s  %4s  %7s  %7s  %7s",
            Стр.ТабНомер,
            Лев(Стр.ФИО, 28),
            Лев(Стр.Подразд, 10),
            Формат(Стр.Оклад,     "ЧЦ=7; ЧДЦ=0"),
            Формат(Стр.ОтрДней,   "ЧЦ=4; ЧДЦ=0"),
            Формат(Стр.Начислено, "ЧЦ=7; ЧДЦ=0"),
            Формат(Стр.НДФЛ,      "ЧЦ=7; ЧДЦ=0"),
            Формат(Стр.НаРуки,    "ЧЦ=7; ЧДЦ=0")));
    КонецЦикла;
    Сообщить("  " + СтрПовтор("─", 84));
    Сообщить(СтрШаблон("  %-48s  %7s  %7s  %7s",
        "ИТОГО:",
        Формат(ИтФОТ,    "ЧЦ=7; ЧДЦ=0"),
        Формат(ИтНДФЛ,   "ЧЦ=7; ЧДЦ=0"),
        Формат(ИтНаРуки, "ЧЦ=7; ЧДЦ=0")));
    Сообщить(СтрШаблон("  Страховые взносы (работодатель):   %1",
        Формат(ИтВзносы, "ЧЦ=9; ЧДЦ=0")));
    Сообщить(СтрШаблон("  Итого расходы на ФОТ (с взносами): %1",
        Формат(ИтФОТ + ИтВзносы, "ЧЦ=9; ЧДЦ=0")));

КонецПроцедуры

// ─── Начисление за апрель 2025 ────────────────────────────────────────────

Перем ПерАпр, ФактАпр, РабАпр;
ПерАпр = '20250430';
РабАпр = РабочихДнейВМесяце(ПерАпр);   // считаем по календарю

ФактАпр = Новый Соответствие;
ФактАпр["005"] = 19;  // Васильев — 3 дня больничного

НачислитьЗарплату("ЗП-2025-04", ПерАпр, СписокТабН(), ФактАпр, РабАпр);

// ─── Начисление за май 2025 ───────────────────────────────────────────────

Перем ПерМай, ФактМай, РабМай;
ПерМай = '20250531';
РабМай = РабочихДнейВМесяце(ПерМай);

ФактМай = Новый Соответствие;
ФактМай["006"] = 17;  // Морозов — часть мая в отпуске

НачислитьЗарплату("ЗП-2025-05", ПерМай, СписокТабН(), ФактМай, РабМай);

// ─── Отчёт: остатки отпускных дней ───────────────────────────────────────

Перем ДатаОтч;
ДатаОтч = '20250601';

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  ОСТАТКИ ОТПУСКНЫХ ДНЕЙ на 01.06.2025");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  %-6s  %-30s  %8s", "ТабН", "ФИО", "Дней"));
Сообщить("  " + СтрПовтор("─", 48));

Перем ИтДней, ТабНО;
ИтДней = 0;
Для Каждого ТабНО Из СписокТабН() Цикл
    Перем ОстО;
    ОстО = РегОтпуск.Остаток(ДатаОтч, ТабНО);
    Сообщить(СтрШаблон("  %-6s  %-30s  %8s",
        ТабНО,
        Лев(ФИОСокр(Сотрудники[ТабНО].ФИО), 30),
        Формат(ОстО["Resource1"], "ЧЦ=8; ЧДЦ=0")));
    ИтДней = ИтДней + ОстО["Resource1"];
КонецЦикла;

Сообщить("  " + СтрПовтор("─", 48));
Сообщить(СтрШаблон("  %-38s  %8s", "ИТОГО дней:", Формат(ИтДней, "ЧЦ=8; ЧДЦ=0")));

// ─── Отчёт: анализ счёта 70 ───────────────────────────────────────────────

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  АНАЛИЗ СЧЁТА 70 (Расчёты с персоналом по оплате труда)");
Сообщить("══════════════════════════════════════════════════════════════════");

Перем Ост70;
Ост70 = РегБух.Остаток(ПС.НайтиПоКоду("70"));
Сообщить(СтрШаблон("  Дт 70 (выплачено):         %1",  Формат(Ост70["Дт"], "ЧЦ=12; ЧДЦ=2")));
Сообщить(СтрШаблон("  Кт 70 (начислено):         %1",  Формат(Ост70["Кт"], "ЧЦ=12; ЧДЦ=2")));
Сообщить(СтрШаблон("  Остаток (долг работникам): %1",
    Формат(Ост70["Кт"] - Ост70["Дт"], "ЧЦ=12; ЧДЦ=2")));

// ─── Отчёт: нагрузка на ФОТ по подразделениям ────────────────────────────

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  НАГРУЗКА НА ФОТ ПО ПОДРАЗДЕЛЕНИЯМ (апр + май 2025)");
Сообщить("══════════════════════════════════════════════════════════════════");

Перем НачПер, КонПер;
НачПер = '20250401';
КонПер = '20250531';

Перем ФОТПодр, КодП;
ФОТПодр = Новый Соответствие;
Для Каждого КодП Из СписокКодовПодразд() Цикл
    Перем СпСотр, ТабН2, ОкРез2, СчЗ, Об2;
    ФОТПодр[КодП] = 0;
    СпСотр = СотрудникиПодразд(КодП);
    Для Каждого ТабН2 Из СпСотр Цикл
        ОкРез2 = РегОклады.Получить(Новый Структура("ТабНомер", ТабН2), КонПер);
        СчЗ    = ОкРез2["СчётЗатрат"];
        Об2    = РегБух.Оборот(ПС.НайтиПоКоду(СчЗ), НачПер, КонПер, ТабН2);
        ФОТПодр[КодП] = ФОТПодр[КодП] + Об2["ОборотДт"];
    КонецЦикла;
КонецЦикла;

Сообщить(СтрШаблон("  %-22s  %14s", "Подразделение", "Расходы на ФОТ"));
Сообщить("  " + СтрПовтор("─", 38));
Перем ИтФОТВсего, КодП2;
ИтФОТВсего = 0;
Для Каждого КодП2 Из СписокКодовПодразд() Цикл
    Сообщить(СтрШаблон("  %-22s  %14s",
        Подразделения[КодП2],
        Формат(ФОТПодр[КодП2], "ЧЦ=14; ЧДЦ=0")));
    ИтФОТВсего = ИтФОТВсего + ФОТПодр[КодП2];
КонецЦикла;
Сообщить("  " + СтрПовтор("─", 38));
Сообщить(СтрШаблон("  %-22s  %14s", "ИТОГО:", Формат(ИтФОТВсего, "ЧЦ=14; ЧДЦ=0")));

// ─── Запрос: штатное расписание ───────────────────────────────────────────

Перем ТЗШтат;
ТЗШтат = Новый ТаблицаЗначений;
ТЗШтат.Колонки.Добавить("ТабНомер");
ТЗШтат.Колонки.Добавить("ФИО");
ТЗШтат.Колонки.Добавить("Подразделение");
ТЗШтат.Колонки.Добавить("Должность");
ТЗШтат.Колонки.Добавить("Оклад");

Перем СтрШт, ТабНШт;
Для Каждого ТабНШт Из СписокТабН() Цикл
    Перем СотрШт, ОкШт;
    СотрШт = Сотрудники[ТабНШт];
    ОкШт   = РегОклады.Получить(Новый Структура("ТабНомер", ТабНШт), КонПер);
    СтрШт  = ТЗШтат.Добавить();
    СтрШт.ТабНомер      = ТабНШт;
    СтрШт.ФИО           = СотрШт.ФИО;
    СтрШт.Подразделение = Подразделения[СотрШт.Подразделение];
    СтрШт.Должность     = Должности[СотрШт.Должность];
    СтрШт.Оклад         = ОкШт["Оклад"];
КонецЦикла;

Перем ЗапрШт;
ЗапрШт = Новый Запрос("
|SELECT Подразделение, ФИО, Должность, Оклад
|FROM ТЗШтат
|ORDER BY Подразделение ASC, Оклад DESC");
ЗапрШт.УстановитьПараметр("ТЗШтат", ТЗШтат);

Перем РезШт;
РезШт = ЗапрШт.Выполнить().Выгрузить();

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  ШТАТНОЕ РАСПИСАНИЕ (май 2025)");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  %-15s  %-28s  %-22s  %8s",
    "Подразделение", "ФИО", "Должность", "Оклад"));
Сообщить("  " + СтрПовтор("─", 80));

Перем СтрВыб;
Для Каждого СтрВыб Из РезШт Цикл
    Сообщить(СтрШаблон("  %-15s  %-28s  %-22s  %8s",
        Лев(СтрВыб["Подразделение"], 15),
        Лев(СтрВыб["ФИО"], 28),
        Лев(СтрВыб["Должность"], 22),
        Формат(СтрВыб["Оклад"], "ЧЦ=8; ЧДЦ=0")));
КонецЦикла;

