// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — ДЕМО: Workflow Dashboard с ASCII-графиками (RU)
// ══════════════════════════════════════════════════════════════════════

Функция Бар(Проц, Ш)
    Зап = Окр(Проц * Ш / 100, 0);
    Пуст = Ш - Зап;
    Возврат СтрПовтор("█", Зап) + СтрПовтор("░", Пуст);
КонецФункции;

Функция Метка(Стат)
    Если Стат = "posted"   Тогда  Возврат "OK";  КонецЕсли;
    Если Стат = "pending"  Тогда  Возврат "..";  КонецЕсли;
    Если Стат = "rejected" Тогда  Возврат "XX";  КонецЕсли;
    Если Стат = "approved" Тогда  Возврат "++";  КонецЕсли;
    Возврат "??";
КонецФункции;

ЖА = АудитЖурнал("Dashboard");

Д1 = ДокументСМаршрутом("ЗакупЗаявка");  Д1.Название = "Закупка оргтехники";        Д1.Сумма = 45000;
Д1.Подать("Иванов","Прошу согласовать"); Д1.Согласовать("Козлов","Согласовано"); Д1.Провести();

Д2 = ДокументСМаршрутом("ЗакупЗаявка");  Д2.Название = "Ремонт склада";              Д2.Сумма = 120000;
Д2.Подать("Бондаренко","Капремонт"); Д2.Согласовать("Козлов","Бюджет в норме"); Д2.Провести();

Д3 = ДокументСМаршрутом("Договор");      Д3.Название = "Договор с ООО МатПлюс";      Д3.Сумма = 280000;
Д3.Подать("Петрова","Договор на год"); Д3.НаДоработку("Юрист","Уточнить п.3.2");
Д3.Переподать("Петрова","Исправлен п.3.2"); Д3.Согласовать("Козлов","Утверждён"); Д3.Провести();
ЖА.Записать("Юрист","Правка","Договор",Д3.Номер,"Юр.правка п.3.2");

Д4 = ДокументСМаршрутом("Накладная");    Д4.Название = "Реализация ООО «Альфа»";     Д4.Сумма = 95000;
Д4.Подать("Склад","РН реализация"); Д4.Согласовать("Козлов","OK"); Д4.Провести();

Д5 = ДокументСМаршрутом("Накладная");    Д5.Название = "Реализация ООО «Бета»";      Д5.Сумма = 67000;
Д5.Подать("Склад","РН 2"); Д5.Отклонить("Финансист","Превышен лимит дебиторки");
ЖА.Записать("Финансист","Отклонить","РН",Д5.Номер,"Лимит дебиторки");

Д6 = ДокументСМаршрутом("Отпуск");       Д6.Название = "Отпуск Иванова 10 дней";     Д6.Сумма = 0;
Д6.Подать("Иванов","01-10.03.2025"); Д6.Согласовать("Козлов","Согласовано"); Д6.Провести();

Д7 = ДокументСМаршрутом("Командировка"); Д7.Название = "Командировка в Санкт-Петербург"; Д7.Сумма = 12000;
Д7.Подать("Бондаренко","Логистич. выставка");

Д8 = ДокументСМаршрутом("ДоговорАренды"); Д8.Название = "Аренда склада — пролонгация"; Д8.Сумма = 35000;
Д8.Подать("Петрова","Продление договора");

Документы = Массив();
Документы.Добавить(Д1); Документы.Добавить(Д2); Документы.Добавить(Д3); Документы.Добавить(Д4);
Документы.Добавить(Д5); Документы.Добавить(Д6); Документы.Добавить(Д7); Документы.Добавить(Д8);
ВсегоДок = 8;

КЧерн = 0; КОжид = 0; КСогл = 0; КПров = 0; КОтк = 0;
СумПров = 0; СумОжид = 0;
Для Каждого Дк Из Документы Цикл
    Стат = Дк.Статус;
    Если Стат = "draft"    Тогда  КЧерн = КЧерн + 1;
    ИначеЕсли Стат = "pending"  Тогда  КОжид = КОжид + 1; СумОжид = СумОжид + Дк.Сумма;
    ИначеЕсли Стат = "approved" Тогда  КСогл = КСогл + 1;
    ИначеЕсли Стат = "posted"   Тогда  КПров = КПров + 1; СумПров = СумПров + Дк.Сумма;
    ИначеЕсли Стат = "rejected" Тогда  КОтк  = КОтк  + 1;
    КонецЕсли;
КонецЦикла;

Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("                  WORKFLOW DASHBOARD  ·  ООО «Альфа»");
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("");
Сообщить("── Состояние документов ─────────────────────────────────────────────");
Сообщить("");

Перем П, К, Н;
К = КПров;   П = Окр(К*100/ВсегоДок,0); Н = "Проведено  ";
Сообщить(СтрШаблон("  [OK] %1  %2  %3 (%4%%)", Н, Бар(П,30), К, П));
К = КОжид;   П = Окр(К*100/ВсегоДок,0); Н = "На согласов.";
Сообщить(СтрШаблон("  [..] %1  %2  %3 (%4%%)", Н, Бар(П,30), К, П));
К = КСогл;   П = Окр(К*100/ВсегоДок,0); Н = "Согласовано ";
Сообщить(СтрШаблон("  [++] %1  %2  %3 (%4%%)", Н, Бар(П,30), К, П));
К = КОтк;    П = Окр(К*100/ВсегоДок,0); Н = "Отклонено   ";
Сообщить(СтрШаблон("  [XX] %1  %2  %3 (%4%%)", Н, Бар(П,30), К, П));
К = КЧерн;   П = Окр(К*100/ВсегоДок,0); Н = "Черновик    ";
Сообщить(СтрШаблон("  [??] %1  %2  %3 (%4%%)", Н, Бар(П,30), К, П));

Сообщить("");
Сообщить(СтрШаблон("  Всего: %1  |  Проведено: %2 руб.  |  В ожидании: %3 руб.",
    ВсегоДок, Формат(СумПров,"ЧДЦ=0"), Формат(СумОжид,"ЧДЦ=0")));
Сообщить("");
Сообщить("── Лента документов ─────────────────────────────────────────────────");
Сообщить("");

Для Каждого Дк Из Документы Цикл
    М = Метка(Дк.Статус);
    Стр = СтрШаблон("  [%1] №%2  %-42s", М, Дк.Номер, Дк.Название);
    Если Дк.Сумма > 0 Тогда  Стр = Стр + "  " + Формат(Дк.Сумма,"ЧДЦ=0") + " руб.";  КонецЕсли;
    Сообщить(Стр);
    Для Каждого Зп Из Дк.Журнал Цикл
        Сообщить(СтрШаблон("       └─ %1 → %2  (%3)",
            WF.label(Зп.from_status,"ru"), WF.label(Зп.to_status,"ru"), Зп.actor));
    КонецЦикла;
    Сообщить("");
КонецЦикла;

Сообщить("── KPI метрики ──────────────────────────────────────────────────────");
ВЭф = Окр(КПров*100/ВсегоДок,0); ВСг = Окр((КПров+КСогл)*100/ВсегоДок,0); ВОтк = Окр(КОтк*100/ВсегоДок,0);
Сообщить(СтрШаблон("  Эффективность:         %1  %2%%", Бар(ВЭф, 20),  ВЭф));
Сообщить(СтрШаблон("  Уровень согласования:  %1  %2%%", Бар(ВСг, 20),  ВСг));
Сообщить(СтрШаблон("  Уровень отклонений:    %1  %2%%", Бар(ВОтк, 20), ВОтк));
Сообщить(СтрШаблон("  Записей аудита:         %1", ЖА.Количество()));
Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("  1S: ERP — Workflow Dashboard (русский) — завершено");
Сообщить("══════════════════════════════════════════════════════════════════════");
