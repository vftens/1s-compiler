// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Маршрут согласования (Workflow / БПМ)
// Сценарий: менеджер создаёт заявку → бухгалтер → директор утверждает
// ══════════════════════════════════════════════════════════════════════

Функция Статус(Назв, Стат)
    Сообщить(СтрШаблон("  [%1]  Статус: %2", Назв, Стат));
КонецФункции;

Функция Событие(Действие, Кто, Комм)
    Сообщить(СтрШаблон("  >  %1 -> %2   «%3»", Действие, Кто, Комм));
КонецФункции;

// ── Справочники ──────────────────────────────────────────────────────
Поставщики = Справочник("Поставщики");
МатПлюс    = Поставщики.Создать("П001", "ООО «МатериалПлюс»");

Товары = Справочник("Номенклатура");
Бумага = Товары.Создать("Т001", "Бумага A4, 500 л.");
Бумага.Цена = 120;

// ── Журнал аудита ─────────────────────────────────────────────────────
Журнал = АудитЖурнал("Закупки");

// ══════════════════════════════════════════════════════════════════════
Сообщить("══════════════════════════════════════════════════════════════");
Сообщить("  МАРШРУТ СОГЛАСОВАНИЯ ЗАКУПКИ  ·  Предприятие «Альфа»");
Сообщить("══════════════════════════════════════════════════════════════");

// ── Шаг 1: Менеджер создаёт заявку ───────────────────────────────────
Сообщить("");
Сообщить("── ШАГ 1: Менеджер Иванов создаёт заявку на закупку ──────────");

ЗЗ = ДокументСМаршрутом("ЗаявкаЗакупки");
ЗЗ.Дата         = '20250120';
ЗЗ.Поставщик    = МатПлюс;
ЗЗ.Менеджер     = "Иванов О.М.";

Строки = ЗЗ.ТабличнаяЧасть("Товары", "Товар, Количество, Цена, Сумма");
С = Строки.Добавить();
С["Товар"]      = Бумага.Наименование;
С["Количество"] = 50;
С["Цена"]       = Бумага.Цена;
С["Сумма"]      = 50 * Бумага.Цена;

СуммаЗЗ = Строки.Итог("Сумма");
Журнал.Записать("Иванов", "Создание", "ЗаявкаЗакупки", ЗЗ.Номер,
    "Заявка на " + Строка(СуммаЗЗ) + " руб.");

Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("ru"));
Сообщить(СтрШаблон("  Поставщик: %1  |  Сумма: %2 руб.", ЗЗ.Поставщик, СуммаЗЗ));

// ── Шаг 2: Подача на согласование ────────────────────────────────────
Сообщить("");
Сообщить("── ШАГ 2: Подача на согласование бухгалтеру ──────────────────");

ЗЗ.Подать("Иванов", "Прошу согласовать — срочная потребность");
Журнал.Записать("Иванов", "Подать", "ЗаявкаЗакупки", ЗЗ.Номер, "Подано на согласование");
Событие("Подано", "Иванов", "Прошу согласовать — срочная потребность");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("ru"));

// ── Шаг 3: Бухгалтер отправляет на доработку ─────────────────────────
Сообщить("");
Сообщить("── ШАГ 3: Бухгалтер Петрова — требует уточнения ─────────────");

ЗЗ.НаДоработку("Петрова", "Укажите счёт затрат и центр затрат");
Журнал.Записать("Петрова", "НаДоработку", "ЗаявкаЗакупки", ЗЗ.Номер, "Возврат: нет реквизитов");
Событие("На доработку", "Петрова", "Укажите счёт затрат и центр затрат");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("ru"));

// ── Шаг 4: Менеджер исправляет и переподаёт ──────────────────────────
Сообщить("");
Сообщить("── ШАГ 4: Иванов добавляет реквизиты и переподаёт ───────────");

ЗЗ.СчётЗатрат = "26 Общехозяйственные расходы";
ЗЗ.ЦентрЗатрат = "ЦЗ-001 Офис";
ЗЗ.Переподать("Иванов", "Добавил счёт затрат и центр затрат");
Журнал.Записать("Иванов", "Переподать", "ЗаявкаЗакупки", ЗЗ.Номер, "Исправлено и переподано");
Событие("Переподано", "Иванов", "Добавил счёт затрат и центр затрат");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("ru"));

// ── Шаг 5: Директор согласовывает ────────────────────────────────────
Сообщить("");
Сообщить("── ШАГ 5: Директор Козлов согласовывает ─────────────────────");

ЗЗ.Согласовать("Козлов (Директор)", "Согласовано. Сумма в рамках бюджета.");
Журнал.Записать("Козлов", "Согласовать", "ЗаявкаЗакупки", ЗЗ.Номер, "Согласовано директором");
Событие("Согласовано", "Козлов", "Согласовано. Сумма в рамках бюджета.");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("ru"));

// ── Шаг 6: Автоматическое проведение ──────────────────────────────────
Сообщить("");
Сообщить("── ШАГ 6: Автоматическое проведение после согласования ───────");

ЗЗ.Провести();
Журнал.Записать("Система", "Провести", "ЗаявкаЗакупки", ЗЗ.Номер, "Авто-проведён после согласования");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("ru"));
Сообщить(СтрШаблон("  Документ проведён: %1", ЗЗ.Проведён ? "ДА" : "НЕТ"));

// ── Полный журнал переходов ───────────────────────────────────────────
Сообщить("");
Сообщить("── ЖУРНАЛ МАРШРУТА ───────────────────────────────────────────");
ЗЗ.ВыводЖурнала("ru");

// ── Журнал аудита ─────────────────────────────────────────────────────
Сообщить("");
Сообщить("── ЖУРНАЛ АУДИТА ─────────────────────────────────────────────");
Сообщить(СтрШаблон("  Всего записей: %1", Журнал.Количество()));
Журнал.Вывести(10);

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════");
Сообщить("  1S: ERP — Маршрут согласования (русский) — завершено");
Сообщить("══════════════════════════════════════════════════════════════");
