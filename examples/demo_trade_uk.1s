// =============================================================================
// ДЕМО: Торгова мережа — Sprint 10 ERP (Українська мова)
// Цикл: ОргСтруктура → Бюджет → Закупівлі → 3-стороннє зіставлення → Зарплата
// =============================================================================

Повідомити("=== 1S ERP Sprint 10 — Торгова мережа ===");
Повідомити("");

// ── 1. ГАЛУЗЕВИЙ ПРОФІЛЬ ─────────────────────────────────────────────────────
Повідомити("── 1. Завантаження галузевого профілю ──");
Профіль = ЗавантажитиПрофіль("trade");
Повідомити("Профіль: " + Профіль.Назва);
Повідомити("Профіль податку: " + Профіль.ПрофільПодатку);
Повідомити("");

// ── 2. ОРГАНІЗАЦІЙНА СТРУКТУРА ───────────────────────────────────────────────
Повідомити("── 2. Організаційна структура ──");
Орг = ОрганізаційнаСтруктура("ТОВ Маркет Плюс");
Орг.ДодатиВузол("юо1",  "ТОВ Маркет Плюс Київ",  "legal_entity", "root");
Орг.ДодатиВузол("маг1", "Магазин №1 (Хрещатик)", "plant",         "юо1");
Орг.ДодатиВузол("маг2", "Магазин №2 (Оболонь)",  "plant",         "юо1");
Орг.ДодатиВузол("відд1","Відділ закупівель",      "department",    "юо1");
Орг.ДодатиВузол("мвв1", "МВВ: Роздрібна торгівля", "cost_center",  "маг1");
Повідомити(Орг.Звіт());
Повідомити("");

// ── 3. МАРШРУТ ПОГОДЖЕННЯ ────────────────────────────────────────────────────
Повідомити("── 3. Маршрут погодження (YAML) ──");
Маршрут = НалаштуванняМаршруту.Завантажити("profiles/workflow/default.yaml");
Мала   = Маршрут.ОтриматиЗатверджуючих("purchase_order", 30000);
Велика = Маршрут.ОтриматиЗатверджуючих("purchase_order", 600000);
Повідомити("Замовлення 30 000 грн  → " + Рядок(Мала));
Повідомити("Замовлення 600 000 грн → " + Рядок(Велика));
Повідомити("");

// ── 4. КОНТРОЛЬ БЮДЖЕТУ ──────────────────────────────────────────────────────
Повідомити("── 4. Контроль бюджету ──");
Бюджет = КонтрольБюджету(Хибно, 0.9);    // м'яке попередження, не жорсткий стоп
Бюджет.Виділити("мвв1", "2024-01", "закупівлі", 2000000);
Повідомити("Бюджет МВВ: закупівлі = 2 000 000 грн");
Повідомити("");

// ── 5. ЗАКУПІВЛЯ ТОВАРІВ ─────────────────────────────────────────────────────
Повідомити("── 5. Закупівля товарів ──");
Постач1 = Постачальник("П-КА-001", "ТОВ КіївАгро", 4.5, 14);
ЗЗ1 = ЗамовленняПостачальнику("ЗЗ-2024-050", Постач1);
ЗЗ1.ДодатиРядок("ТВ-01", "Томати черрі 1кг", 500, 85, "кг");
ЗЗ1.ДодатиРядок("ОГ-02", "Огірки свіжі 1кг", 300, 45, "кг");
ЗЗ1.ДодатиРядок("ЗЛ-03", "Зелень асорті", 100, 30, "кг");

Зарезерв = Бюджет.Зарезервувати("мвв1", "2024-01", ЗЗ1.Підсумок, ЗЗ1.Номер, "закупівлі");
Якщо Зарезерв Тоді
    Повідомити("Бюджет зарезервовано: " + Рядок(ЗЗ1.Підсумок) + " грн");
    ЗЗ1.submit("Іваненко О.П.", "Тижнева поставка");
    ЗЗ1.approve("Ткаченко В.М.");
    Повідомити("Статус: " + ЗЗ1.status);
КінецьЯкщо;
Повідомити("");

// ── 6. ПРИХІДНА НАКЛАДНА ─────────────────────────────────────────────────────
Повідомити("── 6. Прихідна накладна ──");
ПН1 = ПрибутковаНакладна("ПН-2024-0199", ЗЗ1);
ПН1.ДодатиПрихід("ТВ-01", "Томати черрі", 500, 85);
ПН1.ДодатиПрихід("ОГ-02", "Огірки свіжі", 300, 45);
ПН1.ДодатиПрихід("ЗЛ-03", "Зелень асорті", 98, 30);    // 98 із 100 кг
ПН1.submit("склад");
ПН1.approve("зав.складом");
ПН1.post("склад");
Повідомити("Прихід: " + ПН1.number + " | статус: " + ПН1.status);
Повідомити("");

// ── 7. РАХУНОК ПОСТАЧАЛЬНИКА ─────────────────────────────────────────────────
Повідомити("── 7. Тристороннє зіставлення ──");
РахП = РахунокПостачальника("РП-2024-1133", "ТОВ КіївАгро");
РахП.ДодатиРядок("ТВ-01", "Томати черрі", 500, 85);
РахП.ДодатиРядок("ОГ-02", "Огірки свіжі", 300, 46);    // ціна вища на 2.2%
РахП.ДодатиРядок("ЗЛ-03", "Зелень асорті", 98, 30);

// Допуск за ціною торгівля = 1% (жорсткіший ніж виробництво)
Зіставл = ТристороннєЗіставлення();
Зіставл.Налаштувати(2, 1, Хибно);   // qty=±2%, price=±1%, м'який стоп
Результат = Зіставл.Зіставити(ЗЗ1, ПН1, РахП);
Повідомити(Результат.Звіт("uk"));

// Відповідь ОГ-02 буде MISMATCH (ціна +2.2% > допуск 1%)
Якщо Результат.Заблокировано Тоді
    Повідомити("УВАГА: Оплата заблокована — розбіжності перевищують допуск");
Інакше
    Повідомити("Рахунок прийнятий до оплати");
    Бюджет.Спожити("мвв1", "2024-01", РахП.Підсумок, РахП.Номер, "закупівлі");
КінецьЯкщо;
Повідомити("Залишок бюджету: " + Рядок(Бюджет.Залишок("мвв1", "2024-01", "закупівлі").Доступно) + " грн");
Повідомити("");

// ── 8. РОЗРАХУНОК ЗАРПЛАТИ (ПРОФІЛЬ ua_2024) ─────────────────────────────────
Повідомити("── 8. Розрахунок зарплати ──");
ПодДвиж = ПодатковийДвижок();
РозрЗП = РозрахунокЗарплати(ПодДвиж);

Пр1 = Працівник("П001", "Шевченко Оксана Іванівна", "Продавець-консультант", 28000, "ua_2024");
Пр2 = Працівник("П002", "Кравченко Михайло Олегович", "Менеджер торгового залу", 42000, "ua_2024");
Пр3 = Працівник("П003", "Бондаренко Тетяна Андріївна", "Касир", 25000, "ua_2024");
РозрЗП.ДодатиПрацівника(Пр1);
РозрЗП.ДодатиПрацівника(Пр2);
РозрЗП.ДодатиПрацівника(Пр3);

// Кравченко хворів 3 дні
РозрЗП.ДодатиВідсутність("П002", "sick", 3, "2024-01");
// Шевченко — премія 10%
Прем = Премія("Торгова премія", "percent", 0.10);
РозрЗП.ДодатиПремію("П001", Прем);

Результати = РозрЗП.Розрахувати("2024-01");
Повідомити(РозрЗП.ВідомістьЗарплати(Результати, "uk"));
Повідомити("");

// Розрахунковий лист Шевченко
Для Кожного Рез Из Результати Цикл
    Якщо Рез.Employee.Id = "П001" Тоді
        Лист = РозрЗП.СформуватиРозрахунковийЛист(Рез, "uk");
        Повідомити(Лист.Сформувати("uk"));
    КінецьЯкщо;
КонецЦикла;
Повідомити("");

// ── ПІДСУМОК ─────────────────────────────────────────────────────────────────
Повідомити("=== SPRINT 10 ЗАВЕРШЕНО ===");
Повідомити("✓ Організаційна структура торгової мережі");
Повідомити("✓ Бюджетний контроль (м'яке попередження)");
Повідомити("✓ Тристороннє зіставлення з допуском 1% за ціною");
Повідомити("✓ Розрахунок зарплати з профілем ua_2024 (ПДФО+ЄСВ+ВЗ)");
Повідомити("✓ Галузевий профіль: торгівля");
