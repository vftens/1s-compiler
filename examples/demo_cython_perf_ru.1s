// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Cython Performance Demo (Русский)
// Генерация: python -m src.cli cython-gen examples/demo_cython_perf_ru.1s
// Сборка:    python -m src.cli cython-build examples/demo_cython_perf_ru.1s --run
// ══════════════════════════════════════════════════════════════════════

Сообщить("══════════════════════════════════════════════════════════════");
Сообщить("  CYTHON PERFORMANCE DEMO  ·  1S: ERP  ·  Русский");
Сообщить("══════════════════════════════════════════════════════════════");
Сообщить("");

// Тест 1: Числа Фибоначчи — итеративно
Перем А, Б, Тем, К, МодМ;
А = 0; Б = 1; Тем = 0; МодМ = 1000000007;
Нач = ВремяСейчас();
Для К = 1 По 1000000 Цикл  Тем = (А + Б) % МодМ; А = Б; Б = Тем;  КонецЦикла;
Вр1 = Окр((ВремяСейчас() - Нач) * 1000, 2);
Сообщить("── Тест 1: 1 000 000 итераций Фибоначчи ──────────────────────────");
Сообщить(СтрШаблон("  Пара (А,Б): (%1, %2)   Python: %3 мс", А, Б, Вр1));
Сообщить("  Cython cdef long А,Б,Тем,К → ожидаемо ~0.5-2 мс (10-50×)");
Сообщить("");

// Тест 2: Сумма квадратов
Перем Сумма, Н;
Сумма = 0;
Нач = ВремяСейчас();
Для Н = 1 По 500000 Цикл  Сумма = Сумма + Н * Н;  КонецЦикла;
Вр2 = Окр((ВремяСейчас() - Нач) * 1000, 2);
Сообщить("── Тест 2: Σ(N²) для N=1..500 000 ──────────────────────────────");
Сообщить(СтрШаблон("  Сумма: %1   Python: %2 мс", Сумма, Вр2));
Сообщить("  Cython cdef long Сумма=0,Н=0 → ожидаемо ~0.3-1 мс (15-60×)");
Сообщить("");

// Тест 3: Решето Эратосфена
Перем МаксН, КолПрост, М;
МаксН = 100000; КолПрост = 0;
Решето = Массив();
Для К = 0 По МаксН Цикл  Решето.Добавить(Истина);  КонецЦикла;
Нач = ВремяСейчас();
Для К = 2 По МаксН Цикл
    Если Решето[К] = Истина Тогда
        КолПрост = КолПрост + 1;
        М = К + К;
        Пока М <= МаксН Цикл  Решето.Установить(М, Ложь); М = М + К;  КонецЦикла;
    КонецЕсли;
КонецЦикла;
Вр3 = Окр((ВремяСейчас() - Нач) * 1000, 2);
Сообщить("── Тест 3: Решето простых до 100 000 ───────────────────────────");
Сообщить(СтрШаблон("  Простых: %1   Python: %2 мс", КолПрост, Вр3));
Сообщить("  Cython cdef long МаксН=0,КолПрост=0,К=0,М=0 → ~1-3 мс (10-30×)");
Сообщить("");

// Тест 4: π методом Монте-Карло (cdef double)
Перем Шагов, Попаданий, Зерно;
Перем Икс, Игрек;
Шагов = 0; Попаданий = 0; Зерно = 123456789;
Нач = ВремяСейчас();
Для К = 1 По 100000 Цикл
    Зерно = (Зерно * 1664525 + 1013904223) % 2147483647;
    Икс   = Зерно / 2147483647.0;
    Зерно = (Зерно * 1664525 + 1013904223) % 2147483647;
    Игрек = Зерно / 2147483647.0;
    Если Икс * Икс + Игрек * Игрек <= 1.0 Тогда  Попаданий = Попаданий + 1;  КонецЕсли;
    Шагов = Шагов + 1;
КонецЦикла;
Вр4 = Окр((ВремяСейчас() - Нач) * 1000, 2);
Пи = Попаданий / Шагов * 4;

Сообщить("── Тест 4: π методом Монте-Карло (100 000 точек) ───────────────");
Сообщить(СтрШаблон("  π ≈ %1   Python: %2 мс", Формат(Пи,"ЧДЦ=6"), Вр4));
Сообщить("  Cython cdef double Икс=0.0,Игрек=0.0 → ~1-4 мс (8-20×)");
Сообщить("");

ЗагПy = Окр(Вр1 + Вр2 + Вр3 + Вр4, 1);
Сообщить("── Итог и инструкция ────────────────────────────────────────────");
Сообщить(СтрШаблон("  Общее время Python: %1 мс", ЗагПy));
Сообщить("  Генерация .pyx:  python -m src.cli cython-gen  examples/demo_cython_perf_ru.1s");
Сообщить("  Сборка + запуск: python -m src.cli cython-build examples/demo_cython_perf_ru.1s --run");
Сообщить("");
Сообщить("  Переменные Cython для этого скрипта:");
Сообщить("    cdef long  А,Б,Тем,К,Сумма,Н,МаксН,КолПрост,М,Шагов,Попаданий,Зерно");
Сообщить("    cdef double Икс, Игрек, Пи");
Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════");
Сообщить("  1S: ERP — Cython Performance Demo (Russian) — завершено");
Сообщить("══════════════════════════════════════════════════════════════");
