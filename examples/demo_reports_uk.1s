// Демо: Фінансова звітність — Звіт про фінансові результати + YTD (UA)
// Демонструє місячний та накопичувальний (YTD) режими.

Звітник = НовийЗвітник();

// ── Місячний звіт ─────────────────────────────────────────────────────────────
Повідомити("=== Звіт про фінансові результати — липень 2026 ===");

ЗФР = Звітник.ЗвітПроПрибутки("2026-07");

Повідомити("Дохід:              " + Рядок(ЗФР.Дохід));
Повідомити("Валовий прибуток:   " + Рядок(ЗФР.ВаловийПрибуток));
Повідомити("Чистий прибуток:    " + Рядок(ЗФР.ЧистийПрибуток));

// ── YTD (наростаючим підсумком) ───────────────────────────────────────────────
Повідомити("");
Повідомити("=== Звіт про фінансові результати — Січень–Липень 2026 (YTD) ===");

ЗФР_YTD = Звітник.ЗвітПроПрибутки("2026-07", "ytd");

Повідомити("Дохід (YTD):            " + Рядок(ЗФР_YTD.Дохід));
Повідомити("Валовий прибуток (YTD): " + Рядок(ЗФР_YTD.ВаловийПрибуток));
Повідомити("Чистий прибуток (YTD):  " + Рядок(ЗФР_YTD.ЧистийПрибуток));

// ── Порівняння місяць vs YTD ──────────────────────────────────────────────────
Повідомити("");
Повідомити("--- Порівняння ---");
Повідомити("Частка липня у YTD-доході: " + Рядок(ЗФР.Дохід) + " / " + Рядок(ЗФР_YTD.Дохід));
