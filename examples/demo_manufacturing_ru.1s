// =============================================================================
// ДЕМО: Станкостроительный завод — Sprint 10 ERP (Русский язык)
// Цикл: ОргСтруктура → Бюджет → Закупки → 3-сторонее сопоставление → Зарплата
// =============================================================================

Сообщить("=== 1S ERP Sprint 10 — Станкостроительный завод ===");
Сообщить("");

// ── 1. ОТРАСЛЕВОЙ ПРОФИЛЬ ───────────────────────────────────────────────────
Сообщить("── 1. Загрузка отраслевого профиля ──");
Профиль = ЗагрузитьПрофиль("manufacturing");
Сообщить("Профиль: " + Профиль.Наименование);
Сообщить("Налоговый профиль: " + Профиль.ПрофильНалога);
Сообщить("");

// ── 2. ОРГАНИЗАЦИОННАЯ СТРУКТУРА ────────────────────────────────────────────
Сообщить("── 2. Организационная структура ──");
Орг = ОрганизационнаяСтруктура("ООО СтанкоМаш");
Орг.ДобавитьУзел("ле1",  "ООО СтанкоМаш Москва",  ЮРИДИЧЕСКОЕ_ЛИЦО, "root");
Орг.ДобавитьУзел("зав1", "Завод №1 (Москва)",      ЗАВОД,            "ле1");
Орг.ДобавитьУзел("цех1", "Цех станочного оборудования", ОТДЕЛ,       "зав1");
Орг.ДобавитьУзел("цех2", "Цех сборки",             ОТДЕЛ,            "зав1");
Орг.ДобавитьУзел("мвз1", "МВЗ: Производство",      МВЗ,              "зав1");
Сообщить(Орг.Отчет());
Сообщить("");

// ── 3. МАРШРУТ УТВЕРЖДЕНИЯ (WorkflowConfig) ──────────────────────────────────
Сообщить("── 3. Маршрут утверждения (YAML) ──");
Маршрут = НастройкиМаршрута.Загрузить("profiles/workflow/manufacturing.yaml");
ЗаявкаМалая   = Маршрут.ПолучитьУтверждающих("purchase_order", 45000);
ЗаявкаСредняя = Маршрут.ПолучитьУтверждающих("purchase_order", 750000);
ЗаявкаКрупная = Маршрут.ПолучитьУтверждающих("purchase_order", 2000000);
Сообщить("Заказ 45 000 ₽   → " + Строка(ЗаявкаМалая));
Сообщить("Заказ 750 000 ₽  → " + Строка(ЗаявкаСредняя));
Сообщить("Заказ 2 000 000 ₽ → " + Строка(ЗаявкаКрупная));
Сообщить("");

// ── 4. КОНТРОЛЬ БЮДЖЕТА ─────────────────────────────────────────────────────
Сообщить("── 4. Контроль бюджета ──");
Бюджет = КонтрольБюджета(Истина, 0.85);
Бюджет.Выделить("мвз1", "2024-01", "закупки", 5000000);
Бюджет.Выделить("мвз1", "2024-01", "ремонт",  1000000);
Сообщить("Бюджет МВЗ январь: закупки=5 000 000, ремонт=1 000 000");
Сообщить("");

// ── 5. ЗАКУПКИ С БЮДЖЕТНЫМ КОНТРОЛЕМ ─────────────────────────────────────────
Сообщить("── 5. Закупки и бюджет ──");
Поставщик1 = Поставщик("П001", "ООО МеталлСнаб", 4.8, 30);
ЗП1 = ЗаказПоставщику("ЗП-2024-001", Поставщик1);
ЗП1.ДобавитьСтроку("СТ-01", "Станок токарный 16К20", 2, 850000, "шт");
ЗП1.ДобавитьСтроку("СМ-05", "Смазочное масло ISO VG 32", 100, 450, "л");

Зарезервировано = Бюджет.Зарезервировать("мвз1", "2024-01", ЗП1.Итого, ЗП1.Номер, "закупки");
Если Зарезервировано Тогда
    Сообщить("Бюджет зарезервирован: " + Строка(ЗП1.Итого) + " ₽");
    ЗП1.submit("Иванов А.А.", "Станки для нового цеха");
    ЗП1.approve("Козлов П.В. (нач.цеха)");
    ЗП1.approve("Петров И.И. (директор закупок)");
    Сообщить("Статус заказа: " + ЗП1.status);
КонецЕсли;
Сообщить("");

// ── 6. ПОСТАВКА И ПРИЁМКА ────────────────────────────────────────────────────
Сообщить("── 6. Приёмка товара ──");
ПН1 = ПриходнаяНакладная("ПН-2024-0321", ЗП1);
ПН1.ДобавитьПриход("СТ-01", "Станок токарный 16К20", 2, 850000);
ПН1.ДобавитьПриход("СМ-05", "Масло ISO VG 32", 95, 450);
ПН1.submit("склад");
ПН1.approve("зав.складом");
ПН1.post("склад");
Сообщить("Приходная накладная: " + ПН1.number + " | статус: " + ПН1.status);
Сообщить("Поставлено по ЗП: " + Строка(ЗП1.completion_pct) + "%");
Сообщить("");

// ── 7. СЧЁТ ПОСТАВЩИКА И ТРЁХСТОРОННЕЕ СОПОСТАВЛЕНИЕ ────────────────────────
Сообщить("── 7. Трёхстороннее сопоставление ──");
СчётП1 = СчётПоставщика("СЧ-2024-0847", "ООО МеталлСнаб");
СчётП1.ДобавитьСтроку("СТ-01", "Станок токарный 16К20", 2, 852000);   // цена +0.24%
СчётП1.ДобавитьСтроку("СМ-05", "Масло ISO VG 32", 95, 450);

Сопоставление = ТрёхстороннееСопоставление();
Результат = Сопоставление.Сопоставить(ЗП1, ПН1, СчётП1);
Сообщить(Результат.Отчет("ru"));
Сообщить("");

// ── 8. ПРОВОДКА БЮДЖЕТА (ПОТРЕБЛЕНИЕ) ────────────────────────────────────────
Если НЕ Результат.Заблокировано Тогда
    Бюджет.Потребить("мвз1", "2024-01", СчётП1.Итого, СчётП1.Номер, "закупки");
    Сообщить("Бюджет потреблён: " + Строка(СчётП1.Итого) + " ₽");
КонецЕсли;
БалансБюджета = Бюджет.Баланс("мвз1", "2024-01", "закупки");
Сообщить("Остаток бюджета (закупки): " + Строка(БалансБюджета.Доступно) + " ₽");
Сообщить("Утилизация: " + Строка(Окр(БалансБюджета.utilization_pct, 1)) + "%");
Сообщить("");

// ── 9. РАСЧЁТ ЗАРПЛАТЫ ───────────────────────────────────────────────────────
Сообщить("── 9. Расчёт зарплаты (профиль ru_2024) ──");
НалДвижок  = НалоговыйДвижок();
РасчётЗП   = РасчетЗарплаты(НалДвижок);

Соtr1 = Сотрудник("Е001", "Иванов Алексей Петрович",   "Токарь 5р.",  95000, "ru_2024");
Соtr2 = Сотрудник("Е002", "Петров Сергей Николаевич",  "Сборщик 4р.", 75000, "ru_2024");
Соtr3 = Сотрудник("Е003", "Сидорова Мария Викторовна", "Технолог",   110000, "ru_2024");
РасчётЗП.ДобавитьСотрудника(Соtr1);
РасчётЗП.ДобавитьСотрудника(Соtr2);
РасчётЗП.ДобавитьСотрудника(Соtr3);

// Иванов был в отпуске 5 дней — отпуск оплачивается
РасчётЗП.ДобавитьОтсутствие("Е001", "vacation", 5, "2024-01");
// Сидорова получает премию 15%
Прем = Премия("Ежемесячная премия", "percent", 0.15);
РасчётЗП.ДобавитьПремию("Е003", Прем);

Результаты = РасчётЗП.Рассчитать("2024-01");
Сообщить(РасчётЗП.ВедомостьЗарплаты(Результаты, "ru"));
Сообщить("");

// Подробный расчётный лист для Сидоровой
Сообщить("Расчётный лист — Сидорова М.В.:");
Для Каждого Рез Из Результаты Цикл
    Если Рез.Employee.Id = "Е003" Тогда
        Лист = РасчётЗП.СформироватьРасчетныйЛист(Рез, "ru");
        Сообщить(Лист.Сформировать("ru"));
    КонецЕсли;
КонецЦикла;
Сообщить("");

// ── 10. НАЛОГОВЫЙ ДВИЖОК — ПРЯМОЙ РАСЧЁТ ─────────────────────────────────────
Сообщить("── 10. Налоговый движок — сравнение профилей ──");
НалДвижок2 = НалоговыйДвижок();
РезRU = НалДвижок2.Рассчитать(100000, "ru_2024");
РезUA = НалДвижок2.Рассчитать(100000, "ua_2024");
РезUS = НалДвижок2.Рассчитать(100000, "us_2024");
Сообщить("RU (ru_2024): начислено=" + Строка(РезRU.Начислено) + ", к выплате=" + Строка(РезRU.КВыплате));
Сообщить("UA (ua_2024): начислено=" + Строка(РезUA.Начислено) + ", к выплате=" + Строка(РезUA.КВыплате));
Сообщить("US (us_2024): начислено=" + Строка(РезUS.Начислено) + ", к выплате=" + Строка(РезUS.КВыплате));
Сообщить("");

// ── ИТОГ ─────────────────────────────────────────────────────────────────────
Сообщить("=== SPRINT 10 ГОТОВ ===");
Сообщить("✓ Организационная структура (Холдинг→Завод→Отдел→МВЗ)");
Сообщить("✓ Контроль бюджета с резервированием и потреблением");
Сообщить("✓ Маршрут утверждения из YAML (без изменения кода)");
Сообщить("✓ Трёхстороннее сопоставление ЗП+ПН+Счёт");
Сообщить("✓ Расчёт зарплаты с налоговым профилем ru_2024");
Сообщить("✓ Отраслевой профиль: производство");
