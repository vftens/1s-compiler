// =============================================================================
// ДЕМО: Збереження/завантаження ERP об'єктів Sprint 11 (Українська)
// Цикл: OrgChart → BudgetControl → PayrollEngine → WorkflowConfig → збереження → завантаження
// =============================================================================

Повідомити("=== 1S ERP Sprint 11 — Персистентність (Українська) ===");
Повідомити("");

// ── 1. ОРГАНІЗАЦІЙНА СТРУКТУРА ───────────────────────────────────────────────
Повідомити("── 1. Організаційна структура ──");
Орг = ОрганізаційнаСтруктура("ПАТ Агрохолдинг Україна");
Орг.ДодатиВузол("юо1",  "ТОВ АгроПром Київ",       "legal_entity", "root");
Орг.ДодатиВузол("бр1",  "Бригада №1 (Зернові)",     "plant",         "юо1");
Орг.ДодатиВузол("бр2",  "Бригада №2 (Олійні)",      "plant",         "юо1");
Орг.ДодатиВузол("відд", "Відділ логістики",          "department",    "юо1");
Орг.ДодатиВузол("мвв1", "МВВ: Зернові",              "cost_center",   "бр1");
Повідомити(Орг.Звіт());

// ── 2. БЮДЖЕТ ────────────────────────────────────────────────────────────────
Повідомити("── 2. Бюджет на квартал ──");
Бюджет = КонтрольБюджету(Хибно, 0.9);
Бюджет.Виділити("мвв1", "2024-Q1", "насіння",   1500000);
Бюджет.Виділити("мвв1", "2024-Q1", "добрива",    800000);
Бюджет.Зарезервувати("мвв1", "2024-Q1", 400000, "ЗЗ-АГ-0201", "насіння");
Бюджет.Зарезервувати("мвв1", "2024-Q1", 250000, "ЗЗ-АГ-0202", "добрива");
Бюджет.Спожити("мвв1", "2024-Q1", 390000, "ПН-АГ-0301", "насіння");
Повідомити("Бюджет МВВ1: виділено 2 300 000 грн");

// ── 3. ЗАРПЛАТА ───────────────────────────────────────────────────────────────
Повідомити("── 3. Розрахунок зарплати ──");
ПодДв = ПодатковийДвижок();
РЗП   = РозрахунокЗарплати(ПодДв);

Пр1 = Працівник("П001", "Коваленко Василь Миколайович",  "Агроном",          55000, "ua_2024");
Пр2 = Працівник("П002", "Мельник Тетяна Петрівна",       "Механізатор",      42000, "ua_2024");
Пр3 = Працівник("П003", "Гаврилюк Іван Олексійович",     "Комбайнер",        38000, "ua_2024");
РЗП.ДодатиПрацівника(Пр1);
РЗП.ДодатиПрацівника(Пр2);
РЗП.ДодатиПрацівника(Пр3);

// Гаврилюк — відпустка 5 днів
РЗП.ДодатиВідсутність("П003", "vacation", 5, "2024-01");
// Коваленко — агрономічна премія 20%
Прем = Премія("Сезонна премія", "percent", 0.20);
РЗП.ДодатиПремію("П001", Прем);

РезЗП = РЗП.Розрахувати("2024-01");
Повідомити(РЗП.ВідомістьЗарплати(РезЗП, "uk"));

// ── 4. ЗБЕРЕЖЕННЯ В БАЗУ ДАНИХ ───────────────────────────────────────────────
Повідомити("── 4. Збереження в SQLite ──");
БД = "data/erp_demo_uk.db";

Кільк1 = ЗберегтиОргСтруктуру(Орг, БД);
Повідомити("OrgChart збережено: " + Рядок(Кільк1) + " вузлів");

Кільк2 = ЗберегтиБюджет(Бюджет, БД);
Повідомити("BudgetControl збережено: " + Рядок(Кільк2) + " записів");

Кільк3 = ЗберегтиРозрахункиЗП(РезЗП, БД);
Повідомити("PayrollResults збережено: " + Рядок(Кільк3) + " працівників");
Повідомити("");

// ── 5. ЗАВАНТАЖЕННЯ З БАЗИ ДАНИХ ─────────────────────────────────────────────
Повідомити("── 5. Завантаження з SQLite ──");

Орг2 = ЗавантажитиОргСтруктуру(БД, "ПАТ Агрохолдинг Україна");
Повідомити("OrgChart завантажено: вузел мвв1 = " + Рядок(Орг2.ЗнайтиВузол("мвв1").name));

Бюджет2 = ЗавантажитиБюджет(БД);
Залишок = Бюджет2.Залишок("мвв1", "2024-Q1", "насіння");
Повідомити("Насіння МВВ1: виділено=" + Рядок(Залишок.allocated) +
           ", доступно=" + Рядок(Залишок.available) +
           ", викор.%=" + Рядок(Окр(Залишок.utilization_pct, 1)));

ЗавЗП = ЗавантажитиРозрахункиЗП(БД, "2024-01");
Повідомити("Завантажено розрахунки зарплати за 2024-01:");
Для Кожного Рез Из ЗавЗП Цикл
    Повідомити("  " + Рез["emp_name"] + " → до виплати: " + Рядок(Округлити(Рез["net"], 2)));
КонецЦикла;
Повідомити("");

// ── 6. ERP ЗАПИТИ ─────────────────────────────────────────────────────────────
Повідомити("── 6. Аналітичні запити ──");
Запит = ЗапитERPe(БД);

РядиБюдж = Запит.ВиконанняБюджету(Неопределено, "2024-Q1");
Повідомити(Запит.ФорматЗвіту("budget_utilization", РядиБюдж, "uk"));
Повідомити("");

РядиЗП = Запит.ІсторіяЗарплат(Неопределено, "2024-01");
Повідомити(Запит.ФорматЗвіту("payroll_history", РядиЗП, "uk"));
Повідомити("");

// Зведений
Зведений = Запит.ЗведенийЗвіт("2024-01");
Повідомити("=== ЗВЕДЕНИЙ ЗВІТ 2024-01 ===");
Повідомити("Фонд зарплати : " + Рядок(Округлити(Зведений["payroll_gross"], 2)));
Повідомити("До виплати    : " + Рядок(Округлити(Зведений["payroll_net"], 2)));
Повідомити("Працівників   : " + Рядок(Зведений["employee_count"]));
Повідомити("");

// ── ПІДСУМОК ─────────────────────────────────────────────────────────────────
Повідомити("=== SPRINT 11 ЗАВЕРШЕНО ===");
Повідомити("✓ ОрганізаційнаСтруктура → SQLite → завантажена");
Повідомити("✓ КонтрольБюджету → SQLite → завантажений, баланс відновлено");
Повідомити("✓ РозрахункиЗП → SQLite → 3 працівники");
Повідомити("✓ Аналітичні ERP запити на українській мові");
