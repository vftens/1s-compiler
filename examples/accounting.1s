// 1S: ERP Free Edition — Accounting register demo
// Shows Chart of Accounts, double-entry postings, and query language.

// ── Build chart of accounts ───────────────────────────────────────────────
Перем ПланСч;
ПланСч = Новый ПланСчетов("Основной");

// Assets
ПланСч.ДобавитьСчёт("10", "Материалы",          "",   Истина, Ложь);
ПланСч.ДобавитьСчёт("51", "Расчётный счёт",     "",   Истина, Ложь);
ПланСч.ДобавитьСчёт("41", "Товары",              "",   Истина, Ложь);
// Liabilities
ПланСч.ДобавитьСчёт("60", "Расчёты с поставщиками", "", Истина, Истина);
ПланСч.ДобавитьСчёт("70", "Расчёты с персоналом",   "", Истина, Истина);
// Revenue / Expenses
ПланСч.ДобавитьСчёт("90", "Продажи",            "",   Ложь, Ложь);
ПланСч.ДобавитьСчёт("91", "Прочие доходы",       "",   Ложь, Ложь);

// ── Accounting register ───────────────────────────────────────────────────
Перем Регистр;
Регистр = Новый РегистрБухгалтерии("Основной", ПланСч);

// ── Post some transactions ────────────────────────────────────────────────
// Receipt of goods  Дт 41  Кт 60  on 2026-01-15
Регистр.Провести(
    ТекущаяДата(),          // period
    "Документ_001",         // recorder
    ПланСч.НайтиПоКоду("41"),  // debit
    ПланСч.НайтиПоКоду("60"),  // credit
    150000                  // amount
);

// Payment to supplier  Дт 60  Кт 51
Регистр.Провести(
    ТекущаяДата(),
    "Документ_002",
    ПланСч.НайтиПоКоду("60"),
    ПланСч.НайтиПоКоду("51"),
    150000
);

// ── Query balance ─────────────────────────────────────────────────────────
Перем Остаток51;
Остаток51 = Регистр.Остаток("51");
Сообщить("Сч. 51 Остаток: " + Строка(Остаток51["Остаток"]));

Перем Остаток60;
Остаток60 = Регистр.Остаток("60");
Сообщить("Сч. 60 Остаток: " + Строка(Остаток60["Остаток"]));

// ── ValueTable + Query ────────────────────────────────────────────────────
Перем ТаблТовары;
ТаблТовары = Новый ТаблицаЗначений();
ТаблТовары.Колонки.Добавить("Номенклатура");
ТаблТовары.Колонки.Добавить("Цена");
ТаблТовары.Колонки.Добавить("Количество");

Перем Стр;
Стр = ТаблТовары.Добавить();
Стр.Номенклатура = "Мука 1кг";
Стр.Цена         = 80;
Стр.Количество   = 100;

Стр = ТаблТовары.Добавить();
Стр.Номенклатура = "Сахар 1кг";
Стр.Цена         = 55;
Стр.Количество   = 200;

Стр = ТаблТовары.Добавить();
Стр.Номенклатура = "Масло 0.5л";
Стр.Цена         = 120;
Стр.Количество   = 50;

// ── 1S query (bilingual SQL) ──────────────────────────────────────────────
Перем Зап;
Зап = Новый Запрос();
Зап.УстановитьПараметр("МинЦена", 60);
Зап.ЗарегистрироватьТаблицу("Товары", ТаблТовары);
Зап.Текст =
    "ВЫБРАТЬ
    |   Номенклатура,
    |   Цена,
    |   Количество
    |ИЗ
    |   Товары
    |ГДЕ
    |   Цена > :МинЦена
    |УПОРЯДОЧИТЬ ПО
    |   Цена";

Перем Рез;
Рез = Зап.Выполнить();
Сообщить("Товаров с ценой > 60: " + Строка(Рез.Количество()));

Перем Выб;
Выб = Рез.Выбрать();
Пока Выб.Следующий() Цикл
    Сообщить(Выб.Номенклатура + "  —  " + Строка(Выб.Цена));
КонецЦикла;
