// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Повний ERP-цикл на українській мові
//   Довідники → Документи → Бухгалтерські записи → Звіти
//
// Демонструє: Довідник, Документ, ТабличнаЧастина, ОСВ, P&L
// ══════════════════════════════════════════════════════════════════════

// ────────────────────────────────────────────────────────────────────
// 1. ДОВІДНИКИ (Catalogs)
// ────────────────────────────────────────────────────────────────────

// Довідник контрагентів
Контрагенти = Справочник("Контрагенти");
ТОВАльфа    = Контрагенти.Створити("0001", "ТОВ «Альфа»");
ТОВАльфа.ЄДРПОУ   = "1234567890";
ТОВАльфа.ТипГр    = "Покупець";
ТОВАльфа.Кредитка = 0;

ТОВПостач   = Контрагенти.Створити("0002", "ТОВ «МатеріалПлюс»");
ТОВПостач.ЄДРПОУ  = "9876543210";
ТОВПостач.ТипГр   = "Постачальник";

// Довідник товарів (номенклатура)
Товари = Справочник("Номенклатура");

Борошно    = Товари.Створити("Т001", "Борошно пшеничне в/с, 1 кг");
Борошно.Одиниця = "кг"; Борошно.Ціна = 45.0; Борошно.ПДВ = 20;

Цукор      = Товари.Створити("Т002", "Цукор-пісок, 1 кг");
Цукор.Одиниця = "кг"; Цукор.Ціна = 32.0; Цукор.ПДВ = 20;

Олія       = Товари.Створити("Т003", "Олія соняшникова, 1 л");
Олія.Одиниця = "л"; Олія.Ціна = 85.0; Олія.ПДВ = 20;

Повідомити("──── Довідники завантажено ─────────────────────────────────────────");
Повідомити(ШаблонРядка("  Контрагентів: %1,  Товарів: %2",
    Контрагенти.Кількість(), Товари.Кількість()));

// ────────────────────────────────────────────────────────────────────
// 2. ПРИХІДНА НАКЛАДНА — надходження товарів від постачальника
// ────────────────────────────────────────────────────────────────────

ПН = Документ("ПрихіднаНакладна");
ПН.Дата        = '20250110';
ПН.Постачальник = ТОВПостач;
ПН.Склад       = "Основний";

ТоварПН = ПН.ТабличнаЧастина("Товари", "Товар, Кількість, Ціна, Сума, ПДВ");

Тов = ТоварПН.Додати();
Тов["Товар"]     = Борошно.Назва;
Тов["Кількість"] = 500;
Тов["Ціна"]      = Борошно.Ціна;
Тов["Сума"]      = 500 * Борошно.Ціна;
Тов["ПДВ"]       = Окр(500 * Борошно.Ціна * 0.2, 2);

Тов = ТоварПН.Додати();
Тов["Товар"]     = Цукор.Назва;
Тов["Кількість"] = 300;
Тов["Ціна"]      = Цукор.Ціна;
Тов["Сума"]      = 300 * Цукор.Ціна;
Тов["ПДВ"]       = Окр(300 * Цукор.Ціна * 0.2, 2);

Тов = ТоварПН.Додати();
Тов["Товар"]     = Олія.Назва;
Тов["Кількість"] = 200;
Тов["Ціна"]      = Олія.Ціна;
Тов["Сума"]      = 200 * Олія.Ціна;
Тов["ПДВ"]       = Окр(200 * Олія.Ціна * 0.2, 2);

ПН.Провести();

СумаПН    = ТоварПН.Підсумок("Сума");
ПДВ_вхід  = ТоварПН.Підсумок("ПДВ");
СумаЗПДВ  = СумаПН + ПДВ_вхід;

Повідомити("");
Повідомити("──── Прихідна накладна " + ПН.Номер + " від " + Рядок(ПН.Дата) + " ────────────────────");
Повідомити(ШаблонРядка("  Постачальник:  %1", ПН.Постачальник));
Для Кожного Тов З ТоварПН Цикл
    Повідомити(ШаблонРядка("  %-36s  %6s шт.  %7s грн",
        Тов["Товар"], Тов["Кількість"], Формат(Тов["Сума"],"ЧДЦ=2")));
КінецьЦиклу;
Повідомити(ШаблонРядка("  Сума без ПДВ: %1 грн  |  ПДВ: %2 грн  |  Разом: %3 грн",
    Формат(СумаПН,"ЧДЦ=2"), Формат(ПДВ_вхід,"ЧДЦ=2"), Формат(СумаЗПДВ,"ЧДЦ=2")));
Повідомити(ШаблонРядка("  Статус: %1", ПН.Проведён ? "Проведено" : "Чернетка"));

// ────────────────────────────────────────────────────────────────────
// 3. ВИДАТКОВА НАКЛАДНА — реалізація товарів покупцю
// ────────────────────────────────────────────────────────────────────

ВН = Документ("ВидатковаНакладна");
ВН.Дата       = '20250115';
ВН.Покупець   = ТОВАльфа;
ВН.Умови      = "Оплата протягом 14 днів";

ТоварВН = ВН.ТабличнаЧастина("Товари", "Товар, Кількість, Ціна, Сума, ПДВ");

Тов = ТоварВН.Додати();
Тов["Товар"]     = Борошно.Назва;
Тов["Кількість"] = 400;
Тов["Ціна"]      = 64.0;   // ціна продажу (43% маржа)
Тов["Сума"]      = 400 * 64.0;
Тов["ПДВ"]       = Окр(400 * 64.0 * 0.2, 2);

Тов = ТоварВН.Додати();
Тов["Товар"]     = Цукор.Назва;
Тов["Кількість"] = 250;
Тов["Ціна"]      = 44.0;   // ціна продажу (38% маржа)
Тов["Сума"]      = 250 * 44.0;
Тов["ПДВ"]       = Окр(250 * 44.0 * 0.2, 2);

Тов = ТоварВН.Додати();
Тов["Товар"]     = Олія.Назва;
Тов["Кількість"] = 150;
Тов["Ціна"]      = 116.0;  // ціна продажу (37% маржа)
Тов["Сума"]      = 150 * 116.0;
Тов["ПДВ"]       = Окр(150 * 116.0 * 0.2, 2);

ВН.Провести();

СумаВН   = ТоварВН.Підсумок("Сума");
ПДВ_вих  = ТоварВН.Підсумок("ПДВ");

Повідомити("");
Повідомити("──── Видаткова накладна " + ВН.Номер + " від " + Рядок(ВН.Дата) + " ───────────────────");
Повідомити(ШаблонРядка("  Покупець: %1  |  %2", ВН.Покупець, ВН.Умови));
Для Кожного Тов З ТоварВН Цикл
    Повідомити(ШаблонРядка("  %-36s  %6s шт.  %7s грн",
        Тов["Товар"], Тов["Кількість"], Формат(Тов["Сума"],"ЧДЦ=2")));
КінецьЦиклу;
Повідомити(ШаблонРядка("  Виручка (без ПДВ): %1 грн  |  ПДВ: %2 грн  |  Разом: %3 грн",
    Формат(СумаВН,"ЧДЦ=2"), Формат(ПДВ_вих,"ЧДЦ=2"), Формат(СумаВН+ПДВ_вих,"ЧДЦ=2")));

// ────────────────────────────────────────────────────────────────────
// 4. БУХГАЛТЕРСЬКІ ЗАПИСИ
// ────────────────────────────────────────────────────────────────────

ПланРах = ПланРахунків("УКСГП");
ПланРах.Додати("20","Запаси"); ПланРах.Додати("28","ТМЦ у реалізації");
ПланРах.Додати("36","Дебітори"); ПланРах.Додати("63","Кредитори");
ПланРах.Додати("64","ПДВ"); ПланРах.Додати("70","Доходи");
ПланРах.Додати("90","Собів."); ПланРах.Додати("92","Адмін.");

РегБух = РегістрБухгалтерії("Ж1", ПланРах);

// Прихідна накладна (надходження + ПДВ)
РегБух.Провести('20250110',"ПН-0001","Надходження запасів",     "20","63", СумаПН);
РегБух.Провести('20250110',"ПН-0001","ПДВ вхідний",            "64","63", ПДВ_вхід);

// Видаткова накладна (дохід + ПДВ + собівартість)
// Собівартість = фактичні закупівельні ціни × продані кількості
Собів = 400 * Борошно.Ціна + 250 * Цукор.Ціна + 150 * Олія.Ціна;
РегБух.Провести('20250115',"ВН-0001","Дохід від реалізації",    "36","70", СумаВН);
РегБух.Провести('20250115',"ВН-0001","ПДВ вихідний",            "70","64", ПДВ_вих);
РегБух.Провести('20250115',"ВН-0001","Списання собівартості",   "90","20", Окр(Собів,2));

// Адмінвитрати
РегБух.Провести('20250131',"АВ-01","Зарплата адміністрації",    "92","63",  4500);

// ────────────────────────────────────────────────────────────────────
// 5. ФІНАНСОВИЙ РЕЗУЛЬТАТ
// ────────────────────────────────────────────────────────────────────
Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("         ФІНАНСОВИЙ РЕЗУЛЬТАТ · Підприємство «Альфа» · Cічень 2025");
Повідомити("══════════════════════════════════════════════════════════════════════");

ПС = '20250101'; ПК = '20250131';
О70 = РегБух.Оборот(ПланРах.НайтиЗаКодом("70"), ПС, ПК);
О90 = РегБух.Оборот(ПланРах.НайтиЗаКодом("90"), ПС, ПК);
О92 = РегБух.Оборот(ПланРах.НайтиЗаКодом("92"), ПС, ПК);

Виручка  = О70["ОборотКт"];   // нетто дохід (ПДВ обліковується окремо на рах.64)
СГРТ     = О90["ОборотДт"];
АВ       = О92["ОборотДт"];
ВалПриб  = Виручка - СГРТ;
ОперПриб = ВалПриб - АВ;
Рентаб   = Окр(ОперПриб / Виручка * 100, 1);

Повідомити(ШаблонРядка("  %-44s  %12s грн", "Виручка від реалізації (нетто)",     Формат(Виручка, "ЧДЦ=2")));
Повідомити(ШаблонРядка("  %-44s  %12s грн", "Собівартість реалізованих товарів",  "(" + Формат(СГРТ,"ЧДЦ=2") + ")"));
Повідомити(ШаблонРядка("  %-44s  %12s грн", "ВАЛОВИЙ ПРИБУТОК",                   Формат(ВалПриб,"ЧДЦ=2")));
Повідомити(ШаблонРядка("  %-44s  %12s грн", "Адміністративні витрати",            "(" + Формат(АВ,"ЧДЦ=2") + ")"));
Повідомити(ШаблонРядка("  %-44s  %12s грн", "ОПЕРАЦІЙНИЙ ПРИБУТОК",               Формат(ОперПриб,"ЧДЦ=2")));
Повідомити(ШаблонРядка("  %-44s  %11s%%",   "Рентабельність (Operating margin)",  Рядок(Рентаб)));

Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP — Довідники + Документи + Облік (Ukrainian) — завершено");
Повідомити("══════════════════════════════════════════════════════════════════════");
