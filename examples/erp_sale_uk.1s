// ═══════════════════════════════════════════════════════════════════════════
// 1S: ERP Free Edition — Реалізація товарів (українська мова)
// Демонструє:
//   • Довідники (товари, контрагенти)
//   • Документ з табличною частиною
//   • Проведення: бухрегістр (36/70/20) + регістр накопичення (залишки)
//   • Перевірка залишків перед проведенням
//   • Розрахунок ПДВ 20%, собівартості
//   • Обробка помилок та валідація
// ═══════════════════════════════════════════════════════════════════════════

// ── 1. Допоміжні функції ─────────────────────────────────────────────────

Функція ОкруглитиСуму(Знач Сума, Знач Знаків = 2)
    Повернути Округлити(Сума, Знаків);
КінецьФункції

Функція РозрахуватиПДВ(Знач Сума, Знач СтавкаВідс = 20)
    Повернути ОкруглитиСуму(Сума * СтавкаВідс / (100 + СтавкаВідс));
КінецьФункції

Функція СумаБезПДВ(Знач СумаЗПДВ, Знач СтавкаВідс = 20)
    Повернути ОкруглитиСуму(СумаЗПДВ / (1 + СтавкаВідс / 100));
КінецьФункції

// ── 2. Налаштування плану рахунків ───────────────────────────────────────

Змін ПланРах;
ПланРах = Новий ПланРахунків("УКСГП");

ПланРах.Додати("20",  "Виробничі запаси",             Істина,  Хибність);
ПланРах.Додати("26",  "Готова продукція",              Істина,  Хибність);
ПланРах.Додати("36",  "Розрахунки з покупцями",        Істина,  Хибність);
ПланРах.Додати("31",  "Рахунки в банках",              Істина,  Хибність);
ПланРах.Додати("641", "ПДВ до сплати",                 Хибність, Істина);
ПланРах.Додати("63",  "Розрахунки з постачальниками",  Істина,  Істина);
ПланРах.Додати("70",  "Доходи від реалізації",         Хибність, Істина);
ПланРах.Додати("701", "Виручка від реалізації тов.",   Хибність, Істина);
ПланРах.Додати("702", "ПДВ з реалізації",              Істина,  Хибність);
ПланРах.Додати("90",  "Собівартість реалізації",       Істина,  Хибність);

// ── 3. Регістри ──────────────────────────────────────────────────────────

Змін БухРегістр;
БухРегістр = Новий РегістрБухгалтерії("Основний", ПланРах);

Змін РегЗалишки;
РегЗалишки = Новий РегістрНакопичення("ЗалишкиТоварів", "Balance");

// ── 4. Довідник: Товари ──────────────────────────────────────────────────

Функція СтворитиТовар(Знач Код, Знач Назва, Знач ОдВим, Знач СобіЗПДВ, Знач ЦінаЗПДВ)
    Змін Т;
    Т = Новий Структура("Код, Назва, ОдВим, СобівартістьЗПДВ, ЦінаЗПДВ");
    Т.Код               = Код;
    Т.Назва             = Назва;
    Т.ОдВим             = ОдВим;
    Т.СобівартістьЗПДВ  = СобіЗПДВ;
    Т.ЦінаЗПДВ          = ЦінаЗПДВ;
    Повернути Т;
КінецьФункції

Змін ДовТовари;
ДовТовари = Новий Відповідність();
ДовТовари["ТВ001"] = СтворитиТовар("ТВ001", "Борошно пшеничне в/с, 1 кг",  "кг",   48, 96);
ДовТовари["ТВ002"] = СтворитиТовар("ТВ002", "Цукор-пісок, 1 кг",            "кг",   36, 72);
ДовТовари["ТВ003"] = СтворитиТовар("ТВ003", "Олія соняшникова, 1 л",        "л",    80, 150);
ДовТовари["ТВ004"] = СтворитиТовар("ТВ004", "Молоко 3.2%, 1 л",             "л",    55, 108);

// ── 5. Довідник: Контрагенти ─────────────────────────────────────────────

Функція СтворитиКонтрагента(Знач Код, Знач Назва, Знач ЄДРПОУ)
    Змін К;
    К = Новий Структура("Код, Назва, ЄДРПОУ");
    К.Код     = Код;
    К.Назва   = Назва;
    К.ЄДРПОУ  = ЄДРПОУ;
    Повернути К;
КінецьФункції

Змін ДовКонтрагенти;
ДовКонтрагенти = Новий Відповідність();
ДовКонтрагенти["КА001"] = СтворитиКонтрагента("КА001", "ТОВ «Продукти Плюс»",  "1234567890");
ДовКонтрагенти["КА002"] = СтворитиКонтрагента("КА002", "ФОП Сидоренко А.В.",   "9876543210");

// ── 6. Початкові залишки ─────────────────────────────────────────────────

Процедура ВвестиПочЗалишок(Знач КодТовару, Знач Кіл, Знач Собіварт)
    Змін Товар;
    Товар = ДовТовари[КодТовару];
    Якщо Товар = Невизначено Тоді
        ВикинутиВиняток "Товар не знайдено: " + КодТовару;
    КінецьЯкщо;

    // Бухгалтерський облік: Дт20 Кт63 (умовне введення залишків)
    БухРегістр.Провести(
        '20250101', "ПочЗалишки",
        "Початковий залишок: " + Товар.Назва,
        "20", "63",
        Кіл * Собіварт, "", ""
    );

    // Регістр накопичення
    РегЗалишки.Записати(
        '20250101', "ПочЗалишки",
        Істина,         // прихід
        Кіл,            // ресурс1 = кількість
        КодТовару,      // вимір1 = код товару
        "Основний",     // вимір2 = склад
        Кіл * Собіварт  // ресурс2 = сума
    );
КінецьПроцедури

ВвестиПочЗалишок("ТВ001", 500, 40);  // 500 кг борошна по 40 грн
ВвестиПочЗалишок("ТВ002", 300, 30);  // 300 кг цукру по 30 грн
ВвестиПочЗалишок("ТВ003", 200, 67);  // 200 л олії по 67 грн
ВвестиПочЗалишок("ТВ004", 150, 46);  // 150 л молока по 46 грн

// ── 7. Документ: Видаткова накладна ─────────────────────────────────────

Функція СтворитиДокВидаткова(Знач НомДок, Знач КодКонтрагента)
    Змін Д;
    Д = Новий Структура(
        "Номер, Дата, Контрагент, СумаДокументу, СумаПДВ, Рядки, Проведено"
    );
    Д.Номер          = НомДок;
    Д.Дата           = '20250215';
    Д.Контрагент     = ДовКонтрагенти[КодКонтрагента];
    Д.СумаДокументу  = 0;
    Д.СумаПДВ        = 0;
    Д.Рядки          = Новий ТаблицяЗначень();
    Д.Рядки.Колонки.Додати("НомРядка");
    Д.Рядки.Колонки.Додати("КодТовару");
    Д.Рядки.Колонки.Додати("Назва");
    Д.Рядки.Колонки.Додати("Кількість");
    Д.Рядки.Колонки.Додати("ЦінаЗПДВ");
    Д.Рядки.Колонки.Додати("СумаЗПДВ");
    Д.Рядки.Колонки.Додати("ПДВ");
    Д.Рядки.Колонки.Додати("СумаБезПДВ");
    Д.Рядки.Колонки.Додати("Собівартість");
    Д.Проведено      = Хибність;
    Повернути Д;
КінецьФункції

Процедура ДодатиРядок(Знач Документ, Знач КодТовару, Знач Кількість)
    Змін Товар;
    Товар = ДовТовари[КодТовару];
    Якщо Товар = Невизначено Тоді
        ВикинутиВиняток "Товар не знайдено: " + КодТовару;
    КінецьЯкщо;

    Змін Рядок;
    Рядок = Документ.Рядки.Додати();
    Рядок.НомРядка    = Документ.Рядки.Кількість();
    Рядок.КодТовару   = КодТовару;
    Рядок.Назва       = Товар.Назва;
    Рядок.Кількість   = Кількість;
    Рядок.ЦінаЗПДВ    = Товар.ЦінаЗПДВ;
    Рядок.СумаЗПДВ    = ОкруглитиСуму(Кількість * Товар.ЦінаЗПДВ);
    Рядок.ПДВ         = РозрахуватиПДВ(Рядок.СумаЗПДВ);
    Рядок.СумаБезПДВ  = Рядок.СумаЗПДВ - Рядок.ПДВ;
    Рядок.Собівартість = ОкруглитиСуму(
        Кількість * СумаБезПДВ(Товар.СобівартістьЗПДВ)
    );

    Документ.СумаДокументу = Документ.СумаДокументу + Рядок.СумаЗПДВ;
    Документ.СумаПДВ       = Документ.СумаПДВ       + Рядок.ПДВ;
КінецьПроцедури

// ── 8. Перевірка залишків ────────────────────────────────────────────────

Функція ПеревіритиЗалишки(Знач Документ) // повертає Хибність якщо недостатньо
    Змін Недолік;
    Недолік = Хибність;
    Повідомити("── Перевірка залишків перед проведенням ─────────────────────────");
    Для Кожного Рядок З Документ.Рядки Цикл
        Змін Залишок;
        Залишок = РегЗалишки.Залишок(
            Документ.Дата,
            Рядок.КодТовару, "Основний"
        );
        Змін КілЗалишок;
        КілЗалишок = Залишок["Resource1"];
        Якщо КілЗалишок < Рядок.Кількість Тоді
            Повідомити(ШаблонРядка("  ✗ %1 — потрібно %2, в наявності %3",
                Рядок.Назва, Рядок.Кількість, КілЗалишок));
            Недолік = Істина;
        Інакше
            Повідомити(ШаблонРядка("  ✓ %1 — потрібно %2, в наявності %3",
                Рядок.Назва, Рядок.Кількість, КілЗалишок));
        КінецьЯкщо;
    КінецьЦиклу;
    Повернути НЕ Недолік;
КінецьФункції

// ── 9. Проведення документа ──────────────────────────────────────────────

Процедура ПровестиДокумент(Знач Документ)
    Якщо Документ.Проведено Тоді
        ВикинутиВиняток "Документ вже проведено: " + Документ.Номер;
    КінецьЯкщо;

    Для Кожного Рядок З Документ.Рядки Цикл
        Змін Конт;
        Конт = Документ.Контрагент.Назва;

        // Дт36 Кт701 — виручка (без ПДВ)
        БухРегістр.Провести(
            Документ.Дата, Документ.Номер,
            "Виручка: " + Рядок.Назва,
            "36", "701",
            Рядок.СумаБезПДВ, Конт, ""
        );

        // Дт702 Кт641 — ПДВ з реалізації
        БухРегістр.Провести(
            Документ.Дата, Документ.Номер,
            "ПДВ: " + Рядок.Назва,
            "702", "641",
            Рядок.ПДВ, Конт, ""
        );

        // Дт90 Кт20 — списання собівартості
        БухРегістр.Провести(
            Документ.Дата, Документ.Номер,
            "Собівартість: " + Рядок.Назва,
            "90", "20",
            Рядок.Собівартість, "", ""
        );

        // Регістр накопичення — витрата
        РегЗалишки.Записати(
            Документ.Дата, Документ.Номер,
            Хибність,               // витрата
            Рядок.Кількість,        // ресурс1 = кількість
            Рядок.КодТовару,        // вимір1
            "Основний",             // вимір2
            Рядок.Собівартість      // ресурс2
        );
    КінецьЦиклу;

    Документ.Проведено = Істина;
КінецьПроцедури

// ── 10. Відображення документа ───────────────────────────────────────────

Процедура ВивестиДокумент(Знач Документ)
    Повідомити("");
    Повідомити("══════════════════════════════════════════════════════════════════");
    Повідомити(ШаблонРядка("  ВИДАТКОВА НАКЛАДНА № %1  від %2",
        Документ.Номер,
        Формат(Документ.Дата, "ДФ='дд.ММ.гггг'")));
    Повідомити(ШаблонРядка("  Покупець: %1  (ЄДРПОУ %2)",
        Документ.Контрагент.Назва,
        Документ.Контрагент.ЄДРПОУ));
    Повідомити("══════════════════════════════════════════════════════════════════");
    Повідомити(ШаблонРядка("  %1  %2  %3  %4  %5  %6",
        Формат("#",        "ЧЦ=2"),
        Формат("Назва",    "ЧЦ=30"),
        Формат("Кіл.",     "ЧЦ=5"),
        Формат("Ціна",     "ЧЦ=9"),
        Формат("ПДВ",      "ЧЦ=9"),
        Формат("Сума",     "ЧЦ=10")));
    Повідомити("  " + ПовторитиРядок("─", 70));

    Для Кожного Рядок З Документ.Рядки Цикл
        Повідомити(ШаблонРядка("  %1  %2  %3  %4  %5  %6",
            Формат(Рядок.НомРядка,   "ЧЦ=2"),
            Формат(Ліво(Рядок.Назва, 30), "ЧЦ=30"),
            Формат(Рядок.Кількість,  "ЧЦ=5; ЧДЦ=0"),
            Формат(Рядок.ЦінаЗПДВ,  "ЧЦ=9; ЧДЦ=2"),
            Формат(Рядок.ПДВ,        "ЧЦ=9; ЧДЦ=2"),
            Формат(Рядок.СумаЗПДВ,   "ЧЦ=10; ЧДЦ=2")));
    КінецьЦиклу;

    Повідомити("  " + ПовторитиРядок("─", 70));
    Повідомити(ШаблонРядка("  %1  %2  %3",
        Формат("РАЗОМ:", "ЧЦ=40"),
        Формат("ПДВ:", "ЧЦ=5"),
        Формат(Документ.СумаПДВ, "ЧЦ=9; ЧДЦ=2")));
    Повідомити(ШаблонРядка("  Сума до сплати: %1 грн (у т.ч. ПДВ 20%%: %2 грн)",
        Формат(Документ.СумаДокументу, "ЧДЦ=2"),
        Формат(Документ.СумаПДВ,       "ЧДЦ=2")));
КінецьПроцедури

// ── 11. Головна програма ─────────────────────────────────────────────────

Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP Free Edition — Реалізація товарів (українська мова)");
Повідомити("══════════════════════════════════════════════════════════════════");

// Створюємо документ
Змін Документ1;
Документ1 = СтворитиДокВидаткова("ВН-0001", "КА001");
ДодатиРядок(Документ1, "ТВ001", 100);  // 100 кг борошна
ДодатиРядок(Документ1, "ТВ002",  50);  //  50 кг цукру
ДодатиРядок(Документ1, "ТВ003",  80);  //  80 л олії
ДодатиРядок(Документ1, "ТВ004",  60);  //  60 л молока

// Виводимо документ
ВивестиДокумент(Документ1);

// Перевіряємо залишки та проводимо
Якщо ПеревіритиЗалишки(Документ1) Тоді
    ПровестиДокумент(Документ1);
    Повідомити("");
    Повідомити("  ✓ Документ " + Документ1.Номер + " проведено успішно");
Інакше
    Повідомити("");
    Повідомити("  ✗ Проведення скасовано: недостатньо залишків на складі");
КінецьЯкщо;

// ── 12. Звіт: залишки після проведення ───────────────────────────────────

Повідомити("");
Повідомити("── Залишки товарів після реалізації ─────────────────────────────");
Повідомити(ШаблонРядка("  %1  %2  %3  %4",
    Формат("Товар",    "ЧЦ=32"),
    Формат("Кіл-ть",  "ЧЦ=8"),
    Формат("Сума",     "ЧЦ=10"),
    Формат("Ціна/од.", "ЧЦ=10")));
Повідомити("  " + ПовторитиРядок("─", 64));

Змін ВсьогоСума;
ВсьогоСума = 0;
Для Кожного Пара З ДовТовари Цикл
    Змін КодТов, ЗалТов, КілЗал, СумЗал, Ціна;
    КодТов  = Пара.Ключ;
    ЗалТов  = РегЗалишки.Залишок(Невизначено, КодТов, "Основний");
    КілЗал  = ЗалТов["Resource1"];
    СумЗал  = ЗалТов["Resource2"];
    Якщо КілЗал > 0 Тоді
        Ціна = ОкруглитиСуму(СумЗал / КілЗал);
    Інакше
        Ціна = 0;
    КінецьЯкщо;
    Повідомити(ШаблонРядка("  %1  %2  %3  %4",
        Формат(Ліво(Пара.Значення.Назва, 32), "ЧЦ=32"),
        Формат(КілЗал,  "ЧЦ=8;  ЧДЦ=0"),
        Формат(СумЗал,  "ЧЦ=10; ЧДЦ=0"),
        Формат(Ціна,    "ЧЦ=10; ЧДЦ=2")));
    ВсьогоСума = ВсьогоСума + СумЗал;
КінецьЦиклу;
Повідомити("  " + ПовторитиРядок("─", 64));
Повідомити(ШаблонРядка("  %1  %2",
    Формат("РАЗОМ на складі:", "ЧЦ=42"),
    Формат(ВсьогоСума, "ЧЦ=10; ЧДЦ=0")));

// ── 13. Фінансовий результат ─────────────────────────────────────────────

Повідомити("");
Повідомити("── Фінансовий результат ─────────────────────────────────────────");
Змін Виручка, Собіварт, ВалПриб;
Змін Остаток701, Остаток90;
Остаток701 = БухРегістр.Залишок("701");
Остаток90  = БухРегістр.Залишок("90");
Виручка    = Остаток701["Кт"];
Собіварт   = Остаток90["Дт"];
ВалПриб    = Виручка - Собіварт;

Повідомити(ШаблонРядка("  Виручка (без ПДВ):    %1 грн", Формат(Виручка,  "ЧДЦ=2")));
Повідомити(ШаблонРядка("  Собівартість:          %1 грн", Формат(Собіварт, "ЧДЦ=2")));
Повідомити(ШаблонРядка("  Валовий прибуток:      %1 грн", Формат(ВалПриб,  "ЧДЦ=2")));
Якщо Виручка > 0 Тоді
    Повідомити(ШаблонРядка("  Рентабельність:        %1%%",
        Формат(ОкруглитиСуму(ВалПриб / Виручка * 100), "ЧДЦ=1")));
КінецьЯкщо;

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP — Реалізація товарів (українська мова) — завершено");
Повідомити("══════════════════════════════════════════════════════════════════");
