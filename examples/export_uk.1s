// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Експорт звітів в Excel / CSV
// Демо: ОСВ + P&L → .xlsx з форматуванням
// ══════════════════════════════════════════════════════════════════════

// ── Налаштування ─────────────────────────────────────────────────────
ФайлExcel = "звіт_cічень_2025.xlsx";
ФайлCSV   = "осв_cічень_2025.csv";

// ── Бухгалтерські дані ────────────────────────────────────────────────
ПланРах = ПланРахунків("УКСГП");
ПланРах.Додати("10","Основні засоби"); ПланРах.Додати("20","Запаси");
ПланРах.Додати("31","Банк"); ПланРах.Додати("36","Дебітори");
ПланРах.Додати("40","Капітал"); ПланРах.Додати("63","Кредитори");
ПланРах.Додати("70","Доходи"); ПланРах.Додати("90","Собівартість");
ПланРах.Додати("92","Адм.витрати");

РегБух = РегістрБухгалтерії("Журнал", ПланРах);
ДатВх = '20241231'; ПС = '20250101'; ПК = '20250131';
Д = '20250115';

РегБух.Провести(ДатВх,"Вх","Вхідне сальдо ОЗ",    "10","40",150000);
РегБух.Провести(ДатВх,"Вх","Вхідне сальдо запасів","20","63", 25000);
РегБух.Провести(Д,"РН001","Дохід",                 "36","70",120000);
РегБух.Провести(Д,"РН001","Собівартість",           "90","20", 35000);
РегБух.Провести(Д,"ВН001","Зарплата",               "92","63", 25000);
РегБух.Провести(Д,"ВН001","ЄСВ",                    "92","63",  5500);
РегБух.Провести(Д,"ПП001","Оплата постачальнику",   "63","31", 50000);
РегБух.Провести(Д,"ПП002","Надходження від клієнта","31","36",120000);

// ── Будуємо ТаблицяЗначень для ОСВ ───────────────────────────────────
ТаблОСВ = ТаблицяЗначень();
ТаблОСВ.Колонки.Додати("Рахунок"); ТаблОСВ.Колонки.Додати("Назва");
ТаблОСВ.Колонки.Додати("ПочДт");   ТаблОСВ.Колонки.Додати("ПочКт");
ТаблОСВ.Колонки.Додати("ОборДт");  ТаблОСВ.Колонки.Додати("ОборКт");
ТаблОСВ.Колонки.Додати("КінДт");   ТаблОСВ.Колонки.Додати("КінКт");

Для Кожного Рах З ПланРах Цикл
    БП = РегБух.Залишок(Рах, ДатВх);
    Об = РегБух.Оборот(Рах, ПС, ПК);
    СПД = БП["Дт"]; СПК = БП["Кт"];
    ОД  = Об["ОборотДт"]; ОК = Об["ОборотКт"];
    Якщо СПД + СПК + ОД + ОК = 0 Тоді  Продовжити;  КінецьЯкщо;
    Нетто = СПД - СПК + ОД - ОК;
    Якщо Нетто >= 0 Тоді  СКД = Нетто; СКК = 0;
    Інакше                 СКД = 0;     СКК = -Нетто;  КінецьЯкщо;
    Р = ТаблОСВ.Додати();
    Р["Рахунок"] = Рах.Код; Р["Назва"] = Рах.Назва;
    Р["ПочДт"] = СПД; Р["ПочКт"] = СПК;
    Р["ОборДт"] = ОД; Р["ОборКт"] = ОК;
    Р["КінДт"] = СКД; Р["КінКт"] = СКК;
КінецьЦиклу;

// ── P&L таблиця ───────────────────────────────────────────────────────
О70 = РегБух.Оборот(ПланРах.НайтиЗаКодом("70"), ПС, ПК);
О90 = РегБух.Оборот(ПланРах.НайтиЗаКодом("90"), ПС, ПК);
О92 = РегБух.Оборот(ПланРах.НайтиЗаКодом("92"), ПС, ПК);
Виручка = О70["ОборотКт"]; Собів = О90["ОборотДт"];
Валов = Виручка - Собів; АВ = О92["ОборотДт"]; ОперПр = Валов - АВ;

ТаблPnL = ТаблицяЗначень();
ТаблPnL.Колонки.Додати("Стаття"); ТаблPnL.Колонки.Додати("Сума"); ТаблPnL.Колонки.Додати("Коментар");

Перем РПнЛ;
РПнЛ = ТаблPnL.Додати(); РПнЛ["Стаття"] = "Виручка від реалізації";        РПнЛ["Сума"] = Виручка; РПнЛ["Коментар"] = "Рах. 70";
РПнЛ = ТаблPnL.Додати(); РПнЛ["Стаття"] = "Собівартість реалізації";       РПнЛ["Сума"] = -Собів;  РПнЛ["Коментар"] = "Рах. 90";
РПнЛ = ТаблPnL.Додати(); РПнЛ["Стаття"] = "ВАЛОВИЙ ПРИБУТОК";             РПнЛ["Сума"] = Валов;   РПнЛ["Коментар"] = "";
РПнЛ = ТаблPnL.Додати(); РПнЛ["Стаття"] = "Адміністративні витрати";      РПнЛ["Сума"] = -АВ;     РПнЛ["Коментар"] = "Рах. 92";
РПнЛ = ТаблPnL.Додати(); РПнЛ["Стаття"] = "ОПЕРАЦІЙНИЙ ПРИБУТОК";         РПнЛ["Сума"] = ОперПр;  РПнЛ["Коментар"] = Рядок(Окр(ОперПр/Виручка*100,1)) + "%";

// ── Записуємо в Excel ─────────────────────────────────────────────────
Книга = КнигаExcel();

// Аркуш 1: ОСВ
Ар1 = Книга.ДодатиАркуш("ОСВ Cічень 2025");
Ар1.ВстановитиЗаголовок("ОБОРОТНО-САЛЬДОВА ВІДОМІСТЬ  ·  Cічень 2025  ·  Підпр. «Альфа»");
Ар1.ВстановитиШапку("Рах., Назва, Поч.Дт, Поч.Кт, Об.Дт, Об.Кт, Кін.Дт, Кін.Кт");
Для Кожного Р З ТаблОСВ Цикл
    Рдн = Масив();
    Рдн.Додати(Р["Рахунок"]); Рдн.Додати(Р["Назва"]);
    Рдн.Додати(Р["ПочДт"]); Рдн.Додати(Р["ПочКт"]);
    Рдн.Додати(Р["ОборДт"]); Рдн.Додати(Р["ОборКт"]);
    Рдн.Додати(Р["КінДт"]); Рдн.Додати(Р["КінКт"]);
    Ар1.ДодатиРядок(Рдн);
КінецьЦиклу;
Ар1.АвтоШирина();

// Аркуш 2: P&L
Ар2 = Книга.ДодатиАркуш("P&L");
Ар2.ВстановитиЗаголовок("ЗВІТ ПРО ФІНАНСОВІ РЕЗУЛЬТАТИ  ·  Cічень 2025");
Ар2.ВстановитиШапку("Стаття, Сума грн, Коментар");
Для Кожного Р З ТаблPnL Цикл
    Рдн = Масив(); Рдн.Додати(Р["Стаття"]); Рдн.Додати(Р["Сума"]); Рдн.Додати(Р["Коментар"]);
    Ар2.ДодатиРядок(Рдн);
КінецьЦиклу;
Ар2.АвтоШирина();

Книга.Зберегти(ФайлExcel);

// ── Також CSV (без залежностей) ───────────────────────────────────────
ЕксельЗбереження(ТаблОСВ, ФайлCSV);

// ── Вивід результату ──────────────────────────────────────────────────
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  ЕКСПОРТ ЗВІТІВ У EXCEL / CSV — завершено");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити(ШаблонРядка("  Excel: %1", ФайлExcel));
Повідомити(ШаблонРядка("  CSV:   %1", ФайлCSV));
Повідомити(ШаблонРядка("  Рядків в ОСВ: %1  |  Рядків у P&L: %2",
    ТаблОСВ.Кількість(), ТаблPnL.Кількість()));
Повідомити("  Відкрийте файл у Microsoft Excel або LibreOffice Calc");
Повідомити("══════════════════════════════════════════════════════════════════");
