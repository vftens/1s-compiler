// Sprint 14 демо: Призначення ресурсів (Українська)
// Мінімізуємо загальний час призначення співробітників по проектах.

РА = НовийАллокаторРесурсів();
РА.ДодатиРесурс("Іваненко", 160);
РА.ДодатиРесурс("Петренко", 120);
РА.ДодатиРесурс("Сидоренко", 80);

РА.ДодатиЗадачу("Проект Альфа", 100);
РА.ДодатиЗадачу("Проект Бета", 80);
РА.ДодатиЗадачу("Проект Гамма", 60);

Результат = РА.Вирішити();

Повідомити("=== Оптимальне призначення ресурсів (GLPK 5.0) ===");
Повідомити("Статус: " + Результат.Статус);
Якщо Результат.Статус = "optimal" Тоді
    Повідомити("Цільове значення: " + Рядок(Результат.ЦільовеЗначення));
    Повідомити("Розподіл виконано успішно.");
КінецьЯкщо;
