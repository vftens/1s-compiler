// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Маршрут погодження (Workflow / BPM)
// Сценарій: менеджер створює закупівлю → бухгалтер → директор погоджує
// ══════════════════════════════════════════════════════════════════════

// ── Помічники ────────────────────────────────────────────────────────
Функція Статус(Назва, Статус)
    Повідомити(ШаблонРядка("  [%1]  Статус: %2", Назва, Статус));
КінецьФункції;

Функція Подія(Дія, Хто, Коментар)
    Повідомити(ШаблонРядка("  ➤  %1 → %2   «%3»", Дія, Хто, Коментар));
КінецьФункції;

// ── Довідники ────────────────────────────────────────────────────────
Постачальники = Справочник("Постачальники");
ТОВМатПлюс = Постачальники.Створити("П001", "ТОВ «МатеріалПлюс»");

Товари = Справочник("Номенклатура");
Папір = Товари.Створити("Т001", "Папір A4, 500 арк.");
Папір.Ціна = 120;

// ── Журнал аудиту ────────────────────────────────────────────────────
Журнал = АудитЖурнал("Закупівлі");

// ══════════════════════════════════════════════════════════════════════
Повідомити("══════════════════════════════════════════════════════════════");
Повідомити("  МАРШРУТ ПОГОДЖЕННЯ ЗАКУПІВЛІ  ·  Підприємство «Альфа»");
Повідомити("══════════════════════════════════════════════════════════════");

// ── Крок 1: Менеджер створює заявку ─────────────────────────────────
Повідомити("");
Повідомити("── КРОК 1: Менеджер Іваненко створює заявку на закупівлю ────");

ЗЗ = ДокументЗМаршрутом("ЗаявкаЗакупівлі");
ЗЗ.Дата        = '20250120';
ЗЗ.Постачальник = ТОВМатПлюс;
ЗЗ.Менеджер    = "Іваненко О.М.";

Рядки = ЗЗ.ТабличнаЧастина("Товари", "Товар, Кількість, Ціна, Сума");
Р = Рядки.Додати();
Р["Товар"]     = Папір.Назва;
Р["Кількість"] = 50;
Р["Ціна"]      = Папір.Ціна;
Р["Сума"]      = 50 * Папір.Ціна;

СумаЗЗ = Рядки.Підсумок("Сума");
Журнал.Записати("Іваненко", "Створення", "ЗаявкаЗакупівлі", ЗЗ.Номер,
    "Заявка на " + Рядок(СумаЗЗ) + " грн");

Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("uk"));
Повідомити(ШаблонРядка("  Постачальник: %1  |  Сума: %2 грн", ЗЗ.Постачальник, СумаЗЗ));

// ── Крок 2: Подача на погодження ─────────────────────────────────────
Повідомити("");
Повідомити("── КРОК 2: Подача на погодження до бухгалтера ────────────────");

ЗЗ.Надіслати("Іваненко", "Прошу погодити — термінова потреба");
Журнал.Записати("Іваненко", "Надіслати", "ЗаявкаЗакупівлі", ЗЗ.Номер,
    "Надіслано на погодження");
Подія("Надіслано", "Іваненко", "Прошу погодити — термінова потреба");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("uk"));

// ── Крок 3: Бухгалтер повертає на доопрацювання ──────────────────────
Повідомити("");
Повідомити("── КРОК 3: Бухгалтер Петренко — потрібне уточнення ──────────");

ЗЗ.НаДоопрацювання("Петренко", "Вкажіть рахунок витрат та центр витрат");
Журнал.Записати("Петренко", "НаДоопрацювання", "ЗаявкаЗакупівлі", ЗЗ.Номер,
    "Повернено: відсутні реквізити");
Подія("На доопрацювання", "Петренко", "Вкажіть рахунок витрат та центр витрат");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("uk"));

// ── Крок 4: Менеджер виправляє і перенадсилає ────────────────────────
Повідомити("");
Повідомити("── КРОК 4: Іваненко додає реквізити та перенадсилає ─────────");

ЗЗ.РахунокВитрат = "92 Адміністративні витрати";
ЗЗ.ЦентрВитрат   = "ЦВ-001 Офіс";
ЗЗ.Перенадіслати("Іваненко", "Додав рахунок витрат та центр витрат");
Журнал.Записати("Іваненко", "Перенадіслати", "ЗаявкаЗакупівлі", ЗЗ.Номер,
    "Виправлено та перенадіслано");
Подія("Перенадіслано", "Іваненко", "Додав рахунок витрат та центр витрат");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("uk"));

// ── Крок 5: Директор погоджує ────────────────────────────────────────
Повідомити("");
Повідомити("── КРОК 5: Директор Коваленко погоджує ──────────────────────");

ЗЗ.Погодити("Коваленко (Директор)", "Погоджено. Сума в межах бюджету.");
Журнал.Записати("Коваленко", "Погодити", "ЗаявкаЗакупівлі", ЗЗ.Номер,
    "Погоджено директором");
Подія("Погоджено", "Коваленко", "Погоджено. Сума в межах бюджету.");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("uk"));

// ── Крок 6: Автоматичне проведення ───────────────────────────────────
Повідомити("");
Повідомити("── КРОК 6: Автоматичне проведення після погодження ──────────");

ЗЗ.Провести();
Журнал.Записати("Система", "Провести", "ЗаявкаЗакупівлі", ЗЗ.Номер,
    "Автоматично проведено після погодження");
Статус(ЗЗ.Номер, ЗЗ.МетаСтатус("uk"));
Повідомити(ШаблонРядка("  Документ проведено: %1", ЗЗ.Проведён ? "ТАК" : "НІ"));

// ── Повний журнал переходів ───────────────────────────────────────────
Повідомити("");
Повідомити("── ЖУРНАЛ МАРШРУТУ ───────────────────────────────────────────");
ЗЗ.ВивідЖурналу("uk");

// ── Журнал аудиту ────────────────────────────────────────────────────
Повідомити("");
Повідомити("── ЖУРНАЛ АУДИТУ ─────────────────────────────────────────────");
Повідомити(ШаблонРядка("  Усього записів: %1", Журнал.Кількість()));
Журнал.Вивести(10);

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP — Маршрут погодження (українська) — завершено");
Повідомити("══════════════════════════════════════════════════════════════");
