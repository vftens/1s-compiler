// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — ДЕМО: Cython — Ускорение числовых вычислений
// ══════════════════════════════════════════════════════════════════════
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("  DEMO CYTHON — Скорость числовых вычислений в 1S: ERP");
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("");

// ── Тест 1: Числа Фибоначчи ────────────────────────────────────────────
Сообщить("── Тест 1: Числа Фибоначчи (рекурсия, n=30) ─────────────────────────");

Функция Фиб(Н)
    Если Н <= 1 Тогда  Возврат Н;  КонецЕсли;
    Возврат Фиб(Н-1) + Фиб(Н-2);
КонецФункции;

ВремяНач = ВремяСейчас();
Рез = Фиб(30);
ВремяКон = ВремяСейчас();
ВрPy = Окр((ВремяКон - ВремяНач) * 1000, 1);
Сообщить(СтрШаблон("  Фиб(30) = %1   |   Время (Python): %2 мс", Рез, ВрPy));
Сообщить("  Cython: ~2-5 мс  (ожидаемое ускорение 5-20×)");
Сообщить("");

// ── Тест 2: Простые числа ─────────────────────────────────────────────
Сообщить("── Тест 2: Простые числа до 10,000 (решето Эратосфена) ─────────────");

Нач2 = ВремяСейчас();
МаксН = 10000; КолПрост = 0;
Решето = Массив();
Для К = 0 По МаксН Цикл  Решето.Добавить(Истина);  КонецЦикла;
Для К = 2 По МаксН Цикл
    Если Решето[К] = Истина Тогда
        КолПрост = КолПрост + 1;
        М = К + К;
        Пока М <= МаксН Цикл  Решето.Установить(М, Ложь);  М = М + К;  КонецЦикла;
    КонецЕсли;
КонецЦикла;
Кон2 = ВремяСейчас();
Вр2 = Окр((Кон2 - Нач2) * 1000, 1);
Сообщить(СтрШаблон("  Простых чисел до 10000: %1   |   Время: %2 мс", КолПрост, Вр2));
Сообщить("  Cython: ~0.1-0.5 мс  (ожидаемое ускорение 10-50×)");
Сообщить("");

// ── Тест 3: Накопительный счётчик ────────────────────────────────────
Сообщить("── Тест 3: Сумма 1..100,000 ─────────────────────────────────────────");
Нач3 = ВремяСейчас();
Сумма = 0;
Для К = 1 По 100000 Цикл  Сумма = Сумма + К;  КонецЦикла;
Кон3 = ВремяСейчас();
Вр3 = Окр((Кон3 - Нач3) * 1000, 1);
Сообщить(СтрШаблон("  Σ(1..100000) = %1   |   Время: %2 мс", Сумма, Вр3));
Сообщить("  Cython (cdef long): ~0.5-2 мс  (ожидаемое ускорение 10-30×)");
Сообщить("");

// ── Инструкция по сборке ──────────────────────────────────────────────
ОбщВр = Окр(ВрPy + Вр2 + Вр3, 1);
Сообщить("── Сборка Cython-версии ─────────────────────────────────────────────");
Сообщить("  Шаг 1:  python -m src.cli cython-gen  examples/demo_cython_ru.1s");
Сообщить("  Шаг 2:  python -m src.cli cython-build examples/demo_cython_ru.1s --run");
Сообщить("  Или:    pip install cython && python -m src.cli cython-build ... --run");
Сообщить("");
Сообщить("  Что даёт Cython:");
Сообщить("    cdef long Сумма = 0   ← машинный int вместо Python int");
Сообщить("    cpdef long Фиб(long Н) ← C-уровень вызов");
Сообщить("    cdivision=True / boundscheck=False ← без Python overhead");
Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  Общее время Python: %1 мс   Cython: ожидается ~10-50× быстрее", ОбщВр));
Сообщить("  1S: ERP — Cython Demo (русский) — завершено");
Сообщить("══════════════════════════════════════════════════════════════════════");
