// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Экспорт отчётов в Excel / CSV
// ══════════════════════════════════════════════════════════════════════
ФайлExcel = "otchet_yanvar_2025.xlsx";
ФайлCSV   = "osv_yanvar_2025.csv";

ПланСч = ПланСчетов("Общий");
ПланСч.ДобавитьСчёт("10","Осн.средства"); ПланСч.ДобавитьСчёт("20","Запасы");
ПланСч.ДобавитьСчёт("31","Банк"); ПланСч.ДобавитьСчёт("36","Дебиторы");
ПланСч.ДобавитьСчёт("40","Капитал"); ПланСч.ДобавитьСчёт("63","Кредиторы");
ПланСч.ДобавитьСчёт("70","Доходы"); ПланСч.ДобавитьСчёт("90","Себест.");
ПланСч.ДобавитьСчёт("92","Адм.расх.");

РегБух = РегистрБухгалтерии("Журнал", ПланСч);
НаДату = '20241231'; НачДата = '20250101'; КонДата = '20250131'; Д = '20250115';

РегБух.Провести(НаДату,"Вх","Вх.сальдо ОС",        "10","40",150000);
РегБух.Провести(НаДату,"Вх","Вх.сальдо запасов",    "20","63", 25000);
РегБух.Провести(Д,"РН001","Выручка",                "36","70",120000);
РегБух.Провести(Д,"РН001","Себестоимость",           "90","20", 35000);
РегБух.Провести(Д,"ВН001","ЗП + взносы",            "92","63", 30500);
РегБух.Провести(Д,"ПП001","Оплата поставщику",      "63","31", 50000);
РегБух.Провести(Д,"ПП002","Поступление от клиента", "31","36",120000);

// Таблица ОСВ
ТОсв = ТаблицаЗначений();
ТОсв.Колонки.Добавить("Счёт"); ТОсв.Колонки.Добавить("Наименование");
ТОсв.Колонки.Добавить("НачДт"); ТОсв.Колонки.Добавить("НачКт");
ТОсв.Колонки.Добавить("ОборДт"); ТОсв.Колонки.Добавить("ОборКт");
ТОсв.Колонки.Добавить("КонДт"); ТОсв.Колонки.Добавить("КонКт");
Для Каждого Сч Из ПланСч Цикл
    БП = РегБух.Остаток(Сч, НаДату);
    Об = РегБух.Оборот(Сч, НачДата, КонДата);
    НД = БП["Дт"]; НК = БП["Кт"]; ОД = Об["ОборотДт"]; ОК = Об["ОборотКт"];
    Если НД + НК + ОД + ОК = 0 Тогда  Продолжить;  КонецЕсли;
    Нт = НД - НК + ОД - ОК;
    Если Нт >= 0 Тогда  КД = Нт; КК = 0;
    Иначе                КД = 0;   КК = -Нт;  КонецЕсли;
    Р = ТОсв.Добавить();
    Р["Счёт"] = Сч.Код; Р["Наименование"] = Сч.Наименование;
    Р["НачДт"] = НД; Р["НачКт"] = НК;
    Р["ОборДт"] = ОД; Р["ОборКт"] = ОК;
    Р["КонДт"] = КД; Р["КонКт"] = КК;
КонецЦикла;

// P&L
О70 = РегБух.Оборот(ПланСч.НайтиПоКоду("70"), НачДата, КонДата);
О90 = РегБух.Оборот(ПланСч.НайтиПоКоду("90"), НачДата, КонДата);
О92 = РегБух.Оборот(ПланСч.НайтиПоКоду("92"), НачДата, КонДата);
Выр = О70["ОборотКт"]; Сб = О90["ОборотДт"];
ВалП = Выр - Сб; АР = О92["ОборотДт"]; ОпП = ВалП - АР;

ТПнЛ = ТаблицаЗначений();
ТПнЛ.Колонки.Добавить("Показатель"); ТПнЛ.Колонки.Добавить("Сумма, руб."); ТПнЛ.Колонки.Добавить("Примечание");

Р = ТПнЛ.Добавить(); Р["Показатель"] = "Выручка";              Р["Сумма, руб."] = Выр;   Р["Примечание"] = "сч.70";
Р = ТПнЛ.Добавить(); Р["Показатель"] = "Себестоимость";        Р["Сумма, руб."] = -Сб;   Р["Примечание"] = "сч.90";
Р = ТПнЛ.Добавить(); Р["Показатель"] = "ВАЛОВАЯ ПРИБЫЛЬ";      Р["Сумма, руб."] = ВалП;  Р["Примечание"] = "";
Р = ТПнЛ.Добавить(); Р["Показатель"] = "Административные расх."; Р["Сумма, руб."] = -АР; Р["Примечание"] = "сч.92";
Р = ТПнЛ.Добавить(); Р["Показатель"] = "ОПЕРАЦИОННАЯ ПРИБЫЛЬ"; Р["Сумма, руб."] = ОпП;   Р["Примечание"] = Строка(Окр(ОпП/Выр*100,1)) + "%";

// Экспорт в Excel
Книга = КнигаExcel();
Л1 = Книга.ДобавитьЛист("ОСВ Январь 2025");
Л1.УстановитьЗаголовок("ОБОРОТНО-САЛЬДОВАЯ ВЕДОМОСТЬ  ·  Январь 2025  ·  ООО «Альфа»");
Л1.УстановитьШапку("Сч., Наименование, Нач.Дт, Нач.Кт, Об.Дт, Об.Кт, Кон.Дт, Кон.Кт");
Для Каждого Р Из ТОсв Цикл
    Стр = Массив(); Стр.Добавить(Р["Счёт"]); Стр.Добавить(Р["Наименование"]);
    Стр.Добавить(Р["НачДт"]); Стр.Добавить(Р["НачКт"]);
    Стр.Добавить(Р["ОборДт"]); Стр.Добавить(Р["ОборКт"]);
    Стр.Добавить(Р["КонДт"]); Стр.Добавить(Р["КонКт"]);
    Л1.ДобавитьСтроку(Стр);
КонецЦикла;
Л1.АвтоШирина();

Л2 = Книга.ДобавитьЛист("P&L");
Л2.УстановитьЗаголовок("ОТЧЁТ О ФИНАНСОВЫХ РЕЗУЛЬТАТАХ  ·  Январь 2025");
Л2.УстановитьШапку("Показатель, Сумма руб., Примечание");
Для Каждого Р Из ТПнЛ Цикл
    Стр = Массив(); Стр.Добавить(Р["Показатель"]); Стр.Добавить(Р["Сумма, руб."]); Стр.Добавить(Р["Примечание"]);
    Л2.ДобавитьСтроку(Стр);
КонецЦикла;
Л2.АвтоШирина();
Книга.Сохранить(ФайлExcel);
ЭкспортCSV(ТОсв, ФайлCSV);

Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  ЭКСПОРТ ОТЧЁТОВ В EXCEL / CSV — завершено");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("  Excel: %1  |  Строк ОСВ: %2", ФайлExcel, ТОсв.Количество()));
Сообщить(СтрШаблон("  CSV:   %1", ФайлCSV));
Сообщить("  Откройте файл в Microsoft Excel или LibreOffice Calc");
Сообщить("══════════════════════════════════════════════════════════════════");
