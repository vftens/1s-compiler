// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Шахматна відомість (оборотна матриця Дт × Кт)
// Виробниче підприємство «Альфа», Січень 2025 р.
// ══════════════════════════════════════════════════════════════════════

// ── Форматування клітинки: число або порожньо, праворуч ─────────────
Функція Кл(Знч, Ш)
    Якщо Знч = 0 Тоді
        Повернути ШаблонРядка("%" + Рядок(Ш) + "s", "");
    КінецьЯкщо;
    Повернути Формат(Знч, "ЧЦ=" + Рядок(Ш));
КінецьФункції;

// ── Роздільна лінія (динамічна ширина) ──────────────────────────────
Функція Лінія(Колонки, ШКол, ШШапки)
    Перем Р;
    Р = ШаблонРядка("%-" + Рядок(ШШапки) + "s", "");
    Р = СтрЗаменить(Р, " ", "─");
    Для Кожного Ігнор З Колонки Цикл
        Р = Р + "+" + СтрПовтор("─", ШКол + 1);
    КінецьЦиклу;
    Р = Р + "+" + СтрПовтор("─", ШКол + 2);
    Повернути Р;
КінецьФункції;

// ── 1. План рахунків УКСГП ──────────────────────────────────────────
ПланРах = ПланРахунків("УКСГП");
ПланРах.Додати("10", "Основні засоби");
ПланРах.Додати("20", "Виробничі запаси");
ПланРах.Додати("31", "Рахунки в банках");
ПланРах.Додати("36", "Розрахунки з покупцями");
ПланРах.Додати("40", "Статутний капітал");
ПланРах.Додати("63", "Розрахунки з постачальниками");
ПланРах.Додати("65", "Страхування");
ПланРах.Додати("66", "Розрахунки з персоналом");
ПланРах.Додати("70", "Доходи від реалізації");
ПланРах.Додати("90", "Собівартість реалізації");
ПланРах.Додати("92", "Адміністративні витрати");

// ── 2. Регістр бухгалтерії ──────────────────────────────────────────
РегБух = РегістрБухгалтерії("ГоловнаКнига", ПланРах);

Перем Д;
Д = '20250115';

РегБух.Провести(Д,"СтатКап","Внесок засновника",           "10","40",200000);
РегБух.Провести(Д,"Нак001", "Придбання виробничих запасів", "20","63", 50000);
РегБух.Провести(Д,"РН001",  "Реалізація — визнання доходу", "36","70",120000);
РегБух.Провести(Д,"РН001",  "Списання собівартості",        "90","20", 35000);
РегБух.Провести(Д,"ВН001",  "Нарахування заробітної плати", "92","66", 25000);
РегБух.Провести(Д,"ВН001",  "Нарахування ЄСВ",              "92","65",  5500);
РегБух.Провести(Д,"ПП001",  "Оплата постачальнику",         "63","31", 50000);
РегБух.Провести(Д,"ПП002",  "Надходження від покупця",      "31","36",120000);

// ── 3. Будуємо матрицю ──────────────────────────────────────────────
Матриця = Відповідність();   // "Дт_Кт" → сума
СумиДт  = Відповідність();   // код_Дт  → підсумок
СумиКт  = Відповідність();   // код_Кт  → підсумок

Вибір = РегБух.Вибрати();
Поки Вибір.Наступний() Цикл
    Зап  = Вибір.Поточний();
    Дт   = Зап.AccountDt;
    Кт   = Зап.AccountKt;
    Ключ = Дт + "_" + Кт;

    Якщо Матриця[Ключ]  = Невизначено Тоді  Матриця[Ключ]  = 0;  КінецьЯкщо;
    Якщо СумиДт[Дт]     = Невизначено Тоді  СумиДт[Дт]     = 0;  КінецьЯкщо;
    Якщо СумиКт[Кт]     = Невизначено Тоді  СумиКт[Кт]     = 0;  КінецьЯкщо;

    Матриця[Ключ] = Матриця[Ключ] + Зап.Amount;
    СумиДт[Дт]    = СумиДт[Дт]    + Зап.Amount;
    СумиКт[Кт]    = СумиКт[Кт]    + Зап.Amount;
КінецьЦиклу;

// ── 4. Збираємо рахунки в порядку плану ─────────────────────────────
МасДт = Масив();
МасКт = Масив();
Вибір2 = ПланРах.Вибрати();
Поки Вибір2.Наступний() Цикл
    Рах = Вибір2.Поточний();
    Код = Рах.Код;
    Якщо СумиДт[Код] <> Невизначено Тоді  МасДт.Додати(Код);  КінецьЯкщо;
    Якщо СумиКт[Код] <> Невизначено Тоді  МасКт.Додати(Код);  КінецьЯкщо;
КінецьЦиклу;

// ── 5. Виводимо шахматну відомість ──────────────────────────────────
Перем В, ВШ;
В  = 8;   // ширина числової колонки
ВШ = 7;   // ширина рядка-заголовку (код рахунку)

Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("          ШАХМАТНА ВІДОМІСТЬ · Підприємство «Альфа» · Січень 2025");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("");

// Заголовок колонок Кт →
Р = ШаблонРядка("%-" + Рядок(ВШ) + "s", "Дт╲Кт");
Для Кожного КодКт З МасКт Цикл
    Р = Р + "|" + ШаблонРядка("%" + Рядок(В) + "s", КодКт);
КінецьЦиклу;
Р = Р + "|" + ШаблонРядка("%" + Рядок(В+1) + "s", "РАЗОМ Дт");
Повідомити(Р);
Повідомити(Лінія(МасКт, В, ВШ));

// Рядки Дт ↓
Для Кожного КодДт З МасДт Цикл
    Р = ШаблонРядка("%-" + Рядок(ВШ) + "s", КодДт);
    РазомДт = 0;
    Для Кожного КодКт З МасКт Цикл
        Ключ = КодДт + "_" + КодКт;
        Сума = Матриця[Ключ];
        Якщо Сума = Невизначено Тоді  Сума = 0;  КінецьЯкщо;
        РазомДт = РазомДт + Сума;
        Р = Р + "|" + Кл(Сума, В);
    КінецьЦиклу;
    Р = Р + "|" + Кл(РазомДт, В+1);
    Повідомити(Р);
КінецьЦиклу;

// Роздільна + підсумки Кт
Повідомити(Лінія(МасКт, В, ВШ));
Р = ШаблонРядка("%-" + Рядок(ВШ) + "s", "РАЗОМ Кт");
РазомВсього = 0;
Для Кожного КодКт З МасКт Цикл
    Сума = СумиКт[КодКт];
    Якщо Сума = Невизначено Тоді  Сума = 0;  КінецьЯкщо;
    РазомВсього = РазомВсього + Сума;
    Р = Р + "|" + Кл(Сума, В);
КінецьЦиклу;
Р = Р + "|" + Кл(РазомВсього, В+1);
Повідомити(Р);

// ── 6. Легенда рахунків ──────────────────────────────────────────────
Повідомити("");
Повідомити("── Легенда ─────────────────────────────────────────────────────────");
ВсіКоди = Масив();
Для Кожного К З МасДт Цикл  ВсіКоди.Додати(К);  КінецьЦиклу;
Для Кожного К З МасКт Цикл
    Якщо ВсіКоди.Знайти(К) = Невизначено Тоді  ВсіКоди.Додати(К);  КінецьЯкщо;
КінецьЦиклу;
Для Кожного Код З ВсіКоди Цикл
    Рах = ПланРах.НайтиЗаКодом(Код);
    Повідомити(ШаблонРядка("  %1  %2", Код, Рах.Назва));
КінецьЦиклу;

// ── 7. Перевірка балансу ─────────────────────────────────────────────
Повідомити("");
Повідомити(ШаблонРядка("  Загальний оборот: %1 грн  (Σ Дт = Σ Кт ✓)", РазомВсього));
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP — Шахматна відомість (українська мова) — завершено");
Повідомити("══════════════════════════════════════════════════════════════════════");
