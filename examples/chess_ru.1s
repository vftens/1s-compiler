// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Шахматная ведомость (оборотная матрица Дт × Кт)
// Производственное предприятие «Альфа», Январь 2025 г.
// ══════════════════════════════════════════════════════════════════════

// ── Форматирование ячейки: число или пробелы, выравнивание вправо ────
Функция Кл(Знч, Ш)
    Если Знч = 0 Тогда
        Возврат СтрШаблон("%" + Строка(Ш) + "s", "");
    КонецЕсли;
    Возврат Формат(Знч, "ЧЦ=" + Строка(Ш));
КонецФункции;

// ── Разделительная линия (динамическая) ─────────────────────────────
Функция Линия(Колонки, ШКол, ШШапки)
    Перем Р;
    Р = СтрШаблон("%-" + Строка(ШШапки) + "s", "");
    Р = СтрЗаменить(Р, " ", "─");
    Для Каждого Игнор Из Колонки Цикл
        Р = Р + "+" + СтрПовтор("─", ШКол + 1);
    КонецЦикла;
    Р = Р + "+" + СтрПовтор("─", ШКол + 2);
    Возврат Р;
КонецФункции;

// ── 1. План счетов ──────────────────────────────────────────────────
ПланСч = ПланСчетов("Общий");
ПланСч.ДобавитьСчёт("10", "Основные средства");
ПланСч.ДобавитьСчёт("20", "Производственные запасы");
ПланСч.ДобавитьСчёт("31", "Расчётные счета");
ПланСч.ДобавитьСчёт("36", "Расчёты с покупателями");
ПланСч.ДобавитьСчёт("40", "Уставный капитал");
ПланСч.ДобавитьСчёт("63", "Расчёты с поставщиками");
ПланСч.ДобавитьСчёт("65", "Страхование");
ПланСч.ДобавитьСчёт("66", "Расчёты с персоналом");
ПланСч.ДобавитьСчёт("70", "Доходы от реализации");
ПланСч.ДобавитьСчёт("90", "Себестоимость реализации");
ПланСч.ДобавитьСчёт("92", "Административные расходы");

// ── 2. Регистр бухгалтерии ──────────────────────────────────────────
РегБух = РегистрБухгалтерии("ГлавнаяКнига", ПланСч);

Перем Д;
Д = '20250115';

РегБух.Провести(Д,"СтатКап","Вклад учредителя",              "10","40",200000);
РегБух.Провести(Д,"Нак001", "Приобретение производ. запасов", "20","63", 50000);
РегБух.Провести(Д,"РН001",  "Реализация — признание дохода",  "36","70",120000);
РегБух.Провести(Д,"РН001",  "Списание себестоимости",         "90","20", 35000);
РегБух.Провести(Д,"ВН001",  "Начисление заработной платы",    "92","66", 25000);
РегБух.Провести(Д,"ВН001",  "Начисление страховых взносов",   "92","65",  5500);
РегБух.Провести(Д,"ПП001",  "Оплата поставщику",              "63","31", 50000);
РегБух.Провести(Д,"ПП002",  "Поступление от покупателя",      "31","36",120000);

// ── 3. Строим матрицу ───────────────────────────────────────────────
Матрица  = Соответствие();
СуммыДт  = Соответствие();
СуммыКт  = Соответствие();

Выборка = РегБух.Выбрать();
Пока Выборка.Следующий() Цикл
    Зап  = Выборка.Текущий();
    Дт   = Зап.AccountDt;
    Кт   = Зап.AccountKt;
    Ключ = Дт + "_" + Кт;

    Если Матрица[Ключ] = Неопределено Тогда  Матрица[Ключ] = 0;  КонецЕсли;
    Если СуммыДт[Дт]   = Неопределено Тогда  СуммыДт[Дт]   = 0;  КонецЕсли;
    Если СуммыКт[Кт]   = Неопределено Тогда  СуммыКт[Кт]   = 0;  КонецЕсли;

    Матрица[Ключ] = Матрица[Ключ] + Зап.Amount;
    СуммыДт[Дт]   = СуммыДт[Дт]   + Зап.Amount;
    СуммыКт[Кт]   = СуммыКт[Кт]   + Зап.Amount;
КонецЦикла;

// ── 4. Счета в порядке плана ────────────────────────────────────────
МасДт = Массив();
МасКт = Массив();
Выборка2 = ПланСч.Select();
Пока Выборка2.Next() Цикл
    Сч  = Выборка2.Current();
    Код = Сч.Код;
    Если СуммыДт[Код] <> Неопределено Тогда  МасДт.Добавить(Код);  КонецЕсли;
    Если СуммыКт[Код] <> Неопределено Тогда  МасКт.Добавить(Код);  КонецЕсли;
КонецЦикла;

// ── 5. Вывод шахматной ведомости ────────────────────────────────────
Перем В, ВШ;
В  = 8;
ВШ = 7;

Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("          ШАХМАТНАЯ ВЕДОМОСТЬ · Предприятие «Альфа» · Январь 2025");
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("");

// Шапка
Р = СтрШаблон("%-" + Строка(ВШ) + "s", "Дт╲Кт");
Для Каждого КодКт Из МасКт Цикл
    Р = Р + "|" + СтрШаблон("%" + Строка(В) + "s", КодКт);
КонецЦикла;
Р = Р + "|" + СтрШаблон("%" + Строка(В+1) + "s", "ИТОГО Дт");
Сообщить(Р);
Сообщить(Линия(МасКт, В, ВШ));

// Строки Дт
Для Каждого КодДт Из МасДт Цикл
    Р = СтрШаблон("%-" + Строка(ВШ) + "s", КодДт);
    ИтогДт = 0;
    Для Каждого КодКт Из МасКт Цикл
        Ключ = КодДт + "_" + КодКт;
        Сумма = Матрица[Ключ];
        Если Сумма = Неопределено Тогда  Сумма = 0;  КонецЕсли;
        ИтогДт = ИтогДт + Сумма;
        Р = Р + "|" + Кл(Сумма, В);
    КонецЦикла;
    Р = Р + "|" + Кл(ИтогДт, В+1);
    Сообщить(Р);
КонецЦикла;

// Итоговая строка Кт
Сообщить(Линия(МасКт, В, ВШ));
Р = СтрШаблон("%-" + Строка(ВШ) + "s", "ИТОГО Кт");
ИтогВсего = 0;
Для Каждого КодКт Из МасКт Цикл
    Сумма = СуммыКт[КодКт];
    Если Сумма = Неопределено Тогда  Сумма = 0;  КонецЕсли;
    ИтогВсего = ИтогВсего + Сумма;
    Р = Р + "|" + Кл(Сумма, В);
КонецЦикла;
Р = Р + "|" + Кл(ИтогВсего, В+1);
Сообщить(Р);

// ── 6. Легенда ──────────────────────────────────────────────────────
Сообщить("");
Сообщить("── Условные обозначения ────────────────────────────────────────────");
ВсеКоды = Массив();
Для Каждого К Из МасДт Цикл  ВсеКоды.Добавить(К);  КонецЦикла;
Для Каждого К Из МасКт Цикл
    Если ВсеКоды.Найти(К) = Неопределено Тогда  ВсеКоды.Добавить(К);  КонецЕсли;
КонецЦикла;
Для Каждого Код Из ВсеКоды Цикл
    Сч = ПланСч.НайтиПоКоду(Код);
    Сообщить(СтрШаблон("  %1  %2", Код, Сч.Наименование));
КонецЦикла;

// ── 7. Контроль баланса ──────────────────────────────────────────────
Сообщить("");
Сообщить(СтрШаблон("  Итого оборотов: %1 руб.  (Σ Дт = Σ Кт ✓)", ИтогВсего));
Сообщить("══════════════════════════════════════════════════════════════════════");
Сообщить("  1S: ERP — Шахматная ведомость (русский язык) — завершено");
Сообщить("══════════════════════════════════════════════════════════════════════");
