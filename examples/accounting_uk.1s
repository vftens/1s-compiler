// ═══════════════════════════════════════════════════════════════════════════
// 1S: ERP Free Edition — Бухгалтерський облік (українська мова)
// Демонструє: план рахунків, подвійний запис, оборотно-сальдова відомість,
//             аналіз взаєморозрахунків, реєстр бухгалтерії.
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
//  ПЛАН РАХУНКІВ
// ═══════════════════════════════════════════════════════════════════════════

Змін ПланРах;
ПланРах = Новий ПланРахунків("УКСГП");  // Українські стандарти бухгалтерського обліку

// Активні рахунки
ПланРах.Додати("10", "Основні засоби",               Хибність, Хибність);
ПланРах.Додати("20", "Виробничі запаси",              Хибність, Хибність);
ПланРах.Додати("26", "Готова продукція",              Хибність, Хибність);
ПланРах.Додати("30", "Готівка",                       Хибність, Хибність);
ПланРах.Додати("31", "Рахунки в банках",              Хибність, Хибність);
ПланРах.Додати("36", "Розрахунки з покупцями",        Хибність, Хибність, "Контрагент");
ПланРах.Додати("39", "Витрати майбутніх періодів",    Хибність, Хибність);

// Пасивні рахунки
ПланРах.Додати("40", "Статутний капітал",             Хибність, Істина);
ПланРах.Додати("44", "Нерозподілений прибуток",       Хибність, Істина);
ПланРах.Додати("63", "Розрахунки з постачальниками",  Хибність, Істина, "Контрагент");
ПланРах.Додати("64", "Розрахунки за податками",       Хибність, Істина, "Вид податку");
ПланРах.Додати("66", "Розрахунки з оплати праці",     Хибність, Істина, "Співробітник");

// Активно-пасивні
ПланРах.Додати("37", "Розрахунки з різними дебіторами", Істина, Істина, "Контрагент");
ПланРах.Додати("68", "Розрахунки за іншими операціями", Істина, Істина);

// Рахунки витрат/доходів
ПланРах.Додати("70", "Доходи від реалізації",         Хибність, Хибність);
ПланРах.Додати("90", "Собівартість реалізації",        Хибність, Хибність);
ПланРах.Додати("92", "Адміністративні витрати",        Хибність, Хибність);
ПланРах.Додати("93", "Витрати на збут",                Хибність, Хибність);

Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  ПЛАН РАХУНКІВ — " + ПланРах.Назва());
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити(ШаблонРядка("  %1  %2  %3",
    Формат("Код",          "ЧЦ=4"),
    Формат("Найменування", "ЧЦ=45"),
    "Вид"));
Повідомити("  " + ПовторитиРядок("─", 60));

Змін РахВибрати;
РахВибрати = ПланРах.Вибрати();
Поки РахВибрати.Наступний() Цикл
    Змін Рах, Вид;
    Рах = РахВибрати.Поточний();
    Якщо Рах.active Та Рах.passive Тоді
        Вид = "АП";
    ІнакшеЯкщо Рах.passive Тоді
        Вид = "П";
    Інакше
        Вид = "А";
    КінецьЯкщо;
    Повідомити(ШаблонРядка("  %1  %2  %3",
        Формат(Рах.code, "ЧЦ=4"),
        Ліво(Рах.name, 45),
        Вид));
КінецьЦиклу;

// ═══════════════════════════════════════════════════════════════════════════
//  РЕЄСТР БУХГАЛТЕРІЇ
// ═══════════════════════════════════════════════════════════════════════════

Змін Реєстр;
Реєстр = Новий РегістрБухгалтерії("Бухгалтерія", ПланРах);

// ── Внесок до статутного капіталу ────────────────────────────────────────
Реєстр.Провести('20250101', "СтатКап", "Внесок до статутного капіталу",
    "31", "40", 500000, "", "ТОВ Укрпром");
Повідомити("");
Повідомити("✓ Проведено: Дт31 Кт40  500 000 грн — Внесок до статутного капіталу");

// ── Закупівля матеріалів ──────────────────────────────────────────────────
Реєстр.Провести('20250110', "Нак001", "Закупівля матеріалів у постачальника",
    "20", "63", 120000, "", "ТОВ Матеріали+");
Реєстр.Провести('20250110', "Нак001", "ПДВ вхідний (20%)",
    "64", "63", 24000, "", "ТОВ Матеріали+");
Реєстр.Провести('20250110', "Нак001", "Оплата постачальнику",
    "63", "31", 144000, "", "ТОВ Матеріали+");
Повідомити("✓ Проведено: Дт20/Дт641 Кт63 Кт31 — Закупівля матеріалів");

// ── Нарахування зарплати ──────────────────────────────────────────────────
Реєстр.Провести('20250131', "ЗП0125", "Нарахування зарплати (січень)",
    "92", "66", 85000, "", "");
Реєстр.Провести('20250131', "ЗП0125", "ПДФО 18% утримано",
    "66", "64", 15300, "", "");
Реєстр.Провести('20250131', "ЗП0125", "Виплата зарплати",
    "66", "31", 69700, "", "");
Повідомити("✓ Проведено: Дт92 Кт66, Дт66 Кт641, Дт66 Кт31 — Зарплата січень");

// ── Продаж продукції ──────────────────────────────────────────────────────
Реєстр.Провести('20250205', "ВН001", "Виручка від реалізації продукції",
    "36", "70", 360000, "ТОВ Укр-Трейд", "");
Реєстр.Провести('20250205', "ВН001", "Витрати на збут",
    "93", "20", 95000, "", "");
Реєстр.Провести('20250205', "ВН001", "Надходження оплати",
    "31", "36", 360000, "ТОВ Укр-Трейд", "");
Повідомити("✓ Проведено: Дт36 Кт70, Дт93 Кт20, Дт31 Кт36 — Реалізація");

// ── Нарахування податку на прибуток ──────────────────────────────────────
Реєстр.Провести('20250228', "ПодПр", "Нарахування податку на прибуток 18%",
    "92", "64", 32400, "", "");
Реєстр.Провести('20250228', "ПодПр", "Сплата податку",
    "64", "31", 32400, "", "");
Повідомити("✓ Проведено: Дт92 Кт641, Дт641 Кт31 — Податок на прибуток");

// ═══════════════════════════════════════════════════════════════════════════
//  ОБОРОТНО-САЛЬДОВА ВІДОМІСТЬ
// ═══════════════════════════════════════════════════════════════════════════

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("  ОБОРОТНО-САЛЬДОВА ВІДОМІСТЬ  за 01.01.2025 – 28.02.2025");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити(ШаблонРядка("  %1  %2  %3  %4  %5",
    Формат("Рах.", "ЧЦ=4"),
    Формат("Найменування", "ЧЦ=30"),
    Формат("Дебет",  "ЧЦ=12"),
    Формат("Кредит", "ЧЦ=12"),
    Формат("Сальдо", "ЧЦ=12")));
Повідомити("  " + ПовторитиРядок("─", 66));

Змін ОСВ, ПідсДт, ПідсКт;
ОСВ    = Реєстр.ОборотноСальдоВідомість('20250101', '20250228');
ПідсДт = 0;
ПідсКт = 0;

Змін Рядок;
Для Кожного Рядок З ОСВ Цикл
    Якщо Рядок["ОборотДт"] = 0 Та Рядок["ОборотКт"] = 0 Тоді
        Продовжити;
    КінецьЯкщо;
    Змін Сальдо;
    Сальдо = Рядок["ОборотДт"] - Рядок["ОборотКт"];
    Повідомити(ШаблонРядка("  %1  %2  %3  %4  %5",
        Формат(Рядок["Рахунок"],  "ЧЦ=4"),
        Формат(Ліво(Рядок["Найменування"], 30), "ЧЦ=30"),
        Формат(Рядок["ОборотДт"], "ЧЦ=12; ЧДЦ=0"),
        Формат(Рядок["ОборотКт"], "ЧЦ=12; ЧДЦ=0"),
        Формат(Сальдо,            "ЧЦ=12; ЧДЦ=0")));
    ПідсДт = ПідсДт + Рядок["ОборотДт"];
    ПідсКт = ПідсКт + Рядок["ОборотКт"];
КінецьЦиклу;

Повідомити("  " + ПовторитиРядок("─", 66));
Повідомити(ШаблонРядка("  %1  %2  %3",
    Формат("РАЗОМ:", "ЧЦ=36"),
    Формат(ПідсДт, "ЧЦ=12; ЧДЦ=0"),
    Формат(ПідсКт, "ЧЦ=12; ЧДЦ=0")));

// ═══════════════════════════════════════════════════════════════════════════
//  АНАЛІЗ РАХУНКУ 31 (Рахунки в банках)
// ═══════════════════════════════════════════════════════════════════════════

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  АНАЛІЗ РАХУНКУ 31 — Рахунки в банках");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити(ШаблонРядка("  %1  %2  %3  %4  %5",
    Формат("Дата",     "ЧЦ=10"),
    Формат("Документ", "ЧЦ=12"),
    Формат("Зміст",    "ЧЦ=35"),
    Формат("Дебет",    "ЧЦ=12"),
    Формат("Кредит",   "ЧЦ=12")));
Повідомити("  " + ПовторитиРядок("─", 84));

Змін Аналіз;
Аналіз = Реєстр.АналізРахунку("31", '20250101', '20250228');
Змін ПідсАнДт, ПідсАнКт;
ПідсАнДт = 0; ПідсАнКт = 0;
Для Кожного Рядок З Аналіз Цикл
    Повідомити(ШаблонРядка("  %1  %2  %3  %4  %5",
        Формат(Рядок["Дата"], "ДФ='дд.ММ.гггг'"),
        Формат(Ліво(Рядок["Документ"], 12), "ЧЦ=12"),
        Формат(Ліво(Рядок["Зміст"], 35),    "ЧЦ=35"),
        Рядок["Дебет"]  > 0 ? Формат(Рядок["Дебет"],  "ЧЦ=12; ЧДЦ=0") : Формат("", "ЧЦ=12"),
        Рядок["Кредит"] > 0 ? Формат(Рядок["Кредит"], "ЧЦ=12; ЧДЦ=0") : Формат("", "ЧЦ=12")));
    ПідсАнДт = ПідсАнДт + Рядок["Дебет"];
    ПідсАнКт = ПідсАнКт + Рядок["Кредит"];
КінецьЦиклу;

Повідомити("  " + ПовторитиРядок("─", 84));
Повідомити(ШаблонРядка("  %1  %2  %3",
    Формат("ОБОРОТИ:", "ЧЦ=59"),
    Формат(ПідсАнДт, "ЧЦ=12; ЧДЦ=0"),
    Формат(ПідсАнКт, "ЧЦ=12; ЧДЦ=0")));
Повідомити(ШаблонРядка("  Сальдо кінцеве рах. 31: %1 грн",
    Формат(ПідсАнДт - ПідсАнКт, "ЧДЦ=0")));

// ═══════════════════════════════════════════════════════════════════════════
//  ВЗАЄМОРОЗРАХУНКИ З КОНТРАГЕНТАМИ
// ═══════════════════════════════════════════════════════════════════════════

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  РОЗРАХУНКИ З КОНТРАГЕНТАМИ (рах. 36, 63)");
Повідомити("══════════════════════════════════════════════════════════════════");

Змін Контрагенти, КонтрКоди;
Контрагенти = Новий Відповідність;
Контрагенти["ТОВ Матеріали+"]  = Новий Структура("Дт, Кт", 0, 0);
Контрагенти["ТОВ Укр-Трейд"]   = Новий Структура("Дт, Кт", 0, 0);
Контрагенти["ТОВ Укрпром"]     = Новий Структура("Дт, Кт", 0, 0);

// Вибираємо всі проведення по рах. 36 і 63
Змін ВибРеєстр;
ВибРеєстр = Реєстр.Вибрати('20250101', '20250228');
Поки ВибРеєстр.Наступний() Цикл
    Змін Зап, СубкДт, СубкКт;
    Зап    = ВибРеєстр.Поточний();
    СубкДт = Зап.SubcontoDt;
    СубкКт = Зап.SubcontoKt;

    Якщо (Зап.AccountDt = "36" Або Зап.AccountDt = "63") Та СубкДт <> "" Тоді
        Якщо Контрагенти[СубкДт] <> Невизначено Тоді
            Контрагенти[СубкДт].Дт = Контрагенти[СубкДт].Дт + Зап.Amount;
        КінецьЯкщо;
    КінецьЯкщо;
    Якщо (Зап.AccountKt = "36" Або Зап.AccountKt = "63") Та СубкКт <> "" Тоді
        Якщо Контрагенти[СубкКт] <> Невизначено Тоді
            Контрагенти[СубкКт].Кт = Контрагенти[СубкКт].Кт + Зап.Amount;
        КінецьЯкщо;
    КінецьЯкщо;
КінецьЦиклу;

Повідомити(ШаблонРядка("  %1  %2  %3  %4",
    Формат("Контрагент", "ЧЦ=25"),
    Формат("Дебет",  "ЧЦ=12"),
    Формат("Кредит", "ЧЦ=12"),
    Формат("Сальдо", "ЧЦ=12")));
Повідомити("  " + ПовторитиРядок("─", 64));
Для Кожного Пара З Контрагенти Цикл
    Змін Конт;
    Конт = Пара.Значення;
    Повідомити(ШаблонРядка("  %1  %2  %3  %4",
        Формат(Ліво(Пара.Ключ, 25), "ЧЦ=25"),
        Формат(Конт.Дт, "ЧЦ=12; ЧДЦ=0"),
        Формат(Конт.Кт, "ЧЦ=12; ЧДЦ=0"),
        Формат(Конт.Дт - Конт.Кт, "ЧЦ=12; ЧДЦ=0")));
КінецьЦиклу;

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════");
Повідомити("  Бухгалтерський облік (українська мова) — завершено");
Повідомити("══════════════════════════════════════════════════════════════════");
