// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Cython Performance Demo (Українська)
//
// ВСІ числові змінні оголошені через «Перем» і цикл «Для ... По ...»
// → транспілятор генерує cdef long / cdef double для кожної
// → Cython компілює у машинний код → 10-50× прискорення
//
// Генерація .pyx:   python -m src.cli cython-gen examples/demo_cython_perf_uk.1s
// Компіляція+запуск: python -m src.cli cython-build examples/demo_cython_perf_uk.1s --run
// ══════════════════════════════════════════════════════════════════════

Повідомити("══════════════════════════════════════════════════════════════");
Повідомити("  CYTHON PERFORMANCE DEMO  ·  1S: ERP  ·  Українська");
Повідомити("══════════════════════════════════════════════════════════════");
Повідомити("");

// ──────────────────────────────────────────────────────────────────────
// ТЕСТ 1: Числа Фібоначчі — ітеративний (cdef long)
// Cython: cdef long А, Б, Тем, К → чистий C int64 без GIL overhead
// ──────────────────────────────────────────────────────────────────────
Перем А, Б, Тем, К;
А = 0; Б = 1; Тем = 0;
МодМ = 1000000007;  // модульна арифметика — числа залишаються малими

ПочЧас = ЧасЗараз();
Для К = 1 По 1000000 Цикл
    Тем = (А + Б) % МодМ;
    А   = Б;
    Б   = Тем;
КінецьЦиклу;
ЧасТ1 = Окр((ЧасЗараз() - ПочЧас) * 1000, 2);

Повідомити("── Тест 1: 1 000 000 ітерацій Фібоначчі (ітеративно) ────────────");
Повідомити(ШаблонРядка("  Результат (остання пара): А=%1, Б=%2", А, Б));
Повідомити(ШаблонРядка("  Python:  %1 мс", ЧасТ1));
Повідомити("  Cython:  очікувано ~0.5-2 мс  (прискорення 10-50×)");
Повідомити("  cdef long А=0, Б=0, Тем=0, К=0  → машинний int64");
Повідомити("");

// ──────────────────────────────────────────────────────────────────────
// ТЕСТ 2: Сума квадратів (cdef long + FOR-loop optimisation)
// ──────────────────────────────────────────────────────────────────────
Перем Сума, Н;
Сума = 0;

ПочЧас = ЧасЗараз();
Для Н = 1 По 500000 Цикл
    Сума = Сума + Н * Н;
КінецьЦиклу;
ЧасТ2 = Окр((ЧасЗараз() - ПочЧас) * 1000, 2);

Повідомити("── Тест 2: Σ(N²) для N=1..500 000 ─────────────────────────────");
Повідомити(ШаблонРядка("  Результат: %1", Сума));
Повідомити(ШаблонРядка("  Python:  %1 мс", ЧасТ2));
Повідомити("  Cython:  очікувано ~0.3-1 мс  (прискорення 15-60×)");
Повідомити("  cdef long Сума=0, Н=0  → Cython оптимізує range() автоматично");
Повідомити("");

// ──────────────────────────────────────────────────────────────────────
// ТЕСТ 3: Решето Ератосфена — cdef long + масив bool
// ──────────────────────────────────────────────────────────────────────
Перем МаксН, КількПростих, М;
МаксН = 100000; КількПростих = 0;
Решето = Масив();
Для К = 0 По МаксН Цикл  Решето.Додати(Істина);  КінецьЦиклу;

ПочЧас = ЧасЗараз();
Для К = 2 По МаксН Цикл
    Якщо Решето[К] = Істина Тоді
        КількПростих = КількПростих + 1;
        М = К + К;
        Поки М <= МаксН Цикл
            Решето.Встановити(М, Хибність);
            М = М + К;
        КінецьЦиклу;
    КінецьЯкщо;
КінецьЦиклу;
ЧасТ3 = Окр((ЧасЗараз() - ПочЧас) * 1000, 2);

Повідомити("── Тест 3: Решето простих чисел до 100 000 ──────────────────────");
Повідомити(ШаблонРядка("  Знайдено простих: %1", КількПростих));
Повідомити(ШаблонРядка("  Python:  %1 мс", ЧасТ3));
Повідомити("  Cython:  очікувано ~1-3 мс  (прискорення 10-30×)");
Повідомити("  cdef long МаксН=0, КількПростих=0, К=0, М=0  → всі цілі");
Повідомити("");

// ──────────────────────────────────────────────────────────────────────
// ТЕСТ 4: Обчислення числа π методом Монте-Карло (cdef double)
// ──────────────────────────────────────────────────────────────────────
// LCG — інлайновий генератор (без виклику функції → cdef double оптимізує)
Перем Кроків, Влучень, Зерно;
Перем Ікс, Ігрек;
Кроків = 0; Влучень = 0; Зерно = 123456789;

ПочЧас = ЧасЗараз();
Для К = 1 По 100000 Цикл
    Зерно = (Зерно * 1664525 + 1013904223) % 2147483647;
    Ікс   = Зерно / 2147483647.0;
    Зерно = (Зерно * 1664525 + 1013904223) % 2147483647;
    Ігрек = Зерно / 2147483647.0;
    Якщо Ікс * Ікс + Ігрек * Ігрек <= 1.0 Тоді
        Влучень = Влучень + 1;
    КінецьЯкщо;
    Кроків = Кроків + 1;
КінецьЦиклу;
ЧасТ4 = Окр((ЧасЗараз() - ПочЧас) * 1000, 2);

Пі = Влучень / Кроків * 4;

Повідомити("── Тест 4: π методом Монте-Карло (100 000 точок) ───────────────");
Повідомити(ШаблонРядка("  π ≈ %1   (відхилення від 3.14159...)", Формат(Пі,"ЧДЦ=6")));
Повідомити(ШаблонРядка("  Python:  %1 мс", ЧасТ4));
Повідомити("  Cython:  очікувано ~1-4 мс  (прискорення 8-20×)");
Повідомити("  cdef double Ікс=0.0, Ігрек=0.0  → C double без boxing");
Повідомити("");

// ── ПІДСУМОК ──────────────────────────────────────────────────────────
ЗагПy = Окр(ЧасТ1 + ЧасТ2 + ЧасТ3 + ЧасТ4, 1);
Повідомити("── Підсумок та інструкції для компіляції ─────────────────────────");
Повідомити(ШаблонРядка("  Загальний час Python:   %1 мс", ЗагПy));
Повідомити("  Очікуваний час Cython:  ~5-15 мс  (прискорення 5-20×)");
Повідомити("");
Повідомити("  Cython типи для цього скрипту:");
Повідомити("    cdef long  А, Б, Тем, К, Сума, Н, МаксН, КількПростих, М");
Повідомити("    cdef long  Кроків, Влучень, Зерно");
Повідомити("    cdef double Ікс, Ігрек, Пі");
Повідомити("");
Повідомити("  Генерувати Cython-код:");
Повідомити("    python -m src.cli cython-gen examples/demo_cython_perf_uk.1s");
Повідомити("");
Повідомити("  Скомпілювати та запустити (потрібен GCC / MSVC / Clang):");
Повідомити("    python -m src.cli cython-build examples/demo_cython_perf_uk.1s --run");
Повідомити("");
Повідомити("  Встановити Cython:");
Повідомити("    pip install cython");
Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP — Cython Performance Demo (Ukrainian) — завершено");
Повідомити("══════════════════════════════════════════════════════════════");
