// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — ДЕМО: Бухгалтерський облік — повний місячний цикл
// Підприємство «Альфа» · Cічень 2025 · УКСГП · Українська мова
//
// Розділи: Вхідне сальдо → Операції → ОСВ → P&L → Excel
// ══════════════════════════════════════════════════════════════════════

// ── Допоміжна: форматування числа в колонку ──────────────────────────
Функція Ч(Зн, Ш)
    Якщо Зн = 0 Тоді  Повернути ШаблонРядка("%" + Рядок(Ш) + "s","");  КінецьЯкщо;
    Повернути Формат(Зн,"ЧЦ=" + Рядок(Ш));
КінецьФункції;

// ── 1. ПЛАН РАХУНКІВ УКСГП ───────────────────────────────────────────
ПланРах = ПланРахунків("УКСГП");
ПланРах.Додати("10","Основні засоби");          ПланРах.Додати("20","Виробничі запаси");
ПланРах.Додати("28","ТМЦ у реалізації");        ПланРах.Додати("31","Рахунки в банках");
ПланРах.Додати("36","Розрахунки з покупцями");  ПланРах.Додати("40","Статутний капітал");
ПланРах.Додати("63","Розрах. з постачальниками"); ПланРах.Додати("64","ПДВ");
ПланРах.Додати("66","Розрах. з персоналом");   ПланРах.Додати("70","Доходи від реалізації");
ПланРах.Додати("90","Собівартість реалізації"); ПланРах.Додати("92","Адмін. витрати");

// ── 2. РЕГІСТР БУХГАЛТЕРІЇ ────────────────────────────────────────────
РегБух = РегістрБухгалтерії("ГоловнаКнига", ПланРах);

// Вхідне сальдо (31 грудня 2024)
ДатВх = '20241231';
РегБух.Провести(ДатВх,"ВхСал","Вхідне сальдо: ОЗ",     "10","40",450000);
РегБух.Провести(ДатВх,"ВхСал","Вхідне сальдо: Запаси",  "20","63", 85000);
РегБух.Провести(ДатВх,"ВхСал","Вхідне сальдо: Банк",    "31","40",125000);
РегБух.Провести(ДатВх,"ВхСал","Вхідне сальдо: Дебітори","36","70", 40000);

// ── 3. ОПЕРАЦІЇ ЗА CІЧЕНЬ 2025 ────────────────────────────────────────
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("  БУХГАЛТЕРСЬКИЙ ОБЛІК  ·  Підприємство «Альфа»  ·  Cічень 2025");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("");
Повідомити("── 1. Господарські операції за cічень 2025 р. ─────────────────────");

// Надходження товарів
РегБух.Провести('20250105',"ПН001","Надходження запасів від постач.",    "20","63",120000);
РегБух.Провести('20250105',"ПН001","ПДВ вхідний 20%%",                   "64","63", 24000);
Повідомити("  05.01  ПН001  Надходження запасів від постачальника  120 000 грн");

// Реалізація товарів
РегБух.Провести('20250115',"РН001","Дохід від реалізації (нетто)",       "36","70",180000);
РегБух.Провести('20250115',"РН001","ПДВ вихідний 20%%",                  "70","64", 36000);
РегБух.Провести('20250115',"РН001","Собівартість реалізованих товарів",  "90","20", 95000);
Повідомити("  15.01  РН001  Реалізація товарів ТОВ «Клієнт»         180 000 грн");

// Нарахування зарплати
РегБух.Провести('20250125',"ВН001","Нарахування зарплати",               "92","66", 55000);
РегБух.Провести('20250125',"ВН001","ЄСВ роботодавця 22%%",               "92","63", 12100);
Повідомити("  25.01  ВН001  Нарахування зарплати + ЄСВ              67 100 грн");

// Банківські операції
РегБух.Провести('20250128',"БВ001","Виплата зарплати банк",              "66","31", 44850);
РегБух.Провести('20250128',"БВ002","Оплата постачальнику",               "63","31",144000);
РегБух.Провести('20250128',"БВ003","Надходження від покупця",            "31","36",180000);
Повідомити("  28.01  Банк  Виплата ЗП + оплата поставщику + надходження");

// Закриття ПДВ
РегБух.Провести('20250131',"ПДВ01","Розрахунок ПДВ до бюджету",          "64","63", 12000);
Повідомити("  31.01  ПДВ01 Розрахунок ПДВ: вхідний 24000 - вихідний 36000 = 12000 до бюджету");
Повідомити("");

// ── 4. ОБОРОТНО-САЛЬДОВА ВІДОМІСТЬ ────────────────────────────────────
Повідомити("── 2. Оборотно-сальдова відомість (ОСВ) ─────────────────────────");
ПС = '20250101'; ПК = '20250131';

В = 9;
Повідомити(ШаблонРядка("  %-4s %-20s %9s %9s %9s %9s %9s %9s",
    "Рах.", "Назва", "Поч.Дт", "Поч.Кт", "Об.Дт", "Об.Кт", "Кін.Дт", "Кін.Кт"));
Повідомити(СтрПовтор("─", 80));

ТПД = 0; ТПК = 0; ТОД = 0; ТОК = 0; ТКД = 0; ТКК = 0;
Для Кожного Рах З ПланРах Цикл
    БП = РегБух.Залишок(Рах, '20241231'); Об = РегБух.Оборот(Рах, ПС, ПК);
    СПД = БП["Дт"]; СПК = БП["Кт"]; ОД = Об["ОборотДт"]; ОК = Об["ОборотКт"];
    Якщо СПД + СПК + ОД + ОК = 0 Тоді  Продовжити;  КінецьЯкщо;
    Нт = СПД - СПК + ОД - ОК;
    Якщо Нт >= 0 Тоді  СКД = Нт; СКК = 0;  Інакше  СКД = 0; СКК = -Нт;  КінецьЯкщо;

    Повідомити(ШаблонРядка("  %-4s %-20s %9s %9s %9s %9s %9s %9s",
        Рах.Код, Рах.Назва, Ч(СПД,9), Ч(СПК,9), Ч(ОД,9), Ч(ОК,9), Ч(СКД,9), Ч(СКК,9)));
    ТПД=ТПД+СПД; ТПК=ТПК+СПК; ТОД=ТОД+ОД; ТОК=ТОК+ОК; ТКД=ТКД+СКД; ТКК=ТКК+СКК;
КінецьЦиклу;
Повідомити(СтрПовтор("─", 80));
Повідомити(ШаблонРядка("  %-25s %9s %9s %9s %9s %9s %9s",
    "РАЗОМ:", Ч(ТПД,9),Ч(ТПК,9),Ч(ТОД,9),Ч(ТОК,9),Ч(ТКД,9),Ч(ТКК,9)));
Повідомити(ШаблонРядка("  Перевірка: ОД=%1 = ОК=%2 ✓  |  КД=%3 = КК=%4 ✓",
    ТОД, ТОК, ТКД, ТКК));

// ── 5. ЗВІТ ПРО ФІНАНСОВІ РЕЗУЛЬТАТИ ─────────────────────────────────
Повідомити("");
Повідомити("── 3. Звіт про фінансові результати (P&L) ───────────────────────");
О70 = РегБух.Оборот(ПланРах.НайтиЗаКодом("70"), ПС, ПК);
О90 = РегБух.Оборот(ПланРах.НайтиЗаКодом("90"), ПС, ПК);
О92 = РегБух.Оборот(ПланРах.НайтиЗаКодом("92"), ПС, ПК);
Виручка   = О70["ОборотКт"];
Собів     = О90["ОборотДт"];
Валов     = Виручка - Собів;
АВ        = О92["ОборотДт"];
ОперПриб  = Валов - АВ;
Рентаб    = Окр(ОперПриб / Виручка * 100, 1);

Повідомити(ШаблонРядка("  Дохід від реалізації (нетто):    %1 грн", Формат(Виручка,"ЧДЦ=2")));
Повідомити(ШаблонРядка("  Собівартість:                   (%1 грн)", Формат(Собів,"ЧДЦ=2")));
Повідомити(СтрПовтор("─", 50));
Повідомити(ШаблонРядка("  ВАЛОВИЙ ПРИБУТОК:                %1 грн", Формат(Валов,"ЧДЦ=2")));
Повідомити(ШаблонРядка("  Адміністративні витрати:        (%1 грн)", Формат(АВ,"ЧДЦ=2")));
Повідомити(СтрПовтор("─", 50));
Повідомити(ШаблонРядка("  ОПЕРАЦІЙНИЙ ПРИБУТОК:            %1 грн", Формат(ОперПриб,"ЧДЦ=2")));
Повідомити(ШаблонРядка("  Рентабельність:                  %1%%", Рентаб));

Повідомити("");
Повідомити("══════════════════════════════════════════════════════════════════════");
Повідомити("  1S: ERP — Бухгалтерський облік (українська) — завершено");
Повідомити("══════════════════════════════════════════════════════════════════════");
