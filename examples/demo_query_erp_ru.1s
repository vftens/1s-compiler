// Sprint 12 Демо — Запросы к таблицам ERP из .1s скрипта (Русский)
// Запуск: python -m src.cli run examples/demo_query_erp_ru.1s
// Требуется: data/erp.db заполнена (запустите demo_persistence_ru.1s)

Сообщить("=== Sprint 12: Движок Запросов → База Данных ERP ===");

// Запрос узлов оргструктуры из SQLite базы данных
з = Запрос("ВЫБРАТЬ id, name, type, parent_id ИЗ org_nodes ГДЕ id <> 'root' ПЕРВЫЕ 20");
з.ПрисоединитьБД("erp.db");
рез = з.Выполнить();

Сообщить("Узлов оргструктуры в базе: " + рез.Количество());
кур = рез.Выбрать();
Пока кур.Следующий() Цикл
    Сообщить("  [" + кур.Значение("type") + "] " + кур.Значение("name") + " (родитель: " + кур.Значение("parent_id") + ")");
КонецЦикла;

// Запрос бюджетных ассигнований
Сообщить("");
Сообщить("--- Бюджетные ассигнования ---");
зб = Запрос("ВЫБРАТЬ org_id, period, account, amount ИЗ budget_allocations ПЕРВЫЕ 10");
зб.ПрисоединитьБД("erp.db");
рб = зб.Выполнить();
Сообщить("Строк бюджета: " + рб.Количество());
кб = рб.Выбрать();
Пока кб.Следующий() Цикл
    Сообщить("  " + кб.Значение("org_id") + " / " + кб.Значение("period") + " / " + кб.Значение("account") + " = " + кб.Значение("amount"));
КонецЦикла;

// Запрос расчётов заработной платы
Сообщить("");
Сообщить("--- Расчёты заработной платы ---");
зп = Запрос("ВЫБРАТЬ emp_id, emp_name, period, gross, net ИЗ payroll_results УПОРЯДОЧИТЬ ПО period УБЫВ ПЕРВЫЕ 10");
зп.ПрисоединитьБД("erp.db");
рп = зп.Выполнить();
Сообщить("Строк расчётов: " + рп.Количество());
кп = рп.Выбрать();
Пока кп.Следующий() Цикл
    Сообщить("  " + кп.Значение("emp_name") + " (" + кп.Значение("period") + "): оклад=" + кп.Значение("gross") + " нет=" + кп.Значение("net"));
КонецЦикла;

Сообщить("");
Сообщить("=== Готово. Движок запросов к ERP работает корректно. ===");
