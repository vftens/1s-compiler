// ══════════════════════════════════════════════════════════════════════
// 1S: ERP — Планирование работ на 4 недели с реализацией (Workflow)
// Предприятие «Альфа» · Январь 2025 · Русский язык
//
// Недели 1–3: создан → согласован → частично/полностью выполнен
// Неделя 4:  создан → подан → ожидает согласования
// ══════════════════════════════════════════════════════════════════════

ЖА = АудитЖурнал("ПланРабот");

Функция РядокЗад(Ном, Назв, Отв, Факт)
    Пад = Макс(0, 38 - СтрДлина(Назв));
    Стр = СтрШаблон("  %1. ", Ном) + Назв + СтрПовтор(" ", Пад);
    Если Факт[Назв] = Истина Тогда
        Стр = Стр + " OK " + Отв;
    Иначе
        Стр = Стр + " XX " + Отв + " (не выполнено)";
    КонецЕсли;
    Сообщить(Стр);
КонецФункции;

Функция ВывестиНеделю(Пл, Факт, Заголовок)
    Зад   = Пл.ТабличнаяЧасть("Задачи");
    Всего = Зад.Количество();
    Сделано = 0;
    Для Каждого Р Из Зад Цикл
        Если Факт[Р["Название"]] = Истина Тогда  Сделано = Сделано + 1;  КонецЕсли;
    КонецЦикла;
    Процент = Сделано * 100 / Всего;
    Сообщить("── " + Заголовок + " │ Статус: " + Пл.МетаСтатус("ru") + " ────────────");
    Н = 0;
    Для Каждого Р Из Зад Цикл
        Н = Н + 1;
        РядокЗад(Н, Р["Название"], Р["Ответственный"], Факт);
    КонецЦикла;
    Сообщить(СтрШаблон("  Выполнение: %1/%2 (%3%)", Сделано, Всего, Окр(Процент, 0)));
    Возврат Сделано;
КонецФункции;

// ════════════════════════════════════════════════════════════════════
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  ПЛАН РАБОТ НА ЯНВАРЬ 2025  ·  Предприятие «Альфа»");
Сообщить("══════════════════════════════════════════════════════════════════");

// ── Неделя 1 (6-10 Января) — 100% выполнение ─────────────────────
Н1 = ДокументСМаршрутом("НедельныйПлан");
Н1.Неделя = 1; Н1.Менеджер = "Иванов О.М.";
Н1.НачПериода = '20250106'; Н1.КонПериода = '20250110';

З1 = Н1.ТабличнаяЧасть("Задачи", "Название, Ответственный, Дедлайн");
Р = З1.Добавить(); Р["Название"] = "Закупка муки 1000 кг";              Р["Ответственный"] = "Петров";    Р["Дедлайн"] = '20250107';
Р = З1.Добавить(); Р["Название"] = "Закупка сахара и масла 500 кг";     Р["Ответственный"] = "Петров";    Р["Дедлайн"] = '20250107';
Р = З1.Добавить(); Р["Название"] = "Подготовка договоров с клиентами";   Р["Ответственный"] = "Иванов";    Р["Дедлайн"] = '20250108';
Р = З1.Добавить(); Р["Название"] = "Технический осмотр склада";          Р["Ответственный"] = "Бондаренко"; Р["Дедлайн"] = '20250109';
Р = З1.Добавить(); Р["Название"] = "Отчёт за декабрь в бухгалтерию";    Р["Ответственный"] = "Кузнецова";  Р["Дедлайн"] = '20250110';

Н1.Подать("Иванов", "Плановая неделя стартует 6 января");
Н1.Согласовать("Козлов (Директор)", "Утверждено, приступить к выполнению");
Н1.Провести();
ЖА.Записать("Козлов", "Утвердить", "НедельныйПлан", Н1.Номер, "Неделя 1 утверждена");

Вык1 = Соответствие();
Вык1["Закупка муки 1000 кг"]              = Истина;
Вык1["Закупка сахара и масла 500 кг"]     = Истина;
Вык1["Подготовка договоров с клиентами"]  = Истина;
Вык1["Технический осмотр склада"]         = Истина;
Вык1["Отчёт за декабрь в бухгалтерию"]   = Истина;
Для Каждого Пара Из Вык1 Цикл
    ЖА.Записать("Исполнитель", "Выполнить", "Задача", Пара.Ключ, "Выполнено в неделе 1");
КонецЦикла;

// ── Неделя 2 (13-17 Января) — 80% выполнение ─────────────────────
Н2 = ДокументСМаршрутом("НедельныйПлан");
Н2.Неделя = 2; Н2.Менеджер = "Иванов О.М.";
Н2.НачПериода = '20250113'; Н2.КонПериода = '20250117';

З2 = Н2.ТабличнаяЧасть("Задачи", "Название, Ответственный, Дедлайн");
Р = З2.Добавить(); Р["Название"] = "Отгрузка товара ООО «Альфа»";       Р["Ответственный"] = "Склад";      Р["Дедлайн"] = '20250113';
Р = З2.Добавить(); Р["Название"] = "Оплата поставщику МатПлюс";          Р["Ответственный"] = "Кузнецова";  Р["Дедлайн"] = '20250114';
Р = З2.Добавить(); Р["Название"] = "Приём нового менеджера по продажам"; Р["Ответственный"] = "Иванов";     Р["Дедлайн"] = '20250115';
Р = З2.Добавить(); Р["Название"] = "Рекламная кампания в соцсетях";      Р["Ответственный"] = "Маркетолог"; Р["Дедлайн"] = '20250117';
Р = З2.Добавить(); Р["Название"] = "Инвентаризация склада";               Р["Ответственный"] = "Кладовщик";  Р["Дедлайн"] = '20250117';

Н2.Подать("Иванов", "Неделя 2 — отгрузки и оплаты");
Н2.Согласовать("Козлов (Директор)", "Утверждено");
Н2.Провести();
ЖА.Записать("Козлов", "Утвердить", "НедельныйПлан", Н2.Номер, "Неделя 2 утверждена");

Вык2 = Соответствие();
Вык2["Отгрузка товара ООО «Альфа»"]       = Истина;
Вык2["Оплата поставщику МатПлюс"]          = Истина;
Вык2["Приём нового менеджера по продажам"] = Истина;
Вык2["Рекламная кампания в соцсетях"]      = Ложь;   // не выполнено
Вык2["Инвентаризация склада"]              = Истина;
ЖА.Записать("Маркетолог", "Перенести", "Задача", "Рекламная кампания", "Перенесено на неделю 3");

// ── Неделя 3 (20-24 Января) — 60% выполнение ─────────────────────
Н3 = ДокументСМаршрутом("НедельныйПлан");
Н3.Неделя = 3; Н3.Менеджер = "Иванов О.М.";
Н3.НачПериода = '20250120'; Н3.КонПериода = '20250124';

З3 = Н3.ТабличнаяЧасть("Задачи", "Название, Ответственный, Дедлайн");
Р = З3.Добавить(); Р["Название"] = "Переговоры с новым поставщиком";    Р["Ответственный"] = "Директор";   Р["Дедлайн"] = '20250120';
Р = З3.Добавить(); Р["Название"] = "Доставка заказов клиентам";          Р["Ответственный"] = "Логист";     Р["Дедлайн"] = '20250121';
Р = З3.Добавить(); Р["Название"] = "Начисление заработной платы";        Р["Ответственный"] = "Кузнецова";  Р["Дедлайн"] = '20250122';
Р = З3.Добавить(); Р["Название"] = "Обновление прайс-листа";             Р["Ответственный"] = "Менеджер";   Р["Дедлайн"] = '20250123';
Р = З3.Добавить(); Р["Название"] = "Обучение персонала (CRM-система)";   Р["Ответственный"] = "HR";         Р["Дедлайн"] = '20250124';

Н3.Подать("Иванов", "Неделя 3 — переговоры и начисление ЗП");
Н3.Согласовать("Козлов (Директор)", "Утверждено, ключевое — переговоры");
Н3.Провести();
ЖА.Записать("Козлов", "Утвердить", "НедельныйПлан", Н3.Номер, "Неделя 3 утверждена");

Вык3 = Соответствие();
Вык3["Переговоры с новым поставщиком"]  = Истина;
Вык3["Доставка заказов клиентам"]        = Истина;
Вык3["Начисление заработной платы"]      = Истина;
Вык3["Обновление прайс-листа"]           = Ложь;   // не выполнено
Вык3["Обучение персонала (CRM-система)"] = Ложь;   // перенесено
ЖА.Записать("HR", "Перенести", "Задача", "Обучение персонала", "Перенесено на неделю 4");

// ── Неделя 4 (27-31 Января) — 0% (ожидает согласования) ─────────
Н4 = ДокументСМаршрутом("НедельныйПлан");
Н4.Неделя = 4; Н4.Менеджер = "Иванов О.М.";
Н4.НачПериода = '20250127'; Н4.КонПериода = '20250131';

З4 = Н4.ТабличнаяЧасть("Задачи", "Название, Ответственный, Дедлайн");
Р = З4.Добавить(); Р["Название"] = "Финансовый отчёт за январь";         Р["Ответственный"] = "Кузнецова";  Р["Дедлайн"] = '20250128';
Р = З4.Добавить(); Р["Название"] = "Бюджет на февраль";                  Р["Ответственный"] = "Финансист";  Р["Дедлайн"] = '20250129';
Р = З4.Добавить(); Р["Название"] = "Закупка офисного оборудования";      Р["Ответственный"] = "Офис-менеджер"; Р["Дедлайн"] = '20250130';
Р = З4.Добавить(); Р["Название"] = "Встреча с ключевыми партнёрами";     Р["Ответственный"] = "Директор";   Р["Дедлайн"] = '20250130';
Р = З4.Добавить(); Р["Название"] = "Подведение итогов месяца";           Р["Ответственный"] = "Все";        Р["Дедлайн"] = '20250131';

Н4.Подать("Иванов", "Финальная неделя января — отчёты и бюджет");
ЖА.Записать("Иванов", "Подать", "НедельныйПлан", Н4.Номер, "Ожидает согласования директором");

Вык4 = Соответствие();

// ════════════════════════════════════════════════════════════════════
// ВЫВОД ДЕТАЛЬНЫХ ПЛАНОВ
// ════════════════════════════════════════════════════════════════════
Сообщить("");
Сд1 = ВывестиНеделю(Н1, Вык1, "Неделя 1  (06.01–10.01)");
Сообщить("");
Сд2 = ВывестиНеделю(Н2, Вык2, "Неделя 2  (13.01–17.01)");
Сообщить("");
Сд3 = ВывестиНеделю(Н3, Вык3, "Неделя 3  (20.01–24.01)");
Сообщить("");
Сд4 = ВывестиНеделю(Н4, Вык4, "Неделя 4  (27.01–31.01)");

// ════════════════════════════════════════════════════════════════════
// СВОДНЫЙ ОТЧЁТ «ПЛАН vs ФАКТ»
// ════════════════════════════════════════════════════════════════════
Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  СВОДНЫЙ ОТЧЁТ «ПЛАН vs ФАКТ»  ·  Предприятие «Альфа»  ·  Январь 2025");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить(СтрШаблон("%-14s│%11s│%10s│%6s│%s", "Неделя", "Запланировано", "Выполнено", "%", "Статус"));
Сообщить(СтрПовтор("─", 58));

ИтогПлан = 0; ИтогФакт = 0;
Для Ном = 1 По 4 Цикл
    Если Ном = 1 Тогда  Пл = Н1; Сд = Сд1; Пер = "06.01–10.01";  КонецЕсли;
    Если Ном = 2 Тогда  Пл = Н2; Сд = Сд2; Пер = "13.01–17.01";  КонецЕсли;
    Если Ном = 3 Тогда  Пл = Н3; Сд = Сд3; Пер = "20.01–24.01";  КонецЕсли;
    Если Ном = 4 Тогда  Пл = Н4; Сд = Сд4; Пер = "27.01–31.01";  КонецЕсли;
    Всего = Пл.ТабличнаяЧасть("Задачи").Количество();
    Проц  = Сд * 100 / Всего;
    Сообщить(СтрШаблон("%-14s│%13s│%10s│%5s%%│ %s",
        "Н" + Строка(Ном) + " (" + Пер + ")", Всего, Сд, Окр(Проц, 0), Пл.МетаСтатус("ru")));
    ИтогПлан = ИтогПлан + Всего;
    ИтогФакт = ИтогФакт + Сд;
КонецЦикла;

Сообщить(СтрПовтор("─", 58));
ЗагПроц = ИтогФакт * 100 / ИтогПлан;
Сообщить(СтрШаблон("%-14s│%13s│%10s│%5s%%│", "ИТОГО", ИтогПлан, ИтогФакт, Окр(ЗагПроц, 0)));

Сообщить("");
Сообщить("── Журнал аудита: " + Строка(ЖА.Количество()) + " записей ─────────────────────────────────");
ЖА.Вывести(7);

Сообщить("");
Сообщить("══════════════════════════════════════════════════════════════════");
Сообщить("  1S: ERP — Планирование 4 недели + Workflow (русский) — завершено");
Сообщить("══════════════════════════════════════════════════════════════════");
