{
  "name": "1s-erp",
  "version": "0.3.0",
  "description": "1S: ERP Free Edition — Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "ua.vftens.1s-erp",
    "productName": "1S ERP Free Edition",
    "win": {
      "target": "nsis",
      "icon": "../gui/assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "../gui/assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "../gui/assets/icon.png"
    },
    "extraResources": [
      { "from": "../src",      "to": "src"      },
      { "from": "../examples", "to": "examples" },
      { "from": "../config",   "to": "config"   }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
