{
  "Function": {
    "prefix": ["fn", "func", "Функция", "Функція"],
    "body": ["Функція ${1:Назва}(${2:Параметри})", "\t${0}", "КінецьФункції;"],
    "description": "1S Function definition"
  },
  "Procedure": {
    "prefix": ["proc", "Процедура"],
    "body": ["Процедура ${1:Назва}(${2:Параметри})", "\t${0}", "КінецьПроцедури;"],
    "description": "1S Procedure definition"
  },
  "If": {
    "prefix": ["if", "Якщо", "Если"],
    "body": ["Якщо ${1:Умова} Тоді", "\t${0}", "КінецьЯкщо;"],
    "description": "If statement"
  },
  "For Each": {
    "prefix": ["foreach", "Для Кожного"],
    "body": ["Для Кожного ${1:Елемент} З ${2:Колекція} Цикл", "\t${0}", "КінецьЦиклу;"],
    "description": "For Each loop"
  },
  "For Numeric": {
    "prefix": ["for", "Для"],
    "body": ["Для ${1:Н} = ${2:1} По ${3:10} Цикл", "\t${0}", "КінецьЦиклу;"],
    "description": "Numeric For loop"
  },
  "While": {
    "prefix": ["while", "Поки"],
    "body": ["Поки ${1:Умова} Цикл", "\t${0}", "КінецьЦиклу;"],
    "description": "While loop"
  },
  "Try": {
    "prefix": ["try", "Спроба"],
    "body": ["Спроба", "\t${0}", "Виняток", "\t// обробка помилки", "КінецьСпроби;"],
    "description": "Try/Except block"
  },
  "Chart of Accounts": {
    "prefix": ["coa", "ПланРах"],
    "body": [
      "${1:ПланРах} = ПланРахунків(\"${2:УКСГП}\");",
      "${1:ПланРах}.Додати(\"${3:10}\", \"${4:Назва рахунку}\");"
    ],
    "description": "Chart of Accounts"
  },
  "Accounting Register": {
    "prefix": ["reg", "РегБух"],
    "body": [
      "${1:РегБух} = РегістрБухгалтерії(\"${2:Журнал}\", ${3:ПланРах});",
      "${1:РегБух}.Провести(${4:Дата}, \"${5:Документ}\", \"${6:Опис}\", \"${7:Дт}\", \"${8:Кт}\", ${9:Сума});"
    ],
    "description": "Accounting Register + posting"
  },
  "Catalog": {
    "prefix": ["cat", "Справочник", "Довідник"],
    "body": [
      "${1:Довідник} = Справочник(\"${2:Назва}\");",
      "${3:Запис} = ${1:Довідник}.Створити(\"${4:001}\", \"${5:Назва елементу}\");",
      "${3:Запис}.${6:Поле} = ${7:Значення};"
    ],
    "description": "Catalog (Directory)"
  },
  "Document": {
    "prefix": ["doc", "Документ"],
    "body": [
      "${1:Документ} = Документ(\"${2:ТипДокументу}\");",
      "${1:Документ}.Дата = '${3:20250115}';",
      "${4:Рядки} = ${1:Документ}.ТабличнаЧастина(\"${5:Рядки}\", \"${6:Назва}, ${7:Кількість}, ${8:Ціна}\");",
      "${9:Р} = ${4:Рядки}.Додати();",
      "${1:Документ}.Провести();"
    ],
    "description": "Document with tabular section"
  },
  "Workflow Document": {
    "prefix": ["wf", "workflow", "ДокументЗМаршрутом"],
    "body": [
      "${1:Документ} = ДокументЗМаршрутом(\"${2:ТипДокументу}\");",
      "${1:Документ}.Надіслати(\"${3:Відповідальний}\", \"${4:Коментар}\");",
      "${1:Документ}.Погодити(\"${5:Директор}\", \"${6:Затверджено}\");",
      "${1:Документ}.Провести();"
    ],
    "description": "Workflow Document (approval chain)"
  },
  "Excel Export": {
    "prefix": ["excel", "xlsx", "КнигаExcel"],
    "body": [
      "${1:Книга} = КнигаExcel();",
      "${2:Аркуш} = ${1:Книга}.ДодатиАркуш(\"${3:Аркуш1}\");",
      "${2:Аркуш}.ВстановитиШапку(\"${4:Колонка1, Колонка2}\");",
      "Для Кожного ${5:Р} З ${6:Таблиця} Цикл",
      "\t${7:Рдн} = Масив(); ${7:Рдн}.Додати(${5:Р}[\"${4:Колонка1}\"]);",
      "\t${2:Аркуш}.ДодатиРядок(${7:Рдн});",
      "КінецьЦиклу;",
      "${1:Книга}.Зберегти(\"${8:звіт.xlsx}\");"
    ],
    "description": "Excel export workbook"
  },
  "Message": {
    "prefix": ["msg", "Повідомити"],
    "body": ["Повідомити(ШаблонРядка(\"${1:Текст}: %1\", ${2:Значення}));"],
    "description": "Print with StrTemplate"
  }
}
